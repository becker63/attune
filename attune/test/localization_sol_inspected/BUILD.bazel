load("//platform/build:native.bzl", "attune_source_tree", "native_flix_test", "native_study_stage")
load("//platform/build:sol.bzl", "attune_sol_cohort", "attune_sol_route_check", "attune_sol_task")
load("//test/localization_runtime:localization_runtime.bzl", "RUNTIME_CAPPED_EXCLUSIONS")
load("//test/study:manifest/localization/mapped.bzl", "LOCALIZATION_ANALYSIS")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The distinct enforced read-only inspection arm's ONE frozen prompt
# (`VAL-INSPECT-001`). The bytes are `prompt.txt`, frozen BEFORE any outcome;
# the identity below is the SHA-256 of exactly those bytes. It is a NEW prompt,
# not the original arm's: it requires inspection (search the mounted repository,
# read the implementation before answering) and makes abstention a
# post-inspection act, so a corpus-free fixture's answer can only be produced by
# actually reading source.
PROMPT_INSPECTED_IDENTITY = "sha256:4974812a1f476c3b36357ffdc64b5ca47dd831407aa9afbaf4e027a5cb5b3539"

# The pinned companion `codex-code-mode-host` binary of the same Codex release.
# The app-server resolves its shell/read tool executor as a sibling file named
# `codex-code-mode-host`; the pinned release tarball carries only the `codex`
# binary, so without this declared artifact every turn's tool path fails closed
# and no model can inspect a repository. The driver stages it under that exact
# sibling name before launching the app-server.
CODE_MODE_HOST = "@codex_code_mode_host//:codex-code-mode-host-aarch64-unknown-linux-musl"

# The pinned bundled sandbox helper (`codex-resources/bwrap`) of the same Codex
# release. The code-mode host's Linux sandbox launcher aborts every command
# without it, so the inspected arm stages it at the relative path the launcher
# expects before launching the app-server.
CODE_BWRAP = "@codex_bwrap//:bwrap-aarch64-unknown-linux-musl"

# The dedicated remote execution platform of the inspected arm. It is the same
# declared platform as the original Sol arm — the ChatGPT-plan SIWC route must
# reach the plan backend through BuildBuddy's declared external-network
# contract, and the SIWC access token is injected *only* as the BuildBuddy
# secret `ACCESS_TOKEN`. The arm is a distinct sibling, not a new route.
platform(
    name = "remote",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    exec_properties = {
        "Arch": "arm64",
        "OSFamily": "Linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu22-04@sha256:0d84a80bb0fc36ba5381942adcf6493249594dcc9044845c617b78c9b621cae3",
        "network": "external",
        "env-secrets": "ACCESS_TOKEN",
        "recycle-runner": "false",
        "EstimatedCPU": "0.5",
        "EstimatedMemory": "512MB",
    },
)

# The declared pre-flight of the arm's secret boundary: it reports whether the
# platform's injected `ACCESS_TOKEN` secret is present and, when it is a
# well-formed JWT, its expiry instant. It makes NO provider call and touches no
# corpus, so it runs before any scored task without consuming plan usage. It is
# `fresh`, so its verdict is keyed on the declared measurement freshness token:
# after the owner replaces the secret, a check with a NEW
# `--define=attune_measurement_freshness=<token>` reports the newly injected
# token rather than replaying the previous one's expiry.
attune_sol_route_check(
    name = "route_check",
    fresh = True,
    tags = ["manual"],
)

# The corpus-free authored bring-up fixture. It carries the information the
# issue needs inside `src/format.js` and NOT in the prompt or the issue text, so
# an answer that respects the frozen prompt can only come from actually
# searching the mounted repository and reading nonempty implementation source.
# The fixture is authored here, declares no corpus artifact and no evaluator
# label, and exists to verify tool availability and the observed read bytes
# before any cohort spend.
filegroup(
    name = "fixture_world",
    srcs = glob(["worlds/fixture/**"]),
)

exports_files([
    "fixture_issue.tsv",
    "prompt.txt",
])

attune_sol_task(
    name = "fixture_task",
    bwrap = CODE_BWRAP,
    code_mode_host = CODE_MODE_HOST,
    codex = "@codex_cli//:codex-aarch64-unknown-linux-musl",
    inspect = True,
    issue_tsv = ":fixture_issue.tsv",
    prompt = ":prompt.txt",
    prompt_identity = PROMPT_INSPECTED_IDENTITY,
    repo = ":fixture_world",
    tags = ["manual"],
    task = "fixture__total",
    world = "fixture",
)

# The mechanical tool-availability probe (`VAL-INSPECT-001` diagnosis). The
# corpus-free bring-up fixture answered without opening any tool even though the
# binary's own feature list reports `shell_tool` enabled, so this diagnostic asks
# the same model, on the same route, to run one shell command and report its
# output. It is a diagnostic, not a scored task: it declares a distinct prompt
# (whose bytes are frozen here) and never enters the cohort population. A real
# command item in its `*.reads.tsv` proves the tool path works and that the
# bring-up answer was the model's choice; no command item plus a `NO_TOOLS`
# answer proves the tool path is unavailable.
attune_sol_task(
    name = "fixture_task_probe",
    bwrap = CODE_BWRAP,
    code_mode_host = CODE_MODE_HOST,
    codex = "@codex_cli//:codex-aarch64-unknown-linux-musl",
    inspect = True,
    issue_tsv = ":fixture_issue.tsv",
    prompt = ":probe_prompt.txt",
    prompt_identity = "sha256:542cf40fe544312be131c99dc67d5405386b5e7ba0602e29267762f9d517653e",
    repo = ":fixture_world",
    tags = ["manual"],
    task = "fixture__total",
    world = "fixture",
)

# The surviving tasks of the frozen runtime-capped cohort, derived from the same
# admitted manifest the deterministic arms and the original Sol arm consume, so
# the inspected population cannot drift from the cohort it is compared against:
# 22 groups / 84 worlds / 88 tasks / 85 eligible.
_EXCLUDED_GROUPS = [entry["group"] for entry in RUNTIME_CAPPED_EXCLUSIONS]

_SURVIVING_TASKS = [
    row
    for row in LOCALIZATION_ANALYSIS
    if len(row) > 3 and row[0] == "task" and row[2] not in _EXCLUDED_GROUPS
]

# One declared remote action per surviving task, exactly like the original arm's
# cohort but with the opt-in inspected path: the same clean world
# (`@attune_worlds//:<w>`) and public issue (`//test/localization:issue_text`)
# inputs, the new frozen prompt, and no evaluator artifact of any kind in any
# closure. The bring-up gate builds exactly ONE of these targets first.
attune_sol_cohort(
    name = "sol_inspected_tasks",
    bwrap = CODE_BWRAP,
    code_mode_host = CODE_MODE_HOST,
    codex = "@codex_cli//:codex-aarch64-unknown-linux-musl",
    inspect = True,
    issue_tree = "//test/localization:issue_text",
    prompt = ":prompt.txt",
    prompt_identity = PROMPT_INSPECTED_IDENTITY,
    tasks = _SURVIVING_TASKS,
    world_repo = "@attune_worlds",
)

# The frozen per-task fixtures of BOTH arms of the comparison
# (`VAL-INSPECT-003`). They are the byte-verified copies of the snapshots taken
# outside mutable Bazel outputs before any scoring:
#
# - the preserved original arm (`gen16`): `sol_tasks__<task>.receipt.json`,
#   `.predictions.tsv` and `.world.tsv`;
# - the distinct inspected arm: `sol_inspected_tasks__<task>.receipt.json`,
#   `.predictions.tsv` and `.reads.tsv`.
#
# The declared clean-world source manifest is byte-identical in both snapshots
# (88/88 verified, and both recorded digests are listed in `MANIFEST.tsv`), so it
# is carried once as `sol_tasks__<task>.world.tsv`. `MANIFEST.tsv` records each
# fixture's arm, snapshot, snapshot path and SHA-256; every digest in it matches
# the corresponding snapshot's own `SHA256SUMS`. The tree is the only per-task
# evidence the scoring stage binds: it names no acquisition producer, so a replay
# cannot re-enter a Sol action.
attune_source_tree(
    name = "sol_inspected_fixtures",
    srcs = glob(["fixtures/**"]),
    tags = ["manual"],
)

# The one bounded scoring and comparison stage of the distinct inspected arm
# (`VAL-INSPECT-003`). It binds the two arms' frozen fixtures, the admitted
# evaluator labels and the admitted mapped manifest, classifies each arm through
# its production statement (`Attune.Study.Sol` / `Attune.Study.SolInspected`),
# reduces both rank trees through the ONE canonical `Attune.Study.Metrics`, and
# emits the metric, per-task, per-value, paired-contrast and statistics records.
# It redeclares no producer and calls no provider, so a replay executes 0 Codex
# turns, 0 JEV calls, 0 Q embedding requests, 0 CodeRank inference and 0
# Repository/Theory actions (`VAL-INSPECT-003`). `manual`, so the ordinary
# offline gate never touches it.
STAGE_SRCS = [
    "SolInspectedStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Sol.flix",
    "//src:Attune/Study/SolInspected.flix",
]

native_study_stage(
    name = "sol_inspected_metrics",
    srcs = STAGE_SRCS,
    input_names = [
        "mapped",
        "fixtures",
    ] + ["label_%s" % row[1] for row in _SURVIVING_TASKS],
    inputs = [
        "//test/study:manifest/localization/mapped.tsv",
        ":sol_inspected_fixtures",
    ] + ["//test/study:manifest/localization/label_%s.tsv" % row[1] for row in _SURVIVING_TASKS],
    stage = "sol_inspected_metrics",
    tags = ["manual"],
)

# The corpus-free laws of the inspected arm's inspection floor
# (`VAL-INSPECT-001`) and of its paired comparison statement
# (`VAL-INSPECT-003`): the declared action kinds, the declared test-path rule,
# the nonempty-implementation-read floor, the zero-read `ProtocolFailed`
# classification, the typed result-status failures, the retained overshoot, the
# exact `read` row layout the driver writes, the repository-relative reduction of
# an observed read target, and the rescued / regressed / improved / equal
# partition of a paired metric comparison. Pure, so unlike the arm's remote tasks
# it is part of the ordinary offline gate.
native_flix_test(
    name = "sol_inspected_law",
    srcs = [
        "SolInspectedLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/Metrics.flix",
        "//src:Attune/Study/Sol.flix",
        "//src:Attune/Study/SolInspected.flix",
    ],
)

test_suite(
    name = "all",
    tags = ["manual"],
    tests = [":sol_inspected_law"],
)
