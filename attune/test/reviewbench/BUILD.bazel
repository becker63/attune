load("//platform/build:native.bzl", "native_flix_java_test", "native_study_stage")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The explicit source closure every declared stage compiles: the admission
# dispatcher plus the shared owners it consumes. The dispatcher is a thin
# adapter; the origin comparison, the metadata-only exclusion, the frozen quota
# selection, the repository-disjoint split, the source classification and the
# bounded-context policy all live in `Attune.Study.ReviewBench`; the existing
# frontend language table lives in `Attune.Repository.Grit`; the existing 3/1/1
# split mechanism lives in `Attune.Study`. `Attune.Repository` is the required
# parent module of the Grit projection and the mechanical Grit jar is declared
# beside it, exactly as the localization closure declares it.
REVIEWBENCH_SRCS = [
    "ReviewBenchStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Repository.flix",
    "//src:Attune/Repository/Grit.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/ReviewBench.flix",
]

# The declared ReviewBench admission stage (`VAL-REVIEW-001`): it verifies the
# declared origin pin against the identity the mechanical boundary observes on the
# real materialized manifest bytes, streams the pinned manifest through the one
# declared metadata projection, reduces the verified population and the frozen
# 24-task selection, and writes the declared records plus the loadable selection
# list the integration owner admits before the study invocation.
#
# The target is `manual` on purpose: the ordinary `bazel test //...` gate must
# never fetch or scan the pinned corpus.
native_study_stage(
    name = "reviewbench_admission",
    srcs = REVIEWBENCH_SRCS,
    input_names = [
        "manifest",
        "pin",
    ],
    inputs = [
        "@reviewbench_manifest//file:file",
        "reviewbench_pin.tsv",
    ],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_admission",
    tags = ["manual"],
)

# The corpus-free ReviewBench laws (`VAL-REVIEW-001`, `VAL-REVIEW-002`): they drive
# the exact production origin comparison, metadata exclusion, quota selection,
# repository-disjoint split, source classification, admission threshold and
# bounded shared-context policy over declared fixtures. No corpus, no network, no
# golden finding and no provider is touched, so the ordinary gate runs them; the
# mechanical Grit jar is on the class path only because the frontend language
# table's parent module is compiled, and no Grit program is evaluated here.
native_flix_java_test(
    name = "reviewbench_law",
    srcs = [
        "ReviewBenchLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Repository.flix",
        "//src:Attune/Repository/Grit.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/ReviewBench.flix",
    ],
    java_deps = ["//platform/tools/grit:attune_grit"],
)

test_suite(
    name = "all",
    tests = [":reviewbench_law"],
)
