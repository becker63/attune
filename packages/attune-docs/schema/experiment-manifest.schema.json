        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "final_snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Snapshot"
        },
        "investigation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Investigation Id"
        },
        "metrics": {
          "$ref": "#/$defs/TrialMetrics"
        },
        "receipt_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Receipt Refs",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/ResearchBenchSettings"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "trace_address": {
          "title": "Trace Address",
          "type": "string"
        }
