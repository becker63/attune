# Local, isolated checks by default. BuildBuddy is opt-in with --config=remote.
# The 3 GiB heap and one local job fit this workspace's native builds.
# Remote actions use the pinned arm64 image and dockerNetwork=off from MODULE.
# Only the credential helper sees credentials; they never become action inputs.
# Host-only audit/isolation checks stay local. Failed remote actions do not fall back.

startup --host_jvm_args=-Xmx3g
startup --host_jvm_args=-XX:MaxMetaspaceSize=256m
build --enable_bzlmod
build --java_language_version=25
build --tool_java_language_version=25
build --java_runtime_version=remotejdk_25
build --tool_java_runtime_version=remotejdk_25
build --local_resources=cpu=1
build --local_resources=memory=1024
build --jobs=1
test --test_output=errors
test --build_tests_only
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all
build:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_cache_compression
build:remote --config=buildbuddy
build:remote --remote_executor=grpcs://remote.buildbuddy.io
build:remote --remote_local_fallback=false
build:remote --extra_execution_platforms=@buildbuddy_toolchain//:platform_linux_arm64
build:remote --host_platform=@buildbuddy_toolchain//:platform_linux_arm64
build:remote --platforms=@buildbuddy_toolchain//:platform_linux_arm64
build:remote --define=attune_native_isolation=platform
build:remote --jobs=8
