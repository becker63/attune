load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The narrow mechanical native adapter over the pinned Grit ABI, grouped with
# the other mechanical Java under `platform/tools/`. It performs only interop:
# it loads the prepared shared library, marshals UTF-8 byte slices, and projects
# the versioned native envelope into a canonical record stream. Flix owns every
# language, relation, identity, admission and verdict decision; this library
# decides none of them. The maintained `.grit` frontends stay under `//src/grit`.
java_library(
    name = "attune_grit",
    srcs = [
        "AttuneGritNative.java",
    ],
    javacopts = ["--release=22"],
    resources = ["//src/grit:programs"],
)
