load("//platform/build:native.bzl", "native_flix_test", "native_study_stage")
load("//test/localization_runtime:localization_runtime.bzl", "RUNTIME_CAPPED_EXCLUSIONS")
load("//test/study:manifest/localization/mapped.bzl", "LOCALIZATION_ANALYSIS")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The replicated stability, ensemble, working-set and economics reduction
# (`VAL-REPL-002`..`VAL-REPL-005`) is a strictly downstream consumer. It binds the
# ten admitted sanitized decision manifests of the frozen five-observation family
# (`A1`/`S1`, the preserved originals, plus the four deliberately new
# `A2..A5`/`S2..S5`), the frozen `A32` population record, the warm
# `//test/localization_runtime` `P+A` rank trees, the admitted evaluator label
# artifacts and the five mechanically reduced per-replicate economics records. It
# declares no world extraction, Theory lowering, variant ranking, CodeRankEmbed
# inference, hosted-Qwen acquisition or JEV call, so building it re-executes no
# upstream stage and issues no provider request.
#
# The two stages are ordered by the owner's publish-first checkpoint: `stability`
# constructs no ensemble and no metric and is published to the root report first;
# `ensembles` then builds the vote rankings, the three fixed ensembles, the
# cumulative unions with their mandatory equal-budget control and the actual
# economics. Every scientific statement is the production owner
# `Attune.Study.Ensemble`; every retrieval value is the one canonical
# `Attune.Study.Metrics` reducer.
STAGE_SRCS = [
    "EnsembleStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Ensemble.flix",
    "//src:Attune/Study/Jev.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Replication.flix",
]

_EXCLUDED_GROUPS = [entry["group"] for entry in RUNTIME_CAPPED_EXCLUSIONS]

# The surviving tasks of the frozen runtime-capped cohort, derived from the same
# admitted manifest the cohort macro consumes so the ensemble population cannot
# drift from the replicated family it extends.
_DERIVED_TASKS = [
    row
    for row in LOCALIZATION_ANALYSIS
    if len(row) > 3 and row[0] == "task" and row[2] not in _EXCLUDED_GROUPS
]

_RANK_INPUTS = [
    "//test/localization_runtime:rank_%s" % row[1]
    for row in _DERIVED_TASKS
]

_RANK_NAMES = ["rank_%s" % row[1] for row in _DERIVED_TASKS]

_LABEL_INPUTS = [
    "//test/study:manifest/localization/label_%s.tsv" % row[1]
    for row in _DERIVED_TASKS
]

_LABEL_NAMES = ["label_%s" % row[1] for row in _DERIVED_TASKS]

_REPLICATE_IDS = ["2", "3", "4", "5"]

# One preregistered replicate identity per condition, in declared order 1..5: the
# preserved original first, then the four deliberately new observations.
_FAMILY_NAMES = ["a1", "s1"] + ["a%s" % id for id in _REPLICATE_IDS] + ["s%s" % id for id in _REPLICATE_IDS]

_FAMILY_FILES = [
    "//test/localization_jev:decisions_A.tsv",
    "//test/localization_jev:decisions_S.tsv",
] + ["//test/localization_replicated:decisions_A_r%s.tsv" % id for id in _REPLICATE_IDS] + [
    "//test/localization_replicated:decisions_S_r%s.tsv" % id
    for id in _REPLICATE_IDS
]

_ECONOMICS_NAMES = ["e1", "e2", "e3", "e4", "e5"]

_ECONOMICS_FILES = ["//test/localization_replicated:replicate_r%s.tsv" % id for id in ["1", "2", "3", "4", "5"]]

# The stability stage (`VAL-REPL-002`): it reduces the five typed observations of
# each condition into the stability record alone — the agreement levels and full
# patterns, the ever-Relevant-versus-non-Relevant flips, the votes 0..5 histogram,
# the per-task unstable sets and the pairwise agreement and ordinary top-10
# overlap. It constructs no ensemble ranking and no metric, so the stability
# publication genuinely precedes the ensemble. `manual` like every corpus-bound
# stage, so the ordinary `bazel test //...` gate never touches it.
native_study_stage(
    name = "stability",
    srcs = STAGE_SRCS,
    input_names = ["mapped", "population"] + _FAMILY_NAMES + _RANK_NAMES,
    inputs = [
        "//test/study:manifest/localization/mapped.tsv",
        "//test/localization_jev:population.tsv",
    ] + _FAMILY_FILES + _RANK_INPUTS,
    stage = "stability",
    tags = ["manual"],
)

# The ensemble stage (`VAL-REPL-003`..`VAL-REPL-005`): it builds the complete
# cumulative vote rankings `N=1..5`, the three fixed ensembles `ANY`/`MAJ`/`CONS`,
# the cumulative unions `U1..U5` with the mandatory equal-budget `TopM(run 1)`
# control and the A32-ceiling recovery, the nine-arm canonical metric table, and
# the actual per-replicate and cumulative economics. `manual` for the same reason.
native_study_stage(
    name = "ensembles",
    srcs = STAGE_SRCS,
    input_names = ["mapped"] + _FAMILY_NAMES + _RANK_NAMES + _LABEL_NAMES + _ECONOMICS_NAMES,
    inputs = [
        "//test/study:manifest/localization/mapped.tsv",
    ] + _FAMILY_FILES + _RANK_INPUTS + _LABEL_INPUTS + _ECONOMICS_FILES,
    stage = "ensembles",
    tags = ["manual"],
)

# The corpus-free ensemble laws (`VAL-REPL-002`..`VAL-REPL-005`): they drive the
# exact production statements in `Attune.Study.Ensemble` with hand-built immutable
# values, so the relevant-only vote, the `(-votes, original rank)` order and its
# `N=1` identity with the published one-shot ranking, the three fixed-ensemble
# partitions, the union working set at its own size and the exact reported
# statistics are pinned without touching the corpus. Pure, so unlike the stages it
# is not `manual` and the ordinary offline gate runs it.
native_flix_test(
    name = "ensemble_law",
    srcs = [
        "EnsembleLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/Ensemble.flix",
        "//src:Attune/Study/Jev.flix",
        "//src:Attune/Study/Metrics.flix",
        "//src:Attune/Study/Replication.flix",
    ],
)

test_suite(
    name = "all",
    tags = ["manual"],
    tests = [":ensemble_law"],
)

# TEMPORARY local compile check for the corpus-bound stage sources; removed
# before publish.
native_flix_test(
    name = "stage_compile",
    srcs = STAGE_SRCS,
    tags = ["manual"],
)
