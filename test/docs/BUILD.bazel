load("//build:native.bzl", "native_flix_java_test")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The exact declared documents and sources the correspondence fixture may read:
# the root narrative and design, the typed view comment it compares against a
# regenerated grammar, the authored Ruby shop world, and the test/source paths
# the README links to. The names are listed rather than globbed, so the
# declared set is the population the link check resolves against.
filegroup(
    name = "documents",
    srcs = [
        "//:AGENTS.md",
        "//:DESIGN.md",
        "//:LICENSE",
        "//:README.md",
        "ReadmeCorrespondence.flix",
        "//src:Attune/Docs.flix",
        "//src:Attune/Envelope.flix",
        "//src:Attune/Repository.flix",
        "//src:Attune/View.flix",
        "//test/grit:GritSeamTest.flix",
        "//test/grit:fixtures",
        "//test/policy:PolicyCases.flix",
        "//test/proposals:P09Views.flix",
        "//test/view:RouteViewLaw.flix",
        "//test/view:SemanticViewLaw.flix",
    ],
)

# The documentation correspondence: the authored shop source flows through the
# real pinned Grit engine, conservative Flix admission, the typed view and the
# one writer, and the generated payloads are compared with the actual marked
# README and View comment payloads. A drifted payload, a missing or duplicated
# marker and a broken local link each fail. The test never rewrites a document.
native_flix_java_test(
    name = "readme_correspondence_test",
    srcs = [
        "//src:Attune.flix",
        "//src:Attune/Docs.flix",
        "//src:Attune/Envelope.flix",
        "//src:Attune/AsciiTree.flix",
        "//src:Attune/View.flix",
        "//src:Attune/Grit.flix",
        "//src:Attune/Repository.flix",
        "ReadmeCorrespondence.flix",
    ],
    declared_files = [":documents"],
    java_deps = [
        "//test/grit:grit_fixtures",
        "//src/native/grit:attune_grit",
    ],
    native_libs = ["//support/grit:attune_grit_abi"],
)
