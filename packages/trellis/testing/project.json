{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "framework-testing",
  "projectType": "library",
  "root": "packages/trellis/testing",
  "sourceRoot": "packages/trellis/testing/src",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/trellis/testing && pnpm exec tsc --noEmit -p tsconfig.json"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "typecheck",
          "action": "typecheck",
          "recipeId": "framework-testing.typecheck",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/trellis/testing && pnpm exec vitest run"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "test",
          "action": "test",
          "recipeId": "framework-testing.test",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Project check surface for Recipe/ManagedRecipe substrate diagnostics.",
        "attune": {
          "tier": "public",
          "surface": "check",
          "action": "check",
          "recipeId": "framework-testing.check",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec nx run workspace:recipe-substrate-check"
      }
    },
    "repair": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Project repair surface for safe Recipe/ManagedRecipe repair materialization.",
        "attune": {
          "tier": "public",
          "surface": "repair",
          "action": "repair",
          "recipeId": "framework-testing.repair",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec nx run workspace:repair"
      }
    }
  },
  "tags": [
    "scope:framework",
    "attune:framework"
  ]
}
