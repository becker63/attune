load("//platform/build:native.bzl", "native_flix_java_test", "native_study_stage")
load("//platform/build:sol.bzl", "attune_path_manifest", "attune_reviewbench_corrective_cohort", "attune_reviewbench_judge_cohort", "attune_sol_route_check")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The dedicated remote execution platform of the blinded judge and
# independent-adjudication sessions. It is the SAME declared platform as the
# original, inspected and review Sol arms: the ChatGPT-plan SIWC route reaches
# the plan backend through BuildBuddy's declared external-network contract, and
# the SIWC access token is injected only as the BuildBuddy secret
# `ACCESS_TOKEN`. The judge is a distinct sibling, not a new route and not a new
# platform.
platform(
    name = "remote",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    exec_properties = {
        "Arch": "arm64",
        "OSFamily": "Linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu22-04@sha256:0d84a80bb0fc36ba5381942adcf6493249594dcc9044845c617b78c9b621cae3",
        "network": "external",
        "env-secrets": "ACCESS_TOKEN",
        "recycle-runner": "false",
        "EstimatedCPU": "0.5",
        "EstimatedMemory": "512MB",
    },
)

# The declared pre-flight of the judge arms' secret boundary. It makes NO
# provider call and touches no corpus, so it runs before any judge session
# without consuming plan usage. It is `fresh`, so a NEW
# `--define=attune_measurement_freshness=<token>` reports the currently injected
# token instead of replaying a cached verdict.
attune_sol_route_check(
    name = "route_check",
    fresh = True,
    tags = ["manual"],
)

exports_files(["prompt-judge.txt", "prompt-adjudicate.txt", "prompt-corrective.txt"])

# The frozen judge prompt's exact identity: the SHA-256 of `prompt-judge.txt`,
# frozen AFTER the candidate findings exist and BEFORE any gold exposure. It is
# the SAME value `Attune.Study.ReviewBenchJudge.judgePromptIdentity()` declares,
# so the frozen protocol and the frozen bytes cannot drift apart silently.
JUDGE_PROMPT_IDENTITY = "sha256:3c4dbb6dc3457a97ca98fa985b7645b3a76cabf60d98cd7af6282cf0bbe5087d"

# The frozen independent-adjudication prompt's exact identity: the SHA-256 of
# `prompt-adjudicate.txt`. The adjudicator sees the blinded candidates the judge
# found no reference for and NO golden set at all.
ADJUDICATION_PROMPT_IDENTITY = "sha256:8168d1d97d2a19ad7ba05a7229ae8f1cae69c9571fb3f165cf6c2bf088bfaac3"

# The frozen arm-isolated CORRECTIVE prompt's exact identity: the SHA-256 of
# `prompt-corrective.txt`, PREREGISTERED before any corrective output and never
# tuned (`library/reviewbench-adjudication-correction.md`). It is a SEPARATE
# prompt from the joint adjudication prompt: each corrective session sees exactly
# its own arm's TWO unmatched candidates, no other arm, no reference set and no
# prior verdict. It is the SAME value
# `Attune.Study.ReviewBenchJudge.correctivePromptIdentity()` declares.
CORRECTIVE_PROMPT_IDENTITY = "sha256:4c1bcf28526d2355aa365b066f7c87ed6df1cc94454b64f6e77aef928cf33136"

# The pinned companion `codex-code-mode-host` binary and the pinned bundled
# sandbox helper of the same Codex release, exactly as the verified inspected and
# review arms declare them.
CODE_MODE_HOST = "@codex_code_mode_host//:codex-code-mode-host-aarch64-unknown-linux-musl"
CODE_BWRAP = "@codex_bwrap//:bwrap-aarch64-unknown-linux-musl"

# The frozen findings and the frozen review outcome record of the first paired
# review family, committed as immutable declared inputs. They are the SAME bytes
# the review arms produced (identity record: `fixtures/paired-summary.tsv` and
# `fixtures/findings/*.findings.tsv`); the judge stage reads them and blinds the
# candidate ids. Nothing here re-runs a review or reaches a provider.
attune_path_manifest(
    name = "judge_fixtures",
    srcs = glob(["fixtures/**"]),
)

# The frozen structurally admitted cohort of the 24-task metadata selection,
# exactly as `VAL-REVIEW-003` admitted it. The fourteen excluded tasks stay named
# attrition in the planned 24-task denominator; the four admitted tasks whose
# reviews all ended at the declared token cap produced no finding at all and stay
# in the metric denominator with zero candidates rather than being replaced or
# forced.
REVIEW_TASKS = [
    ["task", "capawesome-team_cli-126", "capawesome-team/cli", "capawesome-team_cli-126-head"],
    ["task", "heyitsaamir_teamscli-31", "heyitsaamir/teamscli", "heyitsaamir_teamscli-31-head"],
    ["task", "haoling_diary-notebook-blog-transformer-24", "haoling/diary-notebook-blog-transformer", "haoling_diary-notebook-blog-transformer-24-head"],
    ["task", "caasi_town-zero-6", "caasi/town-zero", "caasi_town-zero-6-head"],
    ["task", "EdV4H_usketch-534", "EdV4H/usketch", "EdV4H_usketch-534-head"],
    ["task", "rulecom_rule-io-sdk-40", "rulecom/rule-io-sdk", "rulecom_rule-io-sdk-40-head"],
    ["task", "brianc_node-postgres-3650", "brianc/node-postgres", "brianc_node-postgres-3650-head"],
    ["task", "agent-sh_agentsys-298", "agent-sh/agentsys", "agent-sh_agentsys-298-head"],
    ["task", "jenkinsci_gitea-plugin-141", "jenkinsci/gitea-plugin", "jenkinsci_gitea-plugin-141-head"],
    ["task", "ls1intum_Artemis-12479", "ls1intum/Artemis", "ls1intum_Artemis-12479-head"],
]

# The six admitted tasks whose frozen reviews produced at least one finding. Only
# these carry a candidate population, so only these get a judge session; the four
# tasks whose two arms both ended at the token cap have nothing to judge and stay
# in the denominator with zero candidates.
JUDGE_TASKS = [
    ["task", "agent-sh_agentsys-298", "agent-sh/agentsys", "agent-sh_agentsys-298-head"],
    ["task", "brianc_node-postgres-3650", "brianc/node-postgres", "brianc_node-postgres-3650-head"],
    ["task", "capawesome-team_cli-126", "capawesome-team/cli", "capawesome-team_cli-126-head"],
    ["task", "haoling_diary-notebook-blog-transformer-24", "haoling/diary-notebook-blog-transformer", "haoling_diary-notebook-blog-transformer-24-head"],
    ["task", "jenkinsci_gitea-plugin-141", "jenkinsci/gitea-plugin", "jenkinsci_gitea-plugin-141-head"],
    ["task", "rulecom_rule-io-sdk-40", "rulecom/rule-io-sdk", "rulecom_rule-io-sdk-40-head"],
]

# The pinned golden set of each admitted task, at the SAME corpus commit the
# admission stage verified. Each file's exact bytes are pinned by SHA-256 in
# MODULE.bazel, so a mutated or substituted golden file fails the fetch instead
# of entering the judge. The golden set is declared ONLY by the judge cohort
# below: no review, prediction or assisted-context closure can reach it.
GOLD = {
    "agent-sh_agentsys-298": "@reviewbench_gold_agent_sh_agentsys_298//file",
    "brianc_node-postgres-3650": "@reviewbench_gold_brianc_node_postgres_3650//file",
    "capawesome-team_cli-126": "@reviewbench_gold_capawesome_team_cli_126//file",
    "haoling_diary-notebook-blog-transformer-24": "@reviewbench_gold_haoling_diary_notebook_blog_transformer_24//file",
    "jenkinsci_gitea-plugin-141": "@reviewbench_gold_jenkinsci_gitea_plugin_141//file",
    "ls1intum_Artemis-12479": "@reviewbench_gold_ls1intum_Artemis_12479//file",
    "heyitsaamir_teamscli-31": "@reviewbench_gold_heyitsaamir_teamscli_31//file",
    "caasi_town-zero-6": "@reviewbench_gold_caasi_town_zero_6//file",
    "EdV4H_usketch-534": "@reviewbench_gold_EdV4H_usketch_534//file",
    "rulecom_rule-io-sdk-40": "@reviewbench_gold_rulecom_rule_io_sdk_40//file",
}

# The shared owners the materialized artifacts already reference. The parent
# module chain (`Attune` -> `Attune.Study` -> `Attune.Study.ReviewBenchJudge`)
# must be declared, so the judge owner's own file is listed here and reused by
# both the stages and the corpus-free laws.
OWNER_SRCS = [
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Repository.flix",
    "//src:Attune/Repository/Grit.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Embedding.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Qwen.flix",
    "//src:Attune/Study/ReviewBench.flix",
    "//src:Attune/Study/ReviewBenchJudge.flix",
    "//src:Attune/Theory.flix",
]

STAGE_SRCS = ["ReviewBenchJudgeStages.flix"] + OWNER_SRCS

# The declared blinding stage: it reads the frozen findings and the frozen review
# outcome record of the paired family and writes one blinded candidate projection
# per task plus the separate candidate-to-arm blinding record. Provider-free: no
# model, no Grit, no Theory lowering and no world download happens here.
native_study_stage(
    name = "reviewbench_judge_candidates",
    srcs = STAGE_SRCS,
    extra_inputs = glob(["fixtures/**"]),
    input_names = ["fixtures"],
    inputs = [":judge_fixtures"],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_judge_candidates",
    tags = ["manual"],
)

# The declared blinded judge cohort (`VAL-REVIEW-004`): one judge action per task
# that carries candidates, on the SAME dedicated BuildBuddy platform and SIWC
# route the published Sol and review arms use. The judge is the ONLY closure that
# declares the pinned golden set. Every target is `manual`, so the ordinary
# `bazel test //...` gate never runs a judge session and never spends plan usage.
attune_reviewbench_judge_cohort(
    name = "reviewbench_judge",
    bwrap = CODE_BWRAP,
    candidates = ":reviewbench_judge_candidates",
    code_mode_host = CODE_MODE_HOST,
    codex = "@codex_cli//:codex-aarch64-unknown-linux-musl",
    gold = GOLD,
    issues = "//test/reviewbench_review:reviewbench_review_issues",
    measure = "//test/reviewbench:reviewbench_measure",
    prompt = ":prompt-judge.txt",
    prompt_identity = JUDGE_PROMPT_IDENTITY,
    role = "judge",
    tasks = JUDGE_TASKS,
    world_repo = "@reviewbench_worlds",
)

# The declared independent source-grounded adjudication cohort: one adjudication
# action per task, reading exactly the blinded candidates its judge session found
# no reference for (the judge cohort's own declared `unmatched` member) and NO
# golden set at all. It is a separate agent review of the source, never a claim of
# human or manual review, and its verdict is kept apart from the automatic
# provisional reference-set match.
attune_reviewbench_judge_cohort(
    name = "reviewbench_adjudicate",
    bwrap = CODE_BWRAP,
    candidates = ":reviewbench_judge",
    code_mode_host = CODE_MODE_HOST,
    codex = "@codex_cli//:codex-aarch64-unknown-linux-musl",
    from_judge = "reviewbench_judge",
    issues = "//test/reviewbench_review:reviewbench_review_issues",
    measure = "//test/reviewbench:reviewbench_measure",
    prompt = ":prompt-adjudicate.txt",
    prompt_identity = ADJUDICATION_PROMPT_IDENTITY,
    role = "adjudicate",
    tasks = JUDGE_TASKS,
    world_repo = "@reviewbench_worlds",
)

# The ONE corrective task of the arm-isolated re-adjudication
# (`library/reviewbench-adjudication-correction.md`): the task whose executed
# joint adjudication carried the confirmed cross-arm duplicate bias.
CORRECTIVE_TASK = [
    "task",
    "haoling_diary-notebook-blog-transformer-24",
    "haoling/diary-notebook-blog-transformer",
    "haoling_diary-notebook-blog-transformer-24-head",
]

# The declared provider-free corrective candidate stage: it reads ONLY the frozen
# findings fixtures and the frozen unmatched-selection record and writes one
# per-arm candidate file (fresh per-arm positional ids, no arm cell), the
# evaluator-only blinding record and the corrective index. It declares no
# dependency on the original live judge/adjudication producers, so building it
# can never re-key or re-execute an original session. No model, no Grit, no
# Theory and no world download happens here.
native_study_stage(
    name = "reviewbench_corrective_candidates",
    srcs = STAGE_SRCS,
    extra_inputs = glob(["fixtures/**"]),
    input_names = ["fixtures"],
    inputs = [":judge_fixtures"],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_corrective_candidates",
    tags = ["manual"],
)

# The declared arm-isolated corrective cohort (`VAL-REVIEW-004`): EXACTLY TWO
# fresh SIWC `gpt-6.1-sol` medium sessions, one per arm, on the SAME dedicated
# BuildBuddy platform, the SAME frozen client-mechanical limits (300 s / 32
# rounds / 256k) and the SAME route as the executed adjudication. Each session
# sees only its own arm's two unmatched candidates under fresh ids, with no
# condition label, no other-arm candidate, no prior judge or adjudication verdict
# and NO golden set. Every target is `manual`, so the ordinary `bazel test //...`
# gate never runs a corrective session and never spends plan usage.
attune_reviewbench_corrective_cohort(
    name = "reviewbench_corrective",
    bwrap = CODE_BWRAP,
    candidates = ":reviewbench_corrective_candidates",
    code_mode_host = CODE_MODE_HOST,
    codex = "@codex_cli//:codex-aarch64-unknown-linux-musl",
    issues = "//test/reviewbench_review:reviewbench_review_issues",
    measure = "//test/reviewbench:reviewbench_measure",
    prompt = ":prompt-corrective.txt",
    prompt_identity = CORRECTIVE_PROMPT_IDENTITY,
    task = CORRECTIVE_TASK,
    world_repo = "@reviewbench_worlds",
)

# The declared action paths of the corrective session receipts. The report stage
# binds exactly one declared input per name, so the two corrective outputs arrive
# as a manifest of action paths and the report opens exactly those it names.
attune_path_manifest(
    name = "corrective_outputs",
    srcs = [":reviewbench_corrective"],
)

# The declared corrective report stage: it reduces the two corrective session
# receipts and the frozen old-joint adjudication through the ONE canonical
# `Attune.Study.Metrics` path PER ARM, and reports the old (joint, provisional)
# and new (per-arm corrected) numbers SEPARATELY. Provider-free: 0 corrective
# sessions, 0 judge sessions, 0 adjudication sessions, 0 Sol turns, 0 Grit and
# 0 Theory work, so a replay is fixture-only with ZERO provider calls.
native_study_stage(
    name = "reviewbench_corrective_report",
    srcs = STAGE_SRCS,
    extra_inputs = glob(["fixtures/**"]) + [":reviewbench_corrective"],
    input_names = ["fixtures", "candidates", "corrective"],
    inputs = [
        ":judge_fixtures",
        ":reviewbench_corrective_candidates",
        ":corrective_outputs",
    ],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_corrective_report",
    tags = ["manual"],
)

# The declared action paths of the judge and adjudication receipts. A stage binds
# exactly one declared input per name, so the whole population of judge outputs
# arrives as a manifest of action paths and the report stage opens exactly the
# receipts it names.
attune_path_manifest(
    name = "judge_outputs",
    srcs = [":reviewbench_judge"],
)

attune_path_manifest(
    name = "adjudication_outputs",
    srcs = [":reviewbench_adjudicate"],
)

# The declared report stage: it reduces the judge and independent-adjudication
# receipts through the ONE canonical `Attune.Study.Metrics` exact-ratio reducers
# and writes the classification, the supported locations, the paired
# disagreements, the outcomes and the metric tables. Provider-free: 0 judge
# sessions, 0 adjudication sessions, 0 Sol turns, 0 Grit and 0 Theory work.
native_study_stage(
    name = "reviewbench_judge_report",
    srcs = STAGE_SRCS,
    extra_inputs = [
        ":reviewbench_judge",
        ":reviewbench_adjudicate",
    ],
    input_names = [
        "fixtures",
        "candidates",
        "judge",
        "adjudication",
    ],
    inputs = [
        ":judge_fixtures",
        ":reviewbench_judge_candidates",
        ":judge_outputs",
        ":adjudication_outputs",
    ],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_judge_report",
    tags = ["manual"],
)

# The corpus-free laws of the judge owner (`VAL-REVIEW-004`): the frozen judge
# protocol and blinded vocabulary, the logical-finding deduplication, the
# reference-set classification (a reference miss is NEVER a false positive), the
# independent adjudication vocabulary kept apart from the automatic provisional
# match, the severity views and the exact metric denominators. Pure, so the
# ordinary offline gate runs them without touching the corpus or a provider.
native_flix_java_test(
    name = "reviewbench_judge_law",
    srcs = ["ReviewBenchJudgeLaw.flix"] + OWNER_SRCS,
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
)

test_suite(
    name = "all",
    tests = [":reviewbench_judge_law"],
)
