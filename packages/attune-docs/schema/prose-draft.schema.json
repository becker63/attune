{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://becker63.github.io/attune/schemas/prose-draft.schema.json",
  "title": "Attune prose-agent output",
  "description": "Strict structured output for prose generation. Review and publication authority are intentionally absent and are joined from a separate GuideApproval artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "title",
    "summary",
    "audience",
    "sourceRevision",
    "sourceDigest",
    "sections",
    "nextPages",
    "unresolvedQuestions",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/section" }
    },
    "nextPages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/question" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbolId", "facts"],
      "properties": {
        "symbolId": { "type": "string", "minLength": 1 },
        "facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fact" }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "certainty", "trivial", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "text": { "type": "string", "minLength": 1 },
        "certainty": { "enum": ["direct", "inference"] },
        "trivial": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "unresolvedQuestionId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "heading", "researchClaimIds", "claims"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "heading": { "type": "string", "minLength": 1 },
        "researchClaimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claim" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "question": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved"] },
        "resolution": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["maintainer-authored", "prose-agent"] },
        "runId": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "prose-agent" } },
            "required": ["kind"]
          },
          "then": { "required": ["runId"] }
        }
      ]
    }
  }
}
