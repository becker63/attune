load("//platform/build:native.bzl", "native_flix_java_test")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The one remaining test-only proposal source. P01-P04, P07 and P10 were
# consolidated into the compact core (`//test/spine:core_*_test`) and the real
# Parquet seam (`//test/seam:parquet_seam_test`); P05 and P06 were consolidated
# into the `Attune.Theory` owner (`//test/theory:theory_law_test`); and P09's
# projection identity was already owned by the shared `Attune.View`, so its
# duplicate proposal source was removed and its laws absorbed into
# `//test/view:semantic_view_test` and `//test/view:proof_view_test`. P08 stays
# until its own feature absorbs its decision/evidence settlement semantics. The
# approved policy admits and counts this exact prefix (`test/proposals/`).

# P08: prior and decision contracts. The approved LangChain4j seam is driven by
# a recorded fake transport; a decoded in-budget decision is chosen, a classified
# failure stays a failure, and over-budget/unknown requests take the declared
# fallback. No provider is contacted. Executed fixture.
native_flix_java_test(
    name = "p08_decisions_test",
    srcs = [
        "P08Decisions.flix",
        "//test/seam:Seam.flix",
    ],
    java_deps = ["//test/seam:attune_inference"],
)
