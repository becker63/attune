load("//platform/build:native.bzl", "native_flix_java_test", "native_study_stage")
load("//platform/build:sol.bzl", "attune_reviewbench_review_cohort", "attune_sol_route_check")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The dedicated remote execution platform of the paired review arms. It is the
# SAME declared platform as the original and inspected Sol arms: the ChatGPT-plan
# SIWC route reaches the plan backend through BuildBuddy's declared
# external-network contract, and the SIWC access token is injected only as the
# BuildBuddy secret `ACCESS_TOKEN`. The review arms are a distinct sibling, not a
# new route and not a new platform.
platform(
    name = "remote",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    exec_properties = {
        "Arch": "arm64",
        "OSFamily": "Linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu22-04@sha256:0d84a80bb0fc36ba5381942adcf6493249594dcc9044845c617b78c9b621cae3",
        "network": "external",
        "env-secrets": "ACCESS_TOKEN",
        "recycle-runner": "false",
        "EstimatedCPU": "0.5",
        "EstimatedMemory": "512MB",
    },
)

# The declared pre-flight of the review arms' secret boundary. It makes NO
# provider call and touches no corpus, so it runs before any review without
# consuming plan usage. It is `fresh`, so a NEW
# `--define=attune_measurement_freshness=<token>` reports the currently injected
# token instead of replaying a cached verdict.
attune_sol_route_check(
    name = "route_check",
    fresh = True,
    tags = ["manual"],
)

exports_files(["prompt.txt"])

# The frozen review prompt's exact identity: the SHA-256 of `prompt.txt`, frozen
# BEFORE any outcome. Both arms carry the SAME prompt bytes; only the assisted
# arm additionally declares its own task's structural context.
PROMPT_IDENTITY = "sha256:0548d216c163f1719adb8d2b292b8038e006409d34a37865acd3984a96c6c08c"

# The pinned companion `codex-code-mode-host` binary and the pinned bundled
# sandbox helper of the same Codex release, exactly as the verified inspected
# arm declares them.
CODE_MODE_HOST = "@codex_code_mode_host//:codex-code-mode-host-aarch64-unknown-linux-musl"
CODE_BWRAP = "@codex_bwrap//:bwrap-aarch64-unknown-linux-musl"

# The frozen structurally admitted cohort of the 24-task metadata selection: the
# ten tasks whose supported languages cover at least 90% of their changed source
# bytes, each with its exact head world. The fourteen excluded tasks stay named
# attrition in the planned denominator; no task is replaced and none is forced.
REVIEW_TASKS = [
    ["task", "capawesome-team_cli-126", "capawesome-team/cli", "capawesome-team_cli-126-head"],
    ["task", "heyitsaamir_teamscli-31", "heyitsaamir/teamscli", "heyitsaamir_teamscli-31-head"],
    ["task", "haoling_diary-notebook-blog-transformer-24", "haoling/diary-notebook-blog-transformer", "haoling_diary-notebook-blog-transformer-24-head"],
    ["task", "caasi_town-zero-6", "caasi/town-zero", "caasi_town-zero-6-head"],
    ["task", "EdV4H_usketch-534", "EdV4H/usketch", "EdV4H_usketch-534-head"],
    ["task", "rulecom_rule-io-sdk-40", "rulecom/rule-io-sdk", "rulecom_rule-io-sdk-40-head"],
    ["task", "brianc_node-postgres-3650", "brianc/node-postgres", "brianc_node-postgres-3650-head"],
    ["task", "agent-sh_agentsys-298", "agent-sh/agentsys", "agent-sh_agentsys-298-head"],
    ["task", "jenkinsci_gitea-plugin-141", "jenkinsci/gitea-plugin", "jenkinsci_gitea-plugin-141-head"],
    ["task", "ls1intum_Artemis-12479", "ls1intum/Artemis", "ls1intum_Artemis-12479-head"],
]

# The shared owners the materialized artifacts already reference. The parent
# module chain (`Attune` -> `Attune.Study` -> `Attune.Study.ReviewBenchReview`)
# must be declared, so the review owner's own file is listed here and reused by
# both the stages and the corpus-free laws.
OWNER_SRCS = [
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Repository.flix",
    "//src:Attune/Repository/Grit.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Embedding.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Qwen.flix",
    "//src:Attune/Study/ReviewBench.flix",
    "//src:Attune/Study/ReviewBenchReview.flix",
    "//src:Attune/Theory.flix",
]

STAGE_SRCS = ["ReviewBenchReviewStages.flix"] + OWNER_SRCS

# The declared public metadata projection of the admitted cohort: one `issue` row
# per admitted task carrying the pinned PR title and body. It reads no finding and
# no gold, and it calls no provider: it reduces the already-materialized admission
# projection only.
native_study_stage(
    name = "reviewbench_review_issues",
    srcs = STAGE_SRCS,
    input_names = ["admission"],
    inputs = ["//test/reviewbench:reviewbench_admission"],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_review_issues",
    tags = ["manual"],
)

# The declared public metadata record of the metadata-only 24-task HOLDOUT
# (`VAL-STUDY-004`): one `issue` row per frozen holdout task, projected from the
# SAME pinned-corpus admission projection the original cohort uses and filtered
# to the immutable holdout freeze record. It reads no finding and no gold and
# calls no provider. The target is `manual` because it consumes the pinned-corpus
# admission tree and the holdout freeze tree, not the ordinary gate.
native_study_stage(
    name = "reviewbench_holdout_issues",
    srcs = STAGE_SRCS,
    input_names = [
        "admission",
        "holdout",
    ],
    inputs = [
        "//test/reviewbench:reviewbench_admission",
        "//test/reviewbench_pilot:reviewbench_pilot_freeze",
    ],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_holdout_issues",
    tags = ["manual"],
)

# The declared assisted arm's bounded structural context, once per admitted task,
# from the already-materialized Qwen ranking, JEV public-context decisions and
# task relations/witnesses. Provider-free: no model, no Grit, no Theory lowering
# and no world download happens here.
native_study_stage(
    name = "reviewbench_review_contexts",
    srcs = STAGE_SRCS,
    input_names = ["qwen", "jev"] + ["task_%s" % row[1] for row in REVIEW_TASKS],
    inputs = [
        "//test/reviewbench_context:reviewbench_context_qwen",
        "//test/reviewbench_context:reviewbench_context_jev_context",
    ] + ["//test/reviewbench_context:task_context_%s" % row[1] for row in REVIEW_TASKS],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_review_contexts",
    tags = ["manual"],
)

# The declared paired-review cohort (`VAL-REVIEW-003`): one review action per
# admitted task and arm, on the SAME dedicated BuildBuddy platform and SIWC route
# the published Sol arms use. Both arms carry the same frozen prompt, tools and
# budgets; the assisted arm additionally declares its own task's structural
# context. Every target is `manual`, so the ordinary `bazel test //...` gate never
# runs a review and never spends plan usage.
attune_reviewbench_review_cohort(
    name = "reviewbench_review",
    bwrap = CODE_BWRAP,
    code_mode_host = CODE_MODE_HOST,
    codex = "@codex_cli//:codex-aarch64-unknown-linux-musl",
    contexts = ":reviewbench_review_contexts",
    issues = ":reviewbench_review_issues",
    measure = "//test/reviewbench:reviewbench_measure",
    prompt = ":prompt.txt",
    prompt_identity = PROMPT_IDENTITY,
    tasks = REVIEW_TASKS,
    world_repo = "@reviewbench_worlds",
)

# The corpus-free laws of the paired-review owner (`VAL-REVIEW-003`): the frozen
# planned/admitted denominators, the per-review budget and identities, the two-arm
# identity, the finding ceiling and the classification. Pure, so the ordinary
# offline gate runs them without touching the corpus or a provider.
native_flix_java_test(
    name = "reviewbench_review_law",
    srcs = ["ReviewBenchReviewLaw.flix"] + OWNER_SRCS,
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
)

test_suite(
    name = "all",
    tests = [":reviewbench_review_law"],
)
