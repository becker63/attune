load("//platform/build:native.bzl", "native_study_stage")
load("//platform/build:study.bzl", "attune_admission_probe", "attune_study")
load("//test/study:manifest/manifest.bzl", "ANALYSIS")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The world/task/pair fixture population is declared once, by the admitted
# manifest: `manifest/panel.tsv` names each world's source, facts and descriptor
# files, and `manifest/analysis.tsv` is the bounded gold-free record set native
# preparation emitted from it. Restating those paths here would be a second,
# drift-prone declaration of the same population, so the macro consumes the
# manifest instead. The evaluator labels under `fixtures/labels/` are a separate
# declared population, named only by the `label_fixtures` argument, so the only
# stage that reads one is the declared `reduce_<task>` join.

# The explicit source closure every declared stage compiles: the dispatcher plus
# the shared owners it consumes. One declaration, so every stage action compiles
# exactly the same set and no stage can reach a source its closure omits. The
# dispatcher is a thin adapter; the bounded panel selection, candidate ranking
# and anchor decoding live in `Attune.Study`, and the descriptor decoding and
# shard lowering live in `Attune.Theory`.
STAGE_SRCS = [
    "Stages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Theory.flix",
]

# The one declared result reducer compiles the same dispatcher plus the Parquet
# reducer law, which imports the typed Arrow seam. The seam jar is therefore a
# declared dependency of the reducer stage alone, not of every study stage.
RESULT_SRCS = STAGE_SRCS + [
    "Results.flix",
    "//src:Attune/AsciiTree.flix",
    "//src:Attune/View.flix",
]

# Native preparation: the pinned Tester runs the declared panel through the
# stage dispatcher and materializes one declared tree holding `analysis.tsv` and
# the loadable `manifest.bzl`. This is the emitted manifest the integration owner
# admits back into the workspace before the selected study invocation. The
# declared panel carries no evaluator material: only group/task/pair/world
# metadata.
native_study_stage(
    name = "analysis_prepare",
    srcs = STAGE_SRCS,
    input_names = ["panel"],
    inputs = ["manifest/panel.tsv"],
    stage = "prepare_manifest",
    tags = ["manual"],
)

# The same preparation over the declared over-cap panel, so the bounded-truncation
# laws can prove an exceeded bound is reported rather than silently dropped.
native_study_stage(
    name = "analysis_prepare_overflow",
    srcs = STAGE_SRCS,
    input_names = ["panel"],
    inputs = ["manifest/panel_overflow.tsv"],
    stage = "prepare_manifest",
    tags = ["manual"],
)

# The same preparation over the declared late-pair panel: nine declared groups
# whose only pairs live in the first (a normally retained pair), the eighth (a
# pair solely in a later included localization group) and the ninth (a group
# outside the included pair groups) group. The attrition laws prove the retained
# pairs survive and the filtered pair is reported explicitly.
native_study_stage(
    name = "analysis_prepare_late",
    srcs = STAGE_SRCS,
    input_names = ["panel"],
    inputs = ["manifest/panel_late.tsv"],
    stage = "prepare_manifest",
    tags = ["manual"],
)

# The same preparation over the declared capped-pair panel: one group whose 36
# declared pairs exceed the declared pair bound of 32, so the attrition laws can
# prove the pair-count cap reports its own input/kept/excluded/reason row beside
# the separate over-bound declaration.
native_study_stage(
    name = "analysis_prepare_capped",
    srcs = STAGE_SRCS,
    input_names = ["panel"],
    inputs = ["manifest/panel_capped.tsv"],
    stage = "prepare_manifest",
    tags = ["manual"],
)

# The complete declared world/task/pair fan-out, expanded from the admitted
# manifest. Study targets are manual on purpose: `bazel test //...` must not
# accidentally acquire or run the selected study surface. Every law, variant,
# anchor and plan this graph consumes is named here, so the live workspace audit
# sees the exact declared population rather than a macro default.
attune_study(
    name = "study",
    analysis = ANALYSIS,
    branch_plans = {
        "a": "fixtures/branches/a.tsv",
        "ab": "fixtures/branches/ab.tsv",
        "b": "fixtures/branches/b.tsv",
        "baseline": "fixtures/branches/baseline.tsv",
    },
    label_fixtures = "fixtures/labels",
    law_srcs = {
        "bounds_test": "BoundsLaw.flix",
        "dag_test": "DagLaw.flix",
        "firewall_test": "FirewallLaw.flix",
        "manifest_test": "ManifestLaw.flix",
        "results_test": "ResultsLaw.flix",
    },
    parquet_deps = ["//platform/tools/parquet:attune_parquet"],
    plan = "fixtures/plan.tsv",
    result_srcs = RESULT_SRCS,
    stage_srcs = STAGE_SRCS,
    variant_files = {
        "ab": "fixtures/variants/ab.flix",
        "a": "fixtures/variants/a.flix",
        "b": "fixtures/variants/b.flix",
        "baseline": "fixtures/variants/base.flix",
    },
)

# The bounded macro-admission regression. Two declared record sets are run
# through the same production `_bound_violations` contract the study macro
# enforces over the admitted manifest. The first carries over-bound structural
# declarations only; the second carries both a `truncated` bound finding and the
# `truncated pair_attrition` row the preparation emits for a filtered or capped
# pair (the old `exceeded`-only check admitted the first, and an unrecorded loss
# produced no row to refuse at all). Under `--define=attune_admission_strict=1`
# each probe fails on exactly its violations; without the define they only record
# them, so the ordinary offline gate is never affected.
_PROBE_BOUNDS = [
    "bounds\tgroups\t24",
    "bounds\ttasks_per_group\t4",
    "bounds\tpairs\t32",
    "bounds\tpair_groups\t8",
    "bounds\tcandidates\t256",
    "bounds\tshards_per_world\t8",
    "bounds\tshard_size\t32",
]

_PROBE_OVERBOUND = (
    ["generation\tprobe-overbound"] +
    _PROBE_BOUNDS +
    ["group\tg%d\tacme/x%d\tdevelopment" % (index, index) for index in range(25)] +
    ["shard\tw1\t%d\t4" % index for index in range(8)] + [
        "shard\tw1\t8\t40",
    ] + ["shard\tw2\t%d\t32" % index for index in range(8)] +
    ["task\tt%d\tg1\tw1\tlocalization\tFile:Shop.flix" % index for index in range(5)]
)

_PROBE_TRUNCATED = (
    ["generation\tprobe-truncated"] +
    _PROBE_BOUNDS + [
        "truncated\tpairs\t36\t32",
        "truncated\tpair_attrition\t36\t32\t4\tpair-count-cap",
    ]
)

attune_admission_probe(
    name = "admission_probe",
    rows = _PROBE_OVERBOUND,
)

attune_admission_probe(
    name = "admission_probe_truncated",
    rows = _PROBE_TRUNCATED,
)
