load("@grit_crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population: the
# inherited pinned Grit native support, its two grammar patches and the one
# approved Ruby dispatcher arm. It is admitted as an inherited/support family,
# counted separately from shared first-party implementation code.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "attune_grit.h",
    "lib.rs",
    "cargo-bazel-lock.json",
])

# rules_rust's hermetic LLVM toolchain links cdylibs with compiler-rt but does
# not automatically retain the real unwind archive. Keep that runtime edge a
# declared C++ dependency; no host libgcc or /nix/store path enters the action.
cc_import(
    name = "unwind",
    alwayslink = True,
    static_library = "@llvm-project//libunwind:libunwind.static",
)

# The frozen Grit ABI shared library. `lib.rs` is the retained native host plus
# exactly two approved extensions: the Flix/Starlark registry patches that
# arrive through `@gritql_source`, and the one Ruby dispatcher arm.
rust_shared_library(
    name = "attune_grit_abi",
    srcs = ["lib.rs"],
    aliases = aliases(package_name = "attune-grit"),
    crate_name = "attune_grit_abi",
    edition = crate_edition(package_name = "attune-grit"),
    link_deps = [":unwind"],
    proc_macro_deps = all_crate_deps(
        package_name = "attune-grit",
        proc_macro = True,
    ),
    deps = all_crate_deps(
        package_name = "attune-grit",
        normal = True,
    ) + [
        "@gritql_source//crates/core:marzano_core",
        "@gritql_source//crates/language:marzano_language",
        "@gritql_source//crates/util:marzano_util",
    ],
)
