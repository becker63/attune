module(
    name = "attune",
    version = "0.1.0",
)

# The pinned Flix compiler is a declared, checksummed engineering dependency.
# It is a private build tool, never a public project verb.
http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_jar(
    name = "flix_compiler",
    sha256 = "b2ed2b7f49902e2dfe1b4f10e23d9a5cb085461e7e8c64909ca2b3abfa566e74",
    urls = ["https://github.com/flix/flix/releases/download/v0.76.1/flix.jar"],
)

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "platforms", version = "1.1.0")

# The pinned native Grit closure: the Rust toolchain, the hermetic LLVM toolchain
# (Rust cdylibs link against its real libunwind archive), rules_cc for that link
# edge, and the crate universe generated from the frozen Grit lock. Every input
# below is a pinned, non-secret engineering dependency of the inherited Grit
# support; the one newly approved Rust extension lives in platform/support/grit/lib.rs.
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "llvm", version = "0.8.21")

register_toolchains("@llvm//toolchain:all")

llvm_runtime = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm_runtime, "llvm-project")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# One content-addressed materialization of the frozen Grit source. The Grit pin
# `c80b3026471b229f41b279c3eb0c162dcdacfdb1` is unchanged; Attune's admitted
# languages are extensions of that one closure (Java and Ruby simply stop being
# stripped; Flix and Starlark are two additional pinned Tree-sitter grammars).
# The Flix grammar revision is the SAME revision `platform/zed/extension.toml` pins for
# the editor, so Grit and Zed cannot drift onto two Flix grammars.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

gritql_repository = use_repo_rule("//platform/build:grit_repository.bzl", "gritql_repository")

gritql_repository(
    name = "gritql_source",
    attune_lib = "//platform/support/grit:lib.rs",
    cargo_lock = "//platform/support/grit:Cargo.lock",
    language_patches = [
        "//platform/support/grit/patches:flix.rs",
        "//platform/support/grit/patches:flix_binding.rs",
        "//platform/support/grit/patches:starlark.rs",
        "//platform/support/grit/patches:starlark_binding.rs",
        "//platform/support/grit/patches:textual_metavariable.rs",
    ],
)

crate.from_cargo(
    name = "grit_crates",
    cargo_lockfile = "@gritql_source//:Cargo.lock",
    lockfile = "//platform/support/grit:cargo-bazel-lock.json",
    manifests = ["@gritql_source//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "grit_crates")

# The approved typed JVM seams: the LangChain4j 1.18.1 SDK path (with its
# pinned Jackson 2.22.1) and the Arrow 19.0.0 Dataset/Parquet codec. These are
# declared engineering dependencies, never a live provider, dataset or
# credential. They are resolved by the ordinary package-provisioning step; the
# test actions themselves make no network call.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "attune_maven",
    artifacts = [
        "com.fasterxml.jackson.core:jackson-databind:2.22.1",
        "dev.langchain4j:langchain4j-core:1.18.1",
        "dev.langchain4j:langchain4j-http-client:1.18.1",
        "dev.langchain4j:langchain4j-http-client-jdk:1.18.1",
        "dev.langchain4j:langchain4j-open-ai:1.18.1",
        "org.apache.arrow:arrow-dataset:19.0.0",
        "org.apache.arrow:arrow-memory-unsafe:19.0.0",
        "org.slf4j:slf4j-nop:2.0.18",
    ],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "attune_maven")

# The narrow Node/TypeScript adapter closure (owner-authorized 2026-10-09). The
# mission's implementation-language restriction is lifted ONLY for the bounded
# DSH/Typert evidence substrate: compatible pinned Aspect rules_js/rules_ts and
# rules_nodejs, the pinned Node 24.18.1 runtime the installed DSH 0.2.0-rc.2
# package itself runs on, the pinned pnpm used to translate the DSH npm lock, and
# the real Typert 0.2.0-rc.2 generator. None of this Bazelizes the upstream DSH
# monorepo; it packages one narrow declared adapter. The whole workspace is never
# `--config=remote`d wholesale for this closure: only the explicitly selected
# adapter and smoke targets declare the Node toolchain and the npm packages.
bazel_dep(name = "rules_nodejs", version = "6.7.6")
bazel_dep(name = "aspect_rules_js", version = "2.9.3")
bazel_dep(name = "aspect_rules_ts", version = "3.5.1")

# The one pinned Node runtime of the adapter closure. It is the SAME Node minor
# the installed pinned DSH package is launched with
# (`/nix/store/...-nodejs-24.18.1`), so the hermetic Bazel Node and the observed
# local DSH Node cannot drift onto two runtimes. `nodejs_toolchains` is the
# rules_nodejs toolchain repo; the runtime toolchain must register before the
# non-runtime one (rules_nodejs's own bzlmod ordering requirement).
nodejs = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
nodejs.toolchain(node_version = "24.18.1")
use_repo(nodejs, "nodejs_toolchains")

register_toolchains("@nodejs_toolchains//:linux_amd64_runtime_toolchain")
register_toolchains("@nodejs_toolchains//:linux_amd64_toolchain")
register_toolchains("@nodejs_toolchains//:linux_arm64_runtime_toolchain")
register_toolchains("@nodejs_toolchains//:linux_arm64_toolchain")

# The single authoritative npm translation of the DSH 0.2.0-rc.2 dependency
# graph. The committed `platform/dsh/package-lock.json` is the unchanged user
# Nix package lock; `platform/dsh/pnpm-lock.yaml` is its ordinary `pnpm import`
# translation (no hand edit), and this extension fetches exactly the packages
# that lock names. No host `npm install` and no global package ever repairs a
# missing dependency: an undeclared dependency fails the action.
dsh_npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
dsh_npm.npm_translate_lock(
    name = "dsh_npm",
    data = ["//platform/dsh:package.json"],
    pnpm_lock = "//platform/dsh:pnpm-lock.yaml",
    # The two native-addon families in the DSH graph resolve their platform
    # package by a bare `require` of the family name suffixed with the platform
    # triple, from a loader that lives under `.aspect_rules_js/`, i.e. outside
    # the package whose `optionalDependencies` declare it. A flat hoist of
    # exactly those platform packages to `platform/dsh/node_modules` is what
    # Node's ordinary resolution needs; nothing else is hoisted, so no other
    # dependency resolution changes.
    #
    # `@deepseek-ai/cordis` is hoisted for the same ordinary-resolution reason:
    # the narrow installable evidence-contract package is a Cordis plugin whose
    # declared peer is `@deepseek-ai/cordis ~4.0.4`, so a consumer under
    # `platform/dsh/` must resolve that exact pinned peer by its bare name. It is
    # the peer the whole DSH graph already resolves to, so this adds no second
    # copy and changes no other dependency's resolution.
    public_hoist_packages = {
        "@deepseek-ai/cordis@4.0.4": ["platform/dsh"],
        # The supported durable session backends the local integration profile
        # imports a native bundle through: the JSONL persistence backend is the
        # one the pinned DSH itself writes, and the SQLite session-query backend
        # is its supported derived index. Both are transitive members of the
        # declared graph; the flat hoist is what the integration package's bare
        # `import` needs, exactly as `dsh-tools` and `cordis` are hoisted above.
        "@deepseek-ai/dsh-session-persistence-jsonl@0.2.0-rc.2": ["platform/dsh"],
        "@deepseek-ai/dsh-session-query-sqlite@0.2.0-rc.2": ["platform/dsh"],
        "@deepseek-ai/dsh-session@0.2.0-rc.2": ["platform/dsh"],
        "@deepseek-ai/dsh-tools@0.2.0-rc.2": ["platform/dsh"],
        "node-addon-require-builtin-linux-arm64-gnu@0.1.7": ["platform/dsh"],
        "node-addon-system-linux-arm64@0.1.2": ["platform/dsh"],
        "typescript@6.0.3": ["platform/dsh"],
    },
    update_pnpm_lock = False,
)
use_repo(dsh_npm, "dsh_npm")

# The declared isolation tool: pinned util-linux `unshare` and its runtime
# closure, resolved from the Nix developer shell PATH (never a hardcoded
# readiness cache path).
local_unshare = use_repo_rule("//platform/build:unshare_repository.bzl", "local_unshare")

local_unshare(name = "unshare")

# The live root workspace path, recorded once so the local read-only audit test
# can re-read the current tree instead of a declared or cached inventory.
local_workspace = use_repo_rule("//platform/build:workspace_root.bzl", "local_workspace")

local_workspace(name = "local_workspace")

# Existing BuildBuddy integration. The toolchain supplies the remote platform
# labels; the ordinary `bazel test //...` gate does not use them.
#
# The extension's built-in `UBUNTU22_04_IMAGE` constant resolves to the mutable
# tag `gcr.io/flame-public/rbe-ubuntu22-04:latest`, so the declared execution
# platform would carry a moving runtime identity and no execution record could
# name the bytes that actually ran. The extension's supported `container_image`
# attribute instead declares the registry-resolved immutable digest of that same
# image (resolved from the tag with a read-only registry lookup on 2026-10-05),
# on the same compatible `Arch=arm64`, `OSFamily=Linux`, `dockerNetwork=off`
# platform. No tool, version, account or pool changes with it.
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.platform(
    container_image = "gcr.io/flame-public/rbe-ubuntu22-04@sha256:0d84a80bb0fc36ba5381942adcf6493249594dcc9044845c617b78c9b621cae3",
)
use_repo(buildbuddy, "buildbuddy_toolchain")

# The one approved public corpus artifact (VAL-DATA-001): the main issue-based
# `nebius/SWE-rebench-V2` release at one immutable revision and one immutable
# path. The URL carries the revision and the path, and the provider's own
# SHA-256 pins the exact bytes, so a mutated, substituted or different-revision
# file fails the fetch rather than entering the study. The declared identity is
# duplicated nowhere as truth: `Attune.Study`'s `CatalogPin` contract and its one
# `catalogFindings` comparison own the pin, and the acquisition stage recomputes
# the SHA-256 of the materialized bytes, so a drift between this URL and that
# declaration fails the catalog law instead of passing quietly.
#
# The declaration is placed last on purpose: adding a `use_repo_rule` repo before
# the `grit_crates` extension renumbers the anonymous repos and fails the pinned
# `platform/support/grit/cargo-bazel-lock.json` resolution digest. Declaring it
# last leaves that inherited lock untouched.
#
# This is a public-input acquisition, distinct from the credential-free,
# network-denied scientific guests: the fetch happens on the client, and no
# action that executes a reference obligation ever reaches the network. It is
# requested only by the explicitly selected `manual` `//test/catalog` targets,
# so the ordinary `bazel test //...` gate never acquires the corpus.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "swe_rebench_v2_catalog",
    sha256 = "0e0bf9355f892ad74ae98d4e1c404f39fd6654a8e351ee3e6ab162e4a64cd3ad",
    urls = ["https://huggingface.co/datasets/nebius/SWE-rebench-V2/resolve/10483de0f50fe5da545942705a76c6150171af7f/data/train-00000-of-00001.parquet"],
)

# The approved clean-source acquisition of the selected panel's exact worlds: the
# same declared world/archive/revision/digest identity record the localization
# label stage verified, turned into real materialized source bytes. The manifest
# is the admitted `Attune.Study` archive identity record
# (`//test/study/manifest/catalog:archives.tsv`), so no repository, revision or
# digest is restated here as truth. Each archive is fetched on the client and
# verified against its declared SHA-256 before extraction, exactly like the
# pinned catalog above, and no scientific action ever reaches the network.
#
# Declared last for the same reason as the catalog: a `use_repo_rule` repo
# declared before the `grit_crates` extension renumbers the anonymous repos and
# fails the pinned `cargo-bazel-lock.json` resolution digest.
world_sources = use_repo_rule("//platform/build:world_archives.bzl", "attune_world_sources")

world_sources(
    name = "attune_worlds",
    manifest = "//test/study:manifest/catalog/archives.tsv",
)

# The approved POST-HOC EXPLORATORY EMBEDDING runtime and model (owner 2026-10-07).
# Both read the ONE declared identity record
# `//platform/embedding:runtime-lock.tsv`: the pinned CodeRankEmbed revision's
# model files and the digest-pinned Python/PyTorch inference wheels. Each artifact
# is verified against its declared SHA-256 on the client before it is materialized
# as a portable declared input, so a remote action can carry the exact runtime
# bytes in the CAS and no inference ever runs on the host. Declared last for the
# same anonymous-repo renumbering reason as the catalog and world archives above.
embedding_runtime = use_repo_rule("//platform/build:embedding_runtime.bzl", "attune_embedding_runtime")

embedding_runtime(
    name = "attune_embedding_runtime",
    lock = "//platform/embedding:runtime-lock.tsv",
)

embedding_model = use_repo_rule("//platform/build:embedding_runtime.bzl", "attune_embedding_model")

embedding_model(
    name = "attune_embedding_model",
    lock = "//platform/embedding:runtime-lock.tsv",
)

# The approved hosted-Qwen (Q) continuation (owner 2026-10-07). Q's only route is
# the hosted OpenRouter embeddings API reached through the pinned LangChain4j
# 1.18.1 SDK, so its vectors are acquired on the host by the mission-local
# acquisition helper — whose one authorized credential read never becomes a build
# input — and are admitted here as declared inputs. The committed sanitized
# manifest `//test/localization_qwen:fixture-manifest.tsv` carries identity only
