load("//platform/build:native.bzl", "native_flix_java_test", "native_study_stage")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//platform/dsh:pilot_runner.bzl", "attune_pilot_runners")

package(default_visibility = ["//visibility:public"])

# The frozen review prompt as a linked library, so the pilot composition law can
# consume the SAME declared bytes the runner composes from.
js_library(
    name = "prompt_module",
    srcs = ["prompt.txt"],
)

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

exports_files(["prompt.txt"])

# The explicit source closure of the pilot freeze stage: the freeze dispatcher
# plus the canonical owner it reduces and the shared owners both consume. The
# holdout selection, the arm/protocol identities, the activation rule and the
# Pareto rule all live in `Attune.Study.ReviewPilot`; the metadata-only cohort,
# the fast cohort, the distinct-repository preference and the split mechanism
# live in the existing `Attune.Study.ReviewBench` and `Attune.Study`; the
# frontend language table lives in `Attune.Repository.Grit`. The mechanical
# digest seam (`AttuneReviewBench.sha256Hex`) is the only Java dependency.
PILOT_SRCS = [
    "ReviewPilotStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Repository.flix",
    "//src:Attune/Repository/Grit.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Embedding.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Qwen.flix",
    "//src:Attune/Study/ReviewBench.flix",
    "//src:Attune/Study/ReviewPilot.flix",
    "//src:Attune/Theory.flix",
]

# The explicit source closure of the appended source-binding declaration: the
# binding stage plus the separately versioned binding owner
# (`Attune.Study.ReviewPilotBinding`) and the canonical pilot owner it references.
PILOT_BINDING_SRCS = [
    "ReviewPilotBindingStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Repository.flix",
    "//src:Attune/Repository/Grit.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Embedding.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Qwen.flix",
    "//src:Attune/Study/ReviewBench.flix",
    "//src:Attune/Study/ReviewPilot.flix",
    "//src:Attune/Study/ReviewPilotBinding.flix",
    "//src:Attune/Theory.flix",
]
# The declared ReviewBench pilot SOURCE-BINDING stage (`VAL-STUDY-002`,
# `VAL-STUDY-010`). It APPENDS the separately versioned source-access /
# tool-mount / task-binding record alongside the immutable `1143bc2` freeze
# outputs: the versioned binding identity rows, their frozen invariants and the
# per-task / per-arm run configuration. It reduces the frozen freeze dispatch and
# the already-admitted cohort tool index; it acquires nothing and calls no
# provider. It consumes the pinned-corpus cohort index, so it is `manual`: the
# ordinary gate never fetches the corpus.
native_study_stage(
    name = "reviewbench_pilot_binding",
    srcs = PILOT_BINDING_SRCS,
    input_names = [
        "freeze",
        "cohort",
    ],
    inputs = [
        ":reviewbench_pilot_freeze",
        "//platform/dsh:evidence_reviewbench_cohort",
    ],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_pilot_binding",
    tags = ["manual"],
)

# The declared ReviewBench pilot freeze stage (`VAL-STUDY-001`, `VAL-STUDY-002`,
# `VAL-STUDY-003`, `VAL-STUDY-010`). It reduces the already-materialized,
# already-frozen admission projection and the frozen cohort fixture into the
# metadata-only 24-task holdout, the frozen protocol record, the balanced
# deterministic dispatch record and the frozen activation and Pareto rules. It
# acquires nothing and calls no provider, but it consumes the pinned-corpus
# admission tree, so it is `manual`: the ordinary gate never fetches the corpus.
native_study_stage(
    name = "reviewbench_pilot_freeze",
    srcs = PILOT_SRCS,
    input_names = [
        "admission",
        "cohort",
        "prompt",
    ],
    inputs = [
        "//test/reviewbench:reviewbench_admission",
        "//test/study:fixtures/reviewbench-cohort.tsv",
        "prompt.txt",
    ],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_pilot_freeze",
    tags = ["manual"],
)

# The corpus-free laws of the pilot owner: they drive the exact production arm,
# protocol, observation, holdout, activation and Pareto rules over declared
# fixtures. No corpus, no network, no golden finding and no provider is touched,
# so the ordinary gate runs them.
native_flix_java_test(
    name = "reviewbench_pilot_law",
    srcs = [
        "ReviewPilotBindingLaw.flix",
        "ReviewPilotLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Repository.flix",
        "//src:Attune/Repository/Grit.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/Embedding.flix",
        "//src:Attune/Study/Metrics.flix",
        "//src:Attune/Study/Qwen.flix",
        "//src:Attune/Study/ReviewBench.flix",
        "//src:Attune/Study/ReviewPilot.flix",
        "//src:Attune/Study/ReviewPilotBinding.flix",
        "//src:Attune/Theory.flix",
    ],
    java_deps = ["//platform/tools/grit:attune_grit"],
)

test_suite(
    name = "all",
    tests = [":reviewbench_pilot_law"],
)

# The twenty once-only observations of the gated pilot (`VAL-STUDY-002`,
# `VAL-STUDY-010`, the RUN half). ONE declared DSH action per (task, arm) of the
# frozen balanced deterministic dispatch: the ten original admitted tasks x
# `R0_PLAIN`/`R1_PACKETS`. Every target declares its own run identity, its own
# per-task world binding and its own overlay set; BOTH arms mount the shared
# bounded plain-read facade, the shared candidate-commit operation and the two
# model-hidden detector families plus the mechanical lifecycle guard, and ONLY the
# packet arm additionally mounts the R1-only progressive packet operation. The
# composed review task of each observation is built at run time from the declared
# frozen prompt, the task's own public issue and its own changed-file manifest,
# base/head identities and declared source operations. They are `manual`: the
# ordinary `bazel test //...` gate never runs a provider, and each one is a
# once-only scientific observation (no rerun, no replacement, no quality retry).
attune_pilot_runners(
    name = "reviewbench_pilot_runners",
    cohort = "//platform/dsh:evidence_reviewbench_cohort",
    common_overlays = [
        "//platform/dsh/tool:attune-guard.plugin.yml",
        "//platform/dsh/tool:attune-tool.plugin.yml",
        "//platform/dsh/tool:attune-detector.plugin.yml",
        "//platform/dsh/tool:attune-plain.plugin.yml",
    ],
    issues = "//test/reviewbench_review:reviewbench_review_issues",
    packet_overlay = "//platform/dsh/tool:attune-packet.plugin.yml",
    prompt = "prompt.txt",
    routes = ["//platform/dsh:route-siwc-responses.yml"],
    world_repo = "@reviewbench_worlds",
)
