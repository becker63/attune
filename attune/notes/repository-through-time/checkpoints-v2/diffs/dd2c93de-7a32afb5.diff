-    def basenameOf(parts: List[String]): String =
-        match parts {
-            case last :: Nil => last
-            case _ :: rest => basenameOf(rest)
-            case Nil => ""
-        }
-
-    // ------------------------------------------------------------ admission
-
-    /// Mechanically bounded boundaries: VCS and agent tooling, Bazel output
