# fails the fetch instead of entering the study.
reviewbench_qwen_fixtures = use_repo_rule("//platform/build:qwen_fixtures.bzl", "attune_qwen_fixtures")

reviewbench_qwen_fixtures(
    name = "reviewbench_qwen_fixtures",
    manifest = "//test/reviewbench_context:qwen-fixture-manifest.tsv",
    root = "/home/becker/.cache/attune-reviewbench-qwen",
    token = "1",
)

# The ReviewBench JEV public-context observations (`VAL-REVIEW-002`, owner
