package(default_visibility = ["//visibility:public"])

# The one declared runtime/model identity record for the pinned CodeRankEmbed
# inference runtime (`VAL-EMBED-001`): every entry is a digest-pinned wheel of
# the declared Python/PyTorch inference stack or a digest-pinned model file at
# the pinned revision. It is the single source of truth consumed by both the
# Bazel acquisition repository rules and the Nix packaging expression
# (`platform/embedding/runtime.nix`), so the two cannot drift.
exports_files([
    "runtime-lock.tsv",
    "runtime.nix",
])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)
