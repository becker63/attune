load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The mechanical substrate of the Sol localization arm (`VAL-SOL-001/002/003`).
# It launches the pinned Codex 0.160.1 app-server as a child process, speaks the
# documented JSON-RPC handshake over stdio for exactly one task, extracts the
# agent's raw structured result and writes one sanitized receipt. It holds no
# scientific policy: the frozen prompt bytes, the public issue text and the clean
# world source are declared inputs, and the raw result travels onward for the
# Flix owners to validate and rank. It is the same kind of mechanical Java
# boundary as the other `platform/tools/` adapters.
java_library(
    name = "sol_driver",
    srcs = ["SolLocalizeDriver.java"],
    javacopts = ["--release=21"],
)
