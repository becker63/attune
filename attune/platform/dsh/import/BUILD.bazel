"""The local supported session-persistence import path (VAL-SUB-014/015 core).

This package holds the one importer that publishes a native session bundle into
a dedicated local integration store through the pinned runtime's OWN durable
session-persistence API (`create`/`open`/`read`/`append`/`flush`/`close`), the
mechanical bundle-integrity model that refuses a corrupt/unsupported/traversing/
out-of-order/incomplete bundle before any store write, and the laws that pin the
whole path. It is provider-free and offline, so the ordinary offline gate runs
it.

The declared native bundle fixture is derived from an actual frozen DSH session
(the provider-gate diagnostic): its structure and event vocabulary are the real
native ones, and every model-text field is redacted. The manifest records the
redaction, so the raw-versus-sanitized distinction is explicit and no field is
fabricated.
"""

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

filegroup(
    name = "import_fixtures",
    srcs = [
        "fixtures/valid/events.jsonl",
        "fixtures/valid/manifest.tsv",
        "fixtures/valid/session.jsonl",
    ],
)

filegroup(
    name = "export_fixtures",
    srcs = [
        "fixtures/export/identity.tsv",
    ],
)

js_library(
    name = "import_library",
    srcs = [
        "bundle.mjs",
        "exporter.mjs",
        "historical_trace.mjs",
        "importer.mjs",
        "package.json",
    ],
)

# The laws of the partial historical Codex trace import (VAL-SUB-016). They build
# the ONE bounded partial historical bundle from the declared record derived from
# the preserved historical `codex-app-server` trace, import it through the REAL
# pinned persistence backend, and assert the manifest states the real harness,
# keeps every unrecorded identity `Unavailable`, the partial session log carries
# only recorded content and invents no checkpoint, the import is durable and
# read-only (no model resume) and an identical reimport is a no-op, and the source
# path outside the exact world/revision artifacts stays unavailable. Provider-free
# and offline.
js_test(
    name = "historical_import_test",
    data = [
        ":import_library",
        "//platform/dsh:node_modules",
        "//test/study:historical-codex-trace_tsv",
    ],
    entry_point = "historical_import_test.mjs",
)

# The laws of the import path. They mount the REAL pinned JSONL persistence
# backend through a real Cordis context and drive create/open/read/append/flush/
# close over the declared native bundle fixture. Provider-free and offline.
js_test(
    name = "import_test",
    data = [
        ":import_fixtures",
        ":import_library",
        "//platform/dsh:node_modules",
    ],
    entry_point = "import_test.mjs",
)

# The laws of the actual EXPORT path (VAL-SUB-015). They PRODUCE a bundle from a
# real declared native session tree and assert the integrity manifest is emitted
# from the actual bytes and the native header: the file digests are computed, the
# stable session identity is derived, an unobserved identity stays `Unavailable`,
# the produced bundle round-trips through the same validator and supported
# persistence import path, a mutated source byte changes the produced digest, and
# an incomplete or out-of-order source tree is refused before any bundle is
# written. Provider-free and offline.
js_test(
    name = "export_test",
    data = [
        ":export_fixtures",
        ":import_fixtures",
        ":import_library",
        "//platform/dsh:node_modules",
    ],
    entry_point = "export_test.mjs",
)

# The declared local import action: it imports one bundle directory into a store
# root and prints the identity/digest/event counts it observed. It is the actual
# export/import run, kept `manual` so the ordinary gate never writes a store.
js_binary(
    name = "import_bundle",
    data = [
        ":import_library",
        "//platform/dsh:node_modules",
    ],
    entry_point = "import_bundle.mjs",
    tags = ["manual"],
)

# The declared local EXPORT action: it produces one bundle directory from a real
# declared native session tree and a declared run identity, computing every file
# digest from the actual bytes, and prints the identity/digest it produced. It is
# `manual` so the ordinary gate never writes a bundle.
js_binary(
    name = "export_bundle",
    data = [
        ":import_library",
        "//platform/dsh:node_modules",
    ],
    entry_point = "export_bundle.mjs",
    tags = ["manual"],
)

# The declared local IMPORT action of the partial historical Codex trace
# (VAL-SUB-016): it builds the partial historical bundle from a declared record
# and imports it into a store root through the supported persistence API, then
# prints the identity/digest it observed. It is `manual` so the ordinary gate
# never writes a store.
js_binary(
    name = "historical_import",
    data = [
        ":import_library",
        "//platform/dsh:node_modules",
        "//test/study:historical-codex-trace_tsv",
    ],
    entry_point = "historical_import.mjs",
    tags = ["manual"],
)
