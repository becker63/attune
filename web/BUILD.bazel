load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test", "js_run_binary")
load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_lib//lib:directory_path.bzl", "directory_path")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")
directory_path(name = "tree_sitter_wasm", directory = ":node_modules/web-tree-sitter/dir", path = "tree-sitter.wasm")
copy_to_bin(name = "test_package", srcs = ["package.json"])
copy_to_bin(name = "test_sources", srcs = glob(["studio/*.ts", "server/*.ts"]) + ["test/grit-browser.json", "test/grit-envelope.ts"])

# Package the checked-in site without rerunning any research or model calls.
copy_to_directory(
    name = "static",
    srcs = glob(["site/**"]),
    root_paths = ["web/site"],
)

js_test(
    name = "layout_test",
    size = "small",
    data = [
        "release.json",
        ":static",
    ],
    entry_point = "layout_check.mjs",
    env = {"PATH": "/usr/local/bin:/usr/bin:/bin:/run/current-system/sw/bin"},
)

# Provider-free validation; the browser integration suite additionally runs the
# real compiled artifacts through Chromium and compares them with the JVM.
js_test(
    name = "studio_transport_test",
    size = "small",
    entry_point = "test/run-unit.mjs",
    env = {"PATH": "/usr/local/bin:/usr/bin:/bin:/run/current-system/sw/bin"},
    data = ["test/unit.test.ts", ":test_sources",
        ":test_package",
        ":node_modules/tsx",
        ":node_modules/pprof-format",
    ],
)

# Flix remains browser WASM; Grit runs as a fixed-program native subprocess.
copy_to_directory(
    name = "flix_runtime",
    srcs = ["@attune//platform/browser:wasm"],
    root_paths = ["platform/browser/wasm"],
    include_external_repositories = ["*"],
)
copy_to_directory(
    name = "grit_node_runtime",
    srcs = ["@attune//platform/browser:grit_node"],
    out = ".artifacts/server/grit",
    root_paths = ["**/grit_node"],
    include_external_repositories = ["*"],
)
esbuild(
    name = "grit-wasm-probe",
    entry_point = "test/grit-wasm-worker.mjs",
    srcs = ["test/grit-wasm-worker.mjs", "test/grit-envelope.ts", ":grit_node_runtime"],
    deps = [":node_modules/web-tree-sitter-wasm-bindgen"],
    platform = "node",
    format = "cjs",
    output = "grit-worker.cjs",
    target = "node24",
    sourcemap = False,
)
copy_to_directory(
    name = "grit_wasm_assets",
    srcs = [":grit-wasm-probe", ":grit_node_runtime", ":grit_parsers", ":grit_programs", ":tree_sitter_wasm"],
    root_paths = ["web/.artifacts/server/grit", "web/grit_parsers", "web/grit_programs", "web"],
    include_srcs_patterns = ["**/grit-worker.cjs", "**/grit_bg.wasm", "**/*.grit", "**/tree-sitter*.wasm"],
    include_external_repositories = ["*"],
    replace_prefixes = {"**/tree-sitter.wasm": "tree-sitter.wasm"},
)
# The deployment target belongs here; the standalone library builds its native
# runner for the host without needing the web module's musl toolchain.
platform_transition_filegroup(
    name = "grit_native",
    srcs = ["@attune//platform/support/grit:grit_runner"],
    target_platform = "@llvm//platforms:linux_aarch64_musl",
)
copy_to_directory(
    name = "grit_server_assets",
    srcs = [":grit_native", ":grit_programs"],
    root_paths = ["**/platform/support/grit", "web/grit_programs"],
    include_external_repositories = ["*"],
)
copy_to_directory(
    name = "grit_parsers",
    srcs = ["@attune//platform/browser:grit_parsers"],
    root_paths = ["**/wasm_parsers"],
    include_external_repositories = ["*"],
)
copy_to_directory(
    name = "grit_programs",
    srcs = ["@attune//src/grit:programs"],
    root_paths = ["src/grit"],
    include_external_repositories = ["*"],
    include_srcs_patterns = ["**/javascript.grit", "**/jsx.grit", "**/typescript.grit", "**/tsx.grit"],
)
copy_to_directory(
    name = "grit_notices",
    srcs = ["@attune//platform/browser:grit_notices"],
    include_external_repositories = ["*"],
)

[
    esbuild(
        name = name,
        entry_point = entry,
        srcs = glob(["studio/*.ts"]),
        format = "iife",
        platform = "browser",
        target = "es2022",
        sourcemap = False,
        external = ["fs", "path"],
        define = {"process.versions.node": "undefined", "import.meta.url": "self.location.href"},
    )
    for name, entry in [
        ("studio-worker", "studio/worker.ts"),
        ("parity-worker", "test/parity-worker.ts"),
    ]
]

js_binary(
    name = "package_browser",
    entry_point = "toolchain/package.mjs",
    data = [":node_modules/@duckdb/duckdb-wasm"],
)
js_run_binary(
    name = "browser_assets",
    tool = ":package_browser",
    srcs = glob(["licenses/*.txt"]) + [":static", ":grit_notices",
            ":studio-worker", "THIRD_PARTY.md", "//:license",
            ":flix_runtime", ":grit_server_assets"],
    out_dirs = ["browser_assets", "server_assets"],
    args = ["web/browser_assets", "$(rootpath :static)", "$(rootpath :flix_runtime)",
            "$(rootpath :grit_notices)", "$(rootpath :studio-worker)",
            "$(rootpath THIRD_PARTY.md)", "$(rootpath //:license)", "$(rootpath :grit_server_assets)"],
    mnemonic = "BrowserAssets",
    env = {"PATH": "/usr/local/bin:/usr/bin:/bin:/run/current-system/sw/bin"},
)

js_test(
    name = "browser_parity_test",
    size = "large",
    entry_point = "test/run-parity.mjs",
    data = ["test/browser.test.ts", "test/grit.test.ts", ":test_sources", ":test_package", ":browser_assets", ":parity-worker", ":grit_wasm_assets",
            ":node_modules/tsx", ":node_modules/@playwright/test", ":node_modules/esbuild",
            "@attune//platform/browser:jvm", "@attune//test/browser:grit_probe",
            "@attune//platform/support/grit:attune_grit_abi"],
    env = {"STUDIO_JVM": "$(rootpath @attune//platform/browser:jvm)",
           "PATH": "/usr/local/bin:/usr/bin:/bin:/run/current-system/sw/bin",
           "STUDIO_GRIT_PROBE": "$(rootpath @attune//test/browser:grit_probe)",
           "STUDIO_GRIT_LIBRARY": "$(rootpath @attune//platform/support/grit:attune_grit_abi)"},
    tags = ["no-remote"],
)
