{
  "name": "home-deployment",
  "root": "packages/canopy/home-deployment",
  "sourceRoot": "packages/canopy/home-deployment/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "cd packages/canopy/home-deployment && pnpm exec tsc -p tsconfig.json"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "build",
          "action": "build",
          "recipeId": "home-deployment.build",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/canopy/home-deployment && pnpm exec tsgo --noEmit"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "typecheck",
          "action": "typecheck",
          "recipeId": "home-deployment.typecheck",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/canopy/home-deployment && pnpm exec vitest run"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "test",
          "action": "test",
          "recipeId": "home-deployment.test",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "attune:repair-symbol-registry": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for symbol registry. Public agents should prefer home-deployment:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "symbol-registry",
          "safeOnly": true,
          "action": "repair-symbol-registry",
          "recipeId": "home-deployment.attune.repair-symbol-registry",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project home-deployment --kind symbol-registry --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/home-deployment/attune-symbol-registry.ts"
      ]
    },
    "attune:repair-property-observations": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for property observations. Public agents should prefer home-deployment:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "property-observations",
          "safeOnly": true,
          "action": "repair-property-observations",
          "recipeId": "home-deployment.attune.repair-property-observations",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project home-deployment --kind property-observations --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/home-deployment/attune-property-observations.ts"
      ]
    },
    "attune:repair-schema-observations": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for schema observations. Public agents should prefer home-deployment:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "schema-observations",
          "safeOnly": true,
          "action": "repair-schema-observations",
          "recipeId": "home-deployment.attune.repair-schema-observations",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project home-deployment --kind schema-observations --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/home-deployment/attune-schema-observations.ts"
      ]
    },
    "attune:repair-observations": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for observation scaffold. Public agents should prefer home-deployment:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "observations",
          "safeOnly": true,
          "action": "repair-observations",
          "recipeId": "home-deployment.attune.repair-observations",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project home-deployment --kind observations --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/home-deployment/attune-observation-scaffold.ts",
        "{workspaceRoot}/.attune/cache/observations/home-deployment/observation-scaffold.json"
      ]
    },
    "attune:repair-artifact-freshness": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for artifact freshness. Public agents should prefer home-deployment:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "artifact-freshness",
          "safeOnly": true,
          "action": "repair-artifact-freshness",
          "recipeId": "home-deployment.attune.repair-artifact-freshness",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project home-deployment --kind artifact-freshness --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/home-deployment/artifact-freshness.json"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Public Attune Framework project check surface. Runs workspace diagnostics through the stable check verb.",
        "attune": {
          "tier": "public",
          "surface": "check",
          "action": "check",
          "recipeId": "home-deployment.check",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec nx run workspace:recipe-substrate-check"
      }
    },
    "repair": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Public Attune Framework project repair surface. Applies safe deterministic repairs through the stable repair verb when available.",
        "attune": {
          "tier": "public",
          "surface": "repair",
          "safeOnly": true,
          "action": "repair",
          "recipeId": "home-deployment.repair",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "commands": [
          "pnpm exec nx run home-deployment:attune:repair-symbol-registry",
          "pnpm exec nx run home-deployment:attune:repair-property-observations",
          "pnpm exec nx run home-deployment:attune:repair-schema-observations",
          "pnpm exec nx run home-deployment:attune:repair-observations",
          "pnpm exec nx run home-deployment:attune:repair-artifact-freshness"
        ],
        "parallel": false
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e 'console.log('\\''Alchemy provider intent is packet/judge-owned; live provider execution is handled by the package provider boundary.'\\'')'"
      },
      "metadata": {
        "description": "Recipe-backed dry-run Canopy deployment plan surface. Live mutation remains behind human review.",
        "attune": {
          "tier": "public",
          "surface": "dev",
          "recipeId": "canopy.home-deployment",
          "action": "dev",
          "projectionId": "framework.projection.nx-target"
        }
      }
    }
  }
}
