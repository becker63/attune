load("//platform/build:native.bzl", "native_flix_test", "native_study_stage")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The replicated lexical JEV five-observation family (`VAL-REPL-001`) is a
# strictly downstream consumer of the frozen sanitized JEV decision manifests. It
# declares no world extraction, Theory lowering, variant ranking, embedding
# acquisition, hosted-Qwen acquisition or JEV call, so materializing it
# re-executes no upstream action and issues no provider request.
#
# `decisions_A_r2..r5.tsv` and `decisions_S_r2..r5.tsv` are the admitted
# sanitized typed-observation manifests of the four deliberately new
# replications of each lexical condition. They were produced by the approved
# mission-local Java mechanical receipt writer over the configured MCP stdio
# `jev_decide` route at the same frozen `A32` population, the same public issue
# bytes, the same candidate paths and original P+A ranks and scores, the same
# frozen prompt bytes and the same fixed model route policy as the preserved
# originals; only the local `replicate_id` of the run differs, and the writer
# persisted every replicate's receipt before issuing its next call. The
# manifests are immutable public fixtures: no payload, no raw response and no
# credential. The preserved `A1`/`S1` originals
# (`//test/localization_jev:decisions_A.tsv` and `:decisions_S.tsv`) stay
# byte-identical and are read here, never rewritten.
#
# `replicate_r1..r5.tsv` are the mechanically reduced per-replicate economics
# records: one row per condition with the measured wall, the declared and actual
# request counts, the logical decision count, the returned retries, tokens and
# cost, the declared latency statistics and the typed status counts, all read
# back from the receipts that run persisted. `replicate_r1.tsv` was regenerated
# from the preserved original receipts and reproduces the published original
# numbers exactly, so the preserved cost is retained without re-acquisition.
STAGE_SRCS = [
    "ReplicatedStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Jev.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Replication.flix",
]

_REPLICATE_IDS = ["2", "3", "4", "5"]

# One preregistered replicate identity per condition, in declared order 1..5: the
# preserved original first, then the four new observations.
_FAMILY_NAMES = ["a1", "s1"] + ["a%s" % id for id in _REPLICATE_IDS] + ["s%s" % id for id in _REPLICATE_IDS]

_FAMILY_FILES = [
    "//test/localization_jev:decisions_A.tsv",
    "//test/localization_jev:decisions_S.tsv",
] + ["//test/localization_replicated:decisions_A_r%s.tsv" % id for id in _REPLICATE_IDS] + [
    "//test/localization_replicated:decisions_S_r%s.tsv" % id
    for id in _REPLICATE_IDS
]

_ECONOMICS_NAMES = ["e1", "e2", "e3", "e4", "e5"]

_ECONOMICS_FILES = ["//test/localization_replicated:replicate_r%s.tsv" % id for id in ["1", "2", "3", "4", "5"]]

# The one replicated-family stage: it binds the five preregistered replicate
# identities of both lexical conditions, the frozen A32 population record, the
# mapped public task manifest and the mechanically reduced economics records, and
# emits the per-observation family record, the per-replicate-by-task identity
# record, the per-replicate typed-outcome and economics record, and the
# family-level checkpoint. `manual` like every corpus-bound stage, so the ordinary
# `bazel test //...` gate never touches it.
native_study_stage(
    name = "replicated_family",
    srcs = STAGE_SRCS,
    input_names = ["mapped", "population"] + _FAMILY_NAMES + _ECONOMICS_NAMES,
    inputs = [
        "//test/study:manifest/localization/mapped.tsv",
        "//test/localization_jev:population.tsv",
    ] + _FAMILY_FILES + _ECONOMICS_FILES,
    stage = "replicated_family",
    tags = ["manual"],
)

# The corpus-free replicated-observation laws (`VAL-REPL-001`): they drive the
# exact production identity and vote statements in `Attune.Study.Replication`
# with hand-built immutable values, so the observation-key law, the shared
# semantic identity and the relevant-only vote are pinned without touching the
# corpus. Pure, so unlike the stage it is not `manual`.
native_flix_test(
    name = "replicated_law",
    srcs = [
        "ReplicatedLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/Jev.flix",
        "//src:Attune/Study/Metrics.flix",
        "//src:Attune/Study/Replication.flix",
    ],
)

test_suite(
    name = "all",
    tags = ["manual"],
    tests = [":replicated_law"],
)
