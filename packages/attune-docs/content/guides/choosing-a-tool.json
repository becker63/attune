  "id": "guide.choosing-a-tool",
  "slug": "choosing-a-tool",
  "title": "Choosing a tool",
  "summary": "Pick one of the eight Toolkit operations by the evidence or transition you need.",
  "audience": "A research-agent author or contributor deciding which Attune capability should perform a step.",
  "sections": [
    {
      "id": "repository",
      "heading": "Repository establishes and advances the subject",
      "claims": [
        {
          "id": "tools.repository",
          "text": "Use `repository_materialize` to establish the investigation, then `repository_checkpoint` when an intentional workspace change should become the next snapshot.",
          "certainty": "direct",
          "evidence": [
            {
              "symbol": "ATTUNE_OPERATIONS",
              "facts": ["signature", "source"]
            },
            {
              "symbol": "AttuneToolkit",
              "facts": ["signature"]
            }
          ]
        }
      ]
    },
    {
      "id": "analysis",
      "heading": "Joern observes structure",
      "claims": [
        {
          "id": "tools.joern",
          "text": "Use `joern_query` when the question is about code-property-graph structure. Its Toolkit contract keeps the request and result inside the same named operation.",
          "certainty": "direct",
          "evidence": [
            {
              "symbol": "AttuneToolkit",
              "facts": ["signature", "source"]
            },
            {
              "symbol": "AttuneOperationResult",
              "facts": ["signature"]
            }
          ]
        }
      ]
    },
    {
      "id": "formal-and-falsifiable",
      "heading": "Maude formalizes; properties falsify",
      "claims": [
        {
          "id": "tools.maude",
          "text": "Use `maude_run` when a formal module and command result should be retained as evidence for the active investigation.",
          "certainty": "direct",
          "evidence": [
            {
              "symbol": "AttuneToolkit",
              "facts": ["signature"]
            },
            {
              "symbol": "ATTUNE_OPERATIONS",
              "facts": ["signature"]
            }
          ]
        },
        {
          "id": "tools.property",
          "text": "Use `property_run` when an executable invariant should be tested. Its result remains selected by the operation name rather than widened to every tool result.",
          "certainty": "direct",
          "evidence": [
            {
              "symbol": "AttuneOperationName",
              "facts": ["signature"]
            },
            {
              "symbol": "AttuneOperationResult",
              "facts": ["signature"]
            }
          ]
        }
      ]
    },
    {
      "id": "enforcement",
      "heading": "ast-grep enshrines a structural finding",
      "claims": [
        {
          "id": "tools.ast-grep",
          "text": "Use `ast_grep_run` when a structural rule should be scanned or rewritten. The registry keeps its writer policy and lifecycle transition explicit.",
          "certainty": "direct",
          "evidence": [
            {
              "symbol": "ATTUNE_OPERATIONS",
              "facts": ["signature", "source"]
            },
            {
              "symbol": "AttuneOperationInput",
              "facts": ["signature"]
            }
          ]
        }
      ]
    }
  ],
