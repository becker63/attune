{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://becker63.github.io/attune/schemas/evidence-manifest.schema.json",
  "title": "Attune guide evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "guideId",
    "sourceRevision",
    "sourceDigest",
    "review",
    "provenance",
    "claims"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "guideId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "review": { "$ref": "#/$defs/review" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "certainty", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "certainty": { "enum": ["direct", "inference"] },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbolId", "facts"],
      "properties": {
        "symbolId": { "type": "string", "minLength": 1 },
        "facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fact" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "decisionId",
        "decidedAt",
        "sourceRevision",
        "manifestDigest",
        "draftDigest",
        "evidenceDigest"
      ],
      "properties": {
        "status": { "enum": ["approved", "proposed", "rejected"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "decisionId": { "type": "string", "minLength": 1 },
        "decidedAt": { "type": "string", "format": "date-time" },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "draftDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["maintainer-authored", "prose-agent"] },
        "runId": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "prose-agent" } },
            "required": ["kind"]
          },
          "then": { "required": ["runId"] }
        }
      ]
    }
  }
}
