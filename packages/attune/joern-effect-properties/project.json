{
  "name": "joern-effect-properties",
  "root": "packages/attune/joern-effect-properties",
  "sourceRoot": "packages/attune/joern-effect-properties/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "cd packages/attune/joern-effect-properties && pnpm exec tsc -p tsconfig.json"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "build",
          "action": "build",
          "recipeId": "joern-effect-properties.build",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/attune/joern-effect-properties && pnpm exec tsgo --noEmit"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "typecheck",
          "action": "typecheck",
          "recipeId": "joern-effect-properties.typecheck",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/attune/joern-effect-properties && ATTUNE_RECIPE_ID=joern-effect-properties.property-validation-worker nix develop --command pnpm exec tsx src/fuzz/cli/PropertyVitestCli.ts"
      },
      "metadata": {
        "attune": {
          "worker": {
            "isolationLevel": "file",
            "randomSource": "main-thread"
          },
          "tier": "public",
          "surface": "test",
          "action": "test",
          "recipeId": "joern-effect-properties.test",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "attune:repair-symbol-registry": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for symbol registry. Public agents should prefer joern-effect-properties:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "symbol-registry",
          "safeOnly": true,
          "action": "repair-symbol-registry",
          "recipeId": "joern-effect-properties.attune.repair-symbol-registry",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project joern-effect-properties --kind symbol-registry --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/joern-effect-properties/attune-symbol-registry.ts"
      ]
    },
    "attune:repair-property-observations": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for property observations. Public agents should prefer joern-effect-properties:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "property-observations",
          "safeOnly": true,
          "action": "repair-property-observations",
          "recipeId": "joern-effect-properties.attune.repair-property-observations",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project joern-effect-properties --kind property-observations --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/joern-effect-properties/attune-property-observations.ts"
      ]
    },
    "attune:repair-schema-observations": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for schema observations. Public agents should prefer joern-effect-properties:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "schema-observations",
          "safeOnly": true,
          "action": "repair-schema-observations",
          "recipeId": "joern-effect-properties.attune.repair-schema-observations",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project joern-effect-properties --kind schema-observations --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/joern-effect-properties/attune-schema-observations.ts"
      ]
    },
    "attune:repair-observations": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for observation scaffold. Public agents should prefer joern-effect-properties:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "observations",
          "safeOnly": true,
          "action": "repair-observations",
          "recipeId": "joern-effect-properties.attune.repair-observations",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project joern-effect-properties --kind observations --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/joern-effect-properties/attune-observation-scaffold.ts",
        "{workspaceRoot}/.attune/cache/observations/joern-effect-properties/observation-scaffold.json"
      ]
    },
    "attune:repair-artifact-freshness": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for artifact freshness. Public agents should prefer joern-effect-properties:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "artifact-freshness",
          "safeOnly": true,
          "action": "repair-artifact-freshness",
          "recipeId": "joern-effect-properties.attune.repair-artifact-freshness",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project joern-effect-properties --kind artifact-freshness --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/joern-effect-properties/artifact-freshness.json"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Public Attune Framework project check surface. Runs workspace diagnostics through the stable check verb.",
        "attune": {
          "tier": "public",
          "surface": "check",
          "action": "check",
          "recipeId": "joern-effect-properties.check",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec nx run workspace:recipe-substrate-check"
      }
    },
    "repair": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Public Attune Framework project repair surface. Applies safe deterministic repairs through the stable repair verb when available.",
        "attune": {
          "tier": "public",
          "surface": "repair",
          "safeOnly": true,
          "action": "repair",
          "recipeId": "joern-effect-properties.repair",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "commands": [
          "pnpm exec nx run joern-effect-properties:attune:repair-symbol-registry",
          "pnpm exec nx run joern-effect-properties:attune:repair-property-observations",
          "pnpm exec nx run joern-effect-properties:attune:repair-schema-observations",
          "pnpm exec nx run joern-effect-properties:attune:repair-observations",
          "pnpm exec nx run joern-effect-properties:attune:repair-artifact-freshness"
        ],
        "parallel": false
      }
    },
    "proof": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/attune/joern-effect-properties && ATTUNE_RECIPE_ID=joern-effect-properties.property-validation-worker nix develop --command pnpm exec tsx src/fuzz/cli/PropertyVitestCli.ts"
      },
      "metadata": {
        "attune": {
          "worker": {
            "isolationLevel": "file",
            "randomSource": "main-thread"
          },
          "tier": "public",
          "surface": "proof",
          "action": "proof",
          "recipeId": "joern-effect-properties.proof",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "fuzz": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/attune/joern-effect-properties && ATTUNE_RECIPE_ID=joern-effect-properties.worker-fuzzer nix develop --command pnpm exec tsx src/fuzz/cli/FuzzerCli.ts --preset smoke"
      },
      "metadata": {
        "attune": {
          "worker": {
            "isolationLevel": "file",
            "randomSource": "main-thread",
            "workers": 1,
            "timeoutSeconds": 120,
            "seedRange": "smoke",
            "shard": {
              "id": 0,
              "count": 1
            },
            "shardId": 0,
            "shardCount": 1,
            "shardIndex": 0
          },
          "tier": "public",
          "surface": "fuzz",
          "action": "fuzz",
          "recipeId": "joern-effect-properties.fuzz",
          "projectionId": "framework.projection.nx-target"
        },
        "description": "Recipe-backed smoke fuzzer surface; longer campaigns are recipe parameters, not public Nx aliases."
      }
    }
  }
}
