+    /// Resolve a persisted base origin only when it still names the same path
+    /// in the current HostFS session.
+    ///
+    /// HostFS inode numbers are allocated in lookup order and are not stable
+    /// across remounts. An origin persisted by a previous session can therefore
+    /// collide with an unrelated path in the current session. Reusing that
+    /// mapping would expose two paths as one FUSE inode.
+    fn get_live_origin_overlay_ino(&self, base_ino: i64, path: &str) -> Option<i64> {
+        let overlay_ino = self
+            .reverse_map
+            .read()
+            .unwrap()
+            .get(&(Layer::Base, base_ino))
+            .copied()?;
+        let inode_map = self.inode_map.read().unwrap();
+        let info = inode_map.get(&overlay_ino)?;
+        (info.layer == Layer::Base && info.underlying_ino == base_ino && info.path == path)
+            .then_some(overlay_ino)
+    }
