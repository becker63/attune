load("//platform/build:native.bzl", "native_flix_audit_test", "native_flix_checkout_test", "native_flix_declared_test", "native_flix_test")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The named policy cases, defined and evaluated in Flix.
native_flix_test(
    name = "policy_cases_test",
    srcs = [
        "PolicyCases.flix",
        "//src:Attune.flix",
        "//src:Attune/Policy.flix",
    ],
)

# The hermetic declared-source policy over exactly the declared inputs.
native_flix_declared_test(
    name = "declared_source_policy_test",
    srcs = [
        "DeclaredPolicyLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Policy.flix",
    ],
    declared = "//:policy_sources",
)

# The live read-only uncached workspace audit, as a normal test in the public
# gate. The target is local and uncached, so every `bazel test //...` re-reads
# the current workspace tree and a file added after a green run is seen on the
# next invocation. It also depends on the declared population, so any change to
# the declared inventory re-runs the audit that exists to find source no BUILD
# file admits.
native_flix_audit_test(
    name = "workspace_audit_test",
    srcs = [
        "AuditLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Policy.flix",
    ],
    data = ["//:policy_sources"],
    # The exact top-level boundaries the walk must never enter. The audited root
    # is this nested workspace, whose VCS metadata, agent tooling and read-only
    # reference checkout all live outside it, so the prune set is empty. There is
    # no generic hidden-name rule, so an arbitrary hidden directory stays visible
    # to the audit. The Flix audit test asserts this set equals the policy's own
    # declaration, so the two cannot drift apart silently.
    workspace_root = "@local_workspace//:workspace_root.txt",
)

# The frozen-debt laws: manifest schema, hash identity, monotonic retirement,
# and fail-closed classification, over synthetic manifests and inventories.
native_flix_test(
    name = "frozen_debt_law_test",
    srcs = [
        "FrozenDebtLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Frozen.flix",
    ],
)

# The live checkout gate: the whole checkout (tracked, index, eligible
# untracked) against the frozen debt/data/generated manifests. The declared
# bindings carry the checkout root and git binary; the scan is read-only.
native_flix_checkout_test(
    name = "checkout_source_policy_test",
    srcs = [
        "CheckoutGate.flix",
        "//src:Attune.flix",
        "//src:Attune/Frozen.flix",
        "//src:Attune/Frozen/Scan.flix",
    ],
    checkout_root = "@local_checkout//:checkout_root.txt",
    git_bin = "@local_checkout//:git.txt",
)
