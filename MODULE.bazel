module(name = "attune_studio")

# One dependency graph; the small Flix library remains independently buildable.
bazel_dep(name = "attune", version = "0.1.0")
local_path_override(module_name = "attune", path = "attune")

bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "aspect_rules_esbuild", version = "0.27.1")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.18.0")
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(name = "pnpm", pnpm_version = "10.34.5")
use_repo(pnpm, "pnpm")
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(name = "npm", pnpm_lock = "//web:pnpm-lock.yaml", verify_node_modules_ignored = "//:.bazelignore")
use_repo(npm, "npm")
esbuild = use_extension("@aspect_rules_esbuild//esbuild:extensions.bzl", "esbuild")
esbuild.toolchain(name = "esbuild", esbuild_version = "0.28.0")
use_repo(esbuild, "esbuild_toolchains")
register_toolchains("@esbuild_toolchains//:all")
buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
use_repo(buildbuddy, "buildbuddy_toolchain")
