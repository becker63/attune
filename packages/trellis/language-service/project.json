{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "framework-language-service",
  "projectType": "library",
  "root": "packages/trellis/language-service",
  "sourceRoot": "packages/trellis/language-service/src",
  "targets": {
    "typecheck": {
      "executor": "@attune/nx:toolchain",
      "options": {
        "dryRun": false,
        "tool": "typescript",
        "action": "check",
        "parameters": {
          "classic": true,
          "tsconfig": "tsconfig.json"
        }
      }
    },
    "build": {
      "executor": "@attune/nx:toolchain",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "dryRun": false,
        "tool": "typescript",
        "action": "build",
        "parameters": {
          "tsconfig": "tsconfig.json"
        }
      }
    },
    "test": {
      "executor": "@attune/nx:package-check",
      "options": {
        "dryRun": false,
        "checks": [
          "test"
        ]
      }
    },
    "check": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Project check surface for Trellis language-service CLI diagnostics.",
        "attune": {
          "tier": "public",
          "surface": "check",
          "recipeId": "trellis-language-service.check-summary-projection"
        }
      },
      "options": {
        "targetProject": "framework-language-service",
        "tool": "workspace",
        "action": "check",
        "toolId": "nx-targets",
        "parameters": {
          "targets": [
            "workspace:recipe-substrate-check"
          ]
        },
        "dryRun": false
      }
    },
    "repair": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Project repair surface for safe Trellis language-service repair materialization.",
        "attune": {
          "tier": "public",
          "surface": "repair",
          "safeOnly": true,
          "recipeId": "trellis-language-service.repair-plan"
        }
      },
      "options": {
        "targetProject": "framework-language-service",
        "tool": "workspace",
        "action": "check",
        "toolId": "nx-targets",
        "parameters": {
          "targets": [
            "workspace:repair"
          ]
        },
        "dryRun": false
      }
    }
  },
  "tags": [
    "scope:framework",
    "attune:framework",
    "attune:internal"
  ]
}
