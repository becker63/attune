    name = "prompt_module",
    srcs = ["prompt.txt"],
)

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

exports_files(["prompt.txt", "holdout-archives.tsv"])

# The explicit source closure of the pilot freeze stage: the freeze dispatcher
