--- /dev/null
+++ b/attune/test/spine/CoreApplyLaw.flix
@@ -0,0 +1,87 @@
+use Attune.Apply
+use Attune.Envelope
+use Attune.Envelope.{Atom, Fact, Frontier, World}
+
+/// Native `@Test` laws for the one exact six-atom application (VAL-CORE-002).
+///
+/// The same evaluator applies each of the six directed atoms to one exact
+/// frontier against one world's facts. A legal route preserves the world and the
+/// atom's declared target domain; a legal empty answer stays an empty frontier in
+/// that domain rather than a rejection; an illegal domain composition or a
+/// foreign-world fact is a classified rejection, never an empty success.
+
+def w(): World = World.World("shop-v1")
+
+def fact(source: String, atom: Atom, target: String): Fact =
+    { world = w(), source = source, atom = atom, target = target }
+
+def facts(): List[Fact] = List#{
+    fact("shop/pricing.rb", Atom.Defines, "Pricing.total"),
+    fact("Pricing.total", Atom.DefinedIn, "shop/pricing.rb"),
+    fact("shop/receipt.rb", Atom.Imports, "shop/pricing.rb"),
+    fact("shop/pricing.rb", Atom.ImportedBy, "shop/receipt.rb"),
+    fact("Shop.Receipt.render", Atom.Calls, "Pricing.total"),
+    fact("Pricing.total", Atom.Callers, "Shop.Receipt.render")
+}
+
+def files(names: List[String]): Frontier = Envelope.files(w(), names)
+
+def symbols(names: List[String]): Frontier = Envelope.symbols(w(), names)
+
+/// All six primitive signatures apply to their exact source domain and produce
+/// their declared target frontier.
+@Test
+def allSixAtomsApplyWithTheirDeclaredDomains(): Unit \ Assert = {
+    Assert.assertEq(expected = Ok(symbols(List#{"Pricing.total"})),
+        Apply.apply(facts(), files(List#{"shop/pricing.rb"}), Atom.Defines));
+    Assert.assertEq(expected = Ok(files(List#{"shop/pricing.rb"})),
+        Apply.apply(facts(), symbols(List#{"Pricing.total"}), Atom.DefinedIn));
+    Assert.assertEq(expected = Ok(files(List#{"shop/pricing.rb"})),
+        Apply.apply(facts(), files(List#{"shop/receipt.rb"}), Atom.Imports));
+    Assert.assertEq(expected = Ok(files(List#{"shop/receipt.rb"})),
+        Apply.apply(facts(), files(List#{"shop/pricing.rb"}), Atom.ImportedBy));
+    Assert.assertEq(expected = Ok(symbols(List#{"Pricing.total"})),
+        Apply.apply(facts(), symbols(List#{"Shop.Receipt.render"}), Atom.Calls));
+    Assert.assertEq(expected = Ok(symbols(List#{"Shop.Receipt.render"})),
+        Apply.apply(facts(), symbols(List#{"Pricing.total"}), Atom.Callers))
+}
+
+/// A legal route composes Files -> defines -> Symbols -> defined_in -> Files
+/// through the one evaluator.
+@Test
+def aLegalRouteComposesThroughOneEvaluator(): Unit \ Assert = {
+    match Apply.apply(facts(), files(List#{"shop/pricing.rb"}), Atom.Defines) {
+        case Err(error) => Assert.fail(error)
+        case Ok(symbolsFrontier) => match Apply.apply(facts(), symbolsFrontier, Atom.DefinedIn) {
+            case Err(error)   => Assert.fail(error)
+            case Ok(filesFrontier) => Assert.assertEq(expected = files(List#{"shop/pricing.rb"}), filesFrontier)
+        }
+    }
+}
+
+/// A legal empty continuation keeps its world and its declared target domain,
+/// and the two empty domains stay distinct values.
+@Test
+def legalEmptinessKeepsItsWorldAndDomain(): Unit \ Assert = {
+    let empty = Apply.apply(facts(), files(List#{"shop/ghost.rb"}), Atom.Imports);
+    Assert.assertEq(expected = Ok(files(Nil)), empty);
+    Assert.assertEq(expected = "shop-v1", match empty {
+        case Ok(frontier) => match Envelope.worldOf(frontier) { case World.World(name) => name }
+        case Err(_)       => "rejected"
+    });
+    Assert.assertEq(expected = false, files(Nil) == symbols(Nil))
+}
+
+/// An illegal domain composition is a classified rejection, never an empty success.
+@Test
+def illegalDomainCompositionIsRejection(): Unit \ Assert = {
+    Assert.assertErr(Apply.apply(facts(), symbols(List#{"Pricing.total"}), Atom.Imports));
+    Assert.assertErr(Apply.apply(facts(), files(List#{"shop/pricing.rb"}), Atom.DefinedIn))
+}
+
+/// A fact from another world cannot apply here.
+@Test
+def aForeignWorldFactIsRejection(): Unit \ Assert = {
+    let foreign = { world = World.World("shop-v2"), source = "shop/receipt.rb", atom = Atom.Imports, target = "shop/pricing.rb" };
+    Assert.assertErr(Apply.apply(foreign :: Nil, files(List#{"shop/receipt.rb"}), Atom.Imports))
+}
diff --git a/attune/test/spine/CoreEvidenceLaw.flix b/attune/test/spine/CoreEvidenceLaw.flix
new file mode 100644
index 0000000000..7d242f349d
--- /dev/null
+++ b/attune/test/spine/CoreEvidenceLaw.flix
@@ -0,0 +1,91 @@
+use Attune.Envelope.{Atom, Fact, World}
+use Attune.Study
+
+/// Native `@Test` laws for the typed evidence and artifact values (VAL-CORE-004).
+///
+/// A witness, a complete no-match, unknown and failure stay four distinct
+/// outcomes; the tri-state observation is not a boolean; support counts distinct
+/// observed entities rather than proof paths; and an artifact is identified by
+/// its declared schema, producer and exact input. The serialization round trip
+/// through the real Parquet seam is a separate law in `//test/seam`.
+
+def w(): World = World.World("shop-v1")
+
+def fact(source: String, atom: Atom, target: String): Fact =
+    { world = w(), source = source, atom = atom, target = target }
+
+def support(entity: String, branch: String, status: Study.Status): Study.Support =
+    { fact = fact(entity, Atom.Calls, branch), status = status }
+
+/// A positive match, a complete no-match, unknown and failure stay distinct.
+@Test
+def witnessNoMatchUnknownAndFailureStayDistinct(): Unit \ Assert = {
+    let facts = List#{ fact("pricing.rb", Atom.Defines, "Pricing") };
+    let own = { scope = w(), subject = "pricing.rb", atom = Atom.Defines };
+    let missing = { scope = w(), subject = "receipt.rb", atom = Atom.Defines };
+    Assert.assertEq(expected = Study.Outcome.Witness, Study.observe(own, Study.Coverage.Complete, facts));
+    Assert.assertEq(expected = Study.Outcome.NoMatch, Study.observe(missing, Study.Coverage.Complete, facts));
+    Assert.assertEq(expected = Study.Outcome.Unknown, Study.observe(missing, Study.Coverage.Partial, facts));
+    Assert.assertEq(expected = Study.Outcome.Unknown, Study.observe(own, Study.Coverage.Missing, Nil));
+    Assert.assertEq(expected = Study.Outcome.Failed, Study.observe(own, Study.Coverage.Failure("acquisition-error"), Nil));
+    Assert.assertEq(expected = false, Study.observe(missing, Study.Coverage.Missing, Nil) == Study.Outcome.NoMatch)
+}
+
+/// A similarly named file in another scope cannot donate a witness.
+@Test
+def aForeignScopeCannotDonateAWitness(): Unit \ Assert = {
+    let facts = List#{ fact("pricing.rb", Atom.Defines, "Pricing") };
+    let foreign = { scope = World.World("shop-v2"), subject = "pricing.rb", atom = Atom.Defines };
+    Assert.assertEq(expected = Study.Outcome.NoMatch, Study.observe(foreign, Study.Coverage.Complete, facts));
+    Assert.assertEq(expected = Study.Outcome.Unknown, Study.observe(foreign, Study.Coverage.Partial, facts))
+}
+
+/// Support counts distinct observed entities, never proof paths, and proposed
+/// evidence cannot meet an observed guard.
+@Test
+def supportCountsDistinctEntitiesNotPaths(): Unit \ Assert = {
+    let items = List#{
+        support("Pricing.total", "calls-pricing", Study.Status.Observed),
+        support("Pricing.total", "calls-pricing", Study.Status.Observed),
+        support("Pricing.rate", "calls-pricing", Study.Status.Observed)
+    };
+    Assert.assertEq(expected = 3, List.length(List.filter(item -> item#fact#target == "calls-pricing", items)));
+    Assert.assertEq(expected = 2, List.length(Study.witnesses(w(), "calls-pricing", items)));
+    Assert.assertEq(expected = false, Study.meets(3, w(), "calls-pricing", items));
+    Assert.assertEq(expected = false, Study.meets(1, w(), "calls-pricing",
+        List#{ support("Pricing.total", "calls-pricing", Study.Status.Proposed) }))
+}
+
+/// The tri-state observation is not a boolean: unmeasured is distinct from false.
+@Test
+def observationTriStateIsNotABoolean(): Unit \ Assert = {
+    Assert.assertEq(expected = "true", Study.observationName(Study.Observation.ObservedTrue));
+    Assert.assertEq(expected = "false", Study.observationName(Study.Observation.ObservedFalse));
+    Assert.assertEq(expected = "unmeasured", Study.observationName(Study.Observation.Unmeasured));
+    Assert.assertEq(expected = false, Study.Observation.Unmeasured == Study.Observation.ObservedFalse)
+}
+
+/// An artifact is identified by schema, producer and exact input; a wrong schema
+/// or a changed identity does not round-trip.
+@Test
+def artifactIdentityRejectsAChangedSchemaOrInput(): Unit \ Assert = {
+    let stored = { schema = Study.Schema.Embedding, producer = "fixture-embed", input = "corpus-1", payload = "vectors" };
+    let wrongSchema = { schema = Study.Schema.Prediction, producer = "fixture-embed", input = "corpus-1", payload = "vectors" };
+    let otherInput = { schema = Study.Schema.Embedding, producer = "fixture-embed", input = "corpus-2", payload = "vectors" };
+    Assert.assertEq(expected = false, Study.artifactIdentity(stored) == Study.artifactIdentity(wrongSchema));
+    Assert.assertErr(Study.accept(stored, wrongSchema));
+    Assert.assertErr(Study.accept(stored, otherInput));
+    Assert.assertEq(expected = true, Result.isOk(Study.accept(stored, stored)))
+}
+
+/// A gold-shaped evaluator input has no path into prediction.
+@Test
+def goldHasNoPathIntoPrediction(): Unit \ Assert = {
+    let gold = Study.goldArtifact(Study.GoldLabel.GoldLabel("modified-pricing.rb"), "task-1");
+    let embedding = { schema = Study.Schema.Embedding, producer = "fixture-embed", input = "corpus-1", payload = "vectors" };
+    Assert.assertEq(expected = Study.Schema.Gold, gold#schema);
+    Assert.assertEq(expected = None, Study.predictInput(gold));
+    Assert.assertEq(expected = Some(Study.PredictionInput.PredictionInput("vectors")), Study.predictInput(embedding));
+    Assert.assertEq(expected = "prediction:vectors", Study.predict(Study.PredictionInput.PredictionInput("vectors")));
+    Assert.assertEq(expected = false, Result.isOk(Study.accept(gold, embedding)))
+}
diff --git a/attune/test/spine/CoreIdentityLaw.flix b/attune/test/spine/CoreIdentityLaw.flix
new file mode 100644
index 0000000000..fcd0881670
--- /dev/null
+++ b/attune/test/spine/CoreIdentityLaw.flix
@@ -0,0 +1,65 @@
+use Attune.Envelope
+use Attune.Envelope.{World, WorldId}
+
+/// Native `@Test` laws for exact nominal identity (VAL-CORE-001).
+///
+/// A frontier is identified by its world, its nominal domain and its complete
+/// finite member set. Reordering one exact set is the same observation, but an
+/// equal cardinality, a shared display basename, another world or another domain
+/// is a different one. World identity carries the canonical origin, the exact
+/// content/source epoch and the frontend/admission semantics, so dirty content
+/// cannot reuse a clean world's identity. A failure here is a real assertion
+/// failure, not a swallowed log line.
+
+/// Reordering one exact finite set is the same observation.
+@Test
+def reorderingOneExactSetPreservesIdentity(): Unit \ Assert = {
+    let world = World.World("shop-v1");
+    Assert.assertEq(
+        expected = Envelope.files(world, List#{"a/pricing.rb", "b/pricing.rb"}),
+        Envelope.files(world, List#{"b/pricing.rb", "a/pricing.rb"}))
+}
+
+/// Equal size is not identity: two sets with the same cardinality stay distinct.
+@Test
+def equalSizedUnequalSetsDoNotMerge(): Unit \ Assert = {
+    let world = World.World("shop-v1");
+    Assert.assertEq(expected = false,
+        Envelope.files(world, List#{"a.flix", "b.flix"}) == Envelope.files(world, List#{"a.flix", "c.flix"}))
+}
+
+/// A shared display basename does not merge two entities.
+@Test
+def sameBasenamesAtDifferentPathsStayDistinct(): Unit \ Assert = {
+    let world = World.World("shop-v1");
+    Assert.assertEq(expected = false,
+        Envelope.files(world, List#{"a/pricing.rb"}) == Envelope.files(world, List#{"b/pricing.rb"}))
+}
+
+/// Same-name declarations with different qualifications stay distinct, and the
+/// nominal domains never merge.
+@Test
+def qualificationsAndDomainsStayDistinct(): Unit \ Assert = {
+    let world = World.World("shop-v1");
+    Assert.assertEq(expected = false,
+        Envelope.symbols(world, List#{"A.render"}) == Envelope.symbols(world, List#{"B.render"}));
+    Assert.assertEq(expected = false,
+        Envelope.symbols(world, List#{"render"}) == Envelope.symbols(world, List#{"A.render"}));
+    Assert.assertEq(expected = false,
+        Envelope.files(world, List#{"x"}) == Envelope.symbols(world, List#{"x"}))
+}
+
+/// World identity carries origin, exact content epoch and semantics, so a dirty
+/// content or a changed semantic recipe never reuses a clean world's identity.
+@Test
+def worldIdentityIncludesContentAndSemantics(): Unit \ Assert = {
+    let clean = Envelope.worldId({ origin = "repo", content = "clean", semantics = "v1" });
+    let same = Envelope.worldId({ origin = "repo", content = "clean", semantics = "v1" });
+    let dirty = Envelope.worldId({ origin = "repo", content = "dirty", semantics = "v1" });
+    let other = Envelope.worldId({ origin = "repo", content = "clean", semantics = "v2" });
+    let fork = Envelope.worldId({ origin = "fork", content = "clean", semantics = "v1" });
+    Assert.assertEq(expected = true, clean == same);
+    Assert.assertEq(expected = false, clean == dirty);
+    Assert.assertEq(expected = false, clean == other);
+    Assert.assertEq(expected = false, clean == fork)
+}
diff --git a/attune/test/spine/CoreMemoLaw.flix b/attune/test/spine/CoreMemoLaw.flix
new file mode 100644
index 0000000000..5683095e6a
--- /dev/null
+++ b/attune/test/spine/CoreMemoLaw.flix
@@ -0,0 +1,67 @@
+use Attune.Apply
+use Attune.Envelope
+use Attune.Envelope.{Atom, Fact, Frontier, World}
+
+/// Native `@Test` laws for the measured local exact memo (VAL-CORE-003).
+///
+/// The same evaluator runs enabled and disabled over one declared serial fixture
+/// with repeated exact lookups, a legal empty reuse, equal-output/different-input
+/// lookups and a cross-world lookup. The key is the world/semantic namespace, the
+/// exact typed input frontier and the next atom; the value keeps the exact output
+/// frontier. The recorded events are the real lookups, so the hit and miss counts
+/// and the producer order are not fabricated.
+
+def w(): World = World.World("shop-v1")
+
+def w2(): World = World.World("shop-v2")
+
+def fact(source: String, atom: Atom, target: String): Fact =
+    { world = w(), source = source, atom = atom, target = target }
+
+def facts(): List[Fact] = List#{
+    fact("Shop.Receipt.render", Atom.DefinedIn, "shop/receipt.rb"),
+    fact("shop/receipt.rb", Atom.Imports, "shop/pricing.rb")
+}
+
+def files(names: List[String]): Frontier = Envelope.files(w(), names)
+
+def files2(names: List[String]): Frontier = Envelope.files(w2(), names)
+
+def symbols(names: List[String]): Frontier = Envelope.symbols(w(), names)
+
+def lookupAt(memo: Apply.Memo, next: Int32, input: Frontier, atom: Atom): (Result[String, Frontier], Apply.Memo, List[Apply.Lookup], Int32) =
+    Apply.lookup(memo, next, "demo", input, atom, facts())
+
+/// The declared serial run: five cold lookups, one empty reuse and one repeated
+/// producer reuse. The events, the ordinals and the answers are all checked.
+@Test
+def theSerialFixtureRecordsExactHitsAndMisses(): Unit \ Assert = {
+    let (a1, m1, e1, n1) = lookupAt(Nil, 0, symbols(List#{"Shop.Receipt.render"}), Atom.DefinedIn);
+    let (a2, m2, e2, n2) = lookupAt(m1, n1, files(List#{"shop/receipt.rb"}), Atom.Imports);
+    let (a3, m3, e3, n3) = lookupAt(m2, n2, files(List#{"shop/pricing.rb"}), Atom.Imports);
+    let (a4, m4, e4, n4) = lookupAt(m3, n3, files(List#{"shop/pricing.rb"}), Atom.Imports);
+    let (a5, m5, e5, n5) = lookupAt(m4, n4, symbols(List#{"Shop.Receipt.render"}), Atom.DefinedIn);
+    let (a6, m6, e6, n6) = lookupAt(m5, n5, files(List#{"shop/checkout.rb"}), Atom.Imports);
+    let (a7, _, e7, _) = Apply.lookup(m6, n6, "demo", files2(List#{"shop/pricing.rb"}), Atom.Imports, Nil);
+    let events = e1 ::: e2 ::: e3 ::: e4 ::: e5 ::: e6 ::: e7;
+    Assert.assertEq(expected = 5, Apply.misses(events));
+    Assert.assertEq(expected = 2, Apply.hits(events));
+    Assert.assertEq(expected = List#{
+        Apply.Lookup.Miss(0), Apply.Lookup.Miss(1), Apply.Lookup.Miss(2),
+        Apply.Lookup.Hit(2), Apply.Lookup.Hit(0), Apply.Lookup.Miss(3), Apply.Lookup.Miss(4)
+    }, events);
+    // Cached and uncached answers agree through the one evaluator.
+    Assert.assertEq(expected = Apply.apply(facts(), symbols(List#{"Shop.Receipt.render"}), Atom.DefinedIn), a1);
+    Assert.assertEq(expected = Apply.apply(facts(), files(List#{"shop/receipt.rb"}), Atom.Imports), a2);
+    Assert.assertEq(expected = Apply.apply(facts(), files(List#{"shop/pricing.rb"}), Atom.Imports), a3);
+    Assert.assertEq(expected = Apply.apply(facts(), files(List#{"shop/checkout.rb"}), Atom.Imports), a6);
+    Assert.assertEq(expected = Apply.apply(Nil, files2(List#{"shop/pricing.rb"}), Atom.Imports), a7);
+    // The repeated empty answer really hits the producer, and the repeated
+    // non-empty answer really hits its own producer.
+    Assert.assertEq(expected = Ok(files(Nil)), a3);
+    Assert.assertEq(expected = a3, a4);
+    Assert.assertEq(expected = a1, a5);
+    // Equal outputs from unequal inputs and another world are not reuse.
+    Assert.assertEq(expected = a3, a6);
+    Assert.assertEq(expected = false, a3 == a7)
+}
