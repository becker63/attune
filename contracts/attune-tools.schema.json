{
  "$defs": {
    "ArtifactPromoteInput": {
      "additionalProperties": false,
      "properties": {
        "artifactUri": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "^attune:\\/\\/investigations\\/[0-9A-HJKMNP-TV-Z]{26}\\/artifacts\\/(?:repository|joern|maude|property|ast-grep|artifact)\\/[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,126}[A-Za-z0-9])?\\/[A-Za-z0-9._~!$&'()*+,;=:@/-]+$",
          "type": "string"
        },
        "destinationPath": {
          "maxLength": 4096,
          "type": "string"
        },
        "expectedSnapshot": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "investigationId": {
          "maxLength": 26,
          "minLength": 1,
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "invocationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,126}[A-Za-z0-9])?$",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/FreeFormReference"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "required": [
        "invocationId",
        "references",
        "investigationId",
        "expectedSnapshot",
        "artifactUri",
        "destinationPath"
      ],
      "type": "object"
    },
    "ArtifactPromoteResult": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "beforeSnapshot": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
              "type": "string"
            },
            "destinationPath": {
              "maxLength": 4096,
              "type": "string"
            },
            "receipt": {
              "$ref": "#/$defs/SucceededReceipt"
            },
            "workingTreeChanged": {
              "type": "boolean"
            }
          },
          "required": [
            "beforeSnapshot",
            "destinationPath",
            "workingTreeChanged",
            "receipt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "receipt": {
              "anyOf": [
                {
