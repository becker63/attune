{
  "name": "attune",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "nx run-many -t generate && nx run attune:format:check && nx run attune:lint && nx run-many -t typecheck && nx run-many -t test && nx run-many -t build && nx run-many -t package:check",
    "format": "oxfmt . && nixfmt flake.nix nix/joern.nix",
    "format:check": "oxfmt --check . && nixfmt --check flake.nix nix/joern.nix",
    "graph": "nx graph",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix ."
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "expect-type": "1.4.0",
    "nx": "23.1.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "rolldown": "1.2.0",
    "ts-morph": "28.0.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.17.0",
  "nx": {}
}
