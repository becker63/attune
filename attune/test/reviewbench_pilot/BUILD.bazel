# holdout selection, the arm/protocol identities, the activation rule and the
# Pareto rule all live in `Attune.Study.ReviewPilot`; the metadata-only cohort,
# the fast cohort, the distinct-repository preference and the split mechanism
# live in the existing `Attune.Study.ReviewBench` and `Attune.Study`; the
# frontend language table lives in `Attune.Repository.Grit`. The mechanical
# digest seam (`AttuneReviewBench.sha256Hex`) is the only Java dependency.
PILOT_SRCS = [
    "ReviewPilotStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Repository.flix",
    "//src:Attune/Repository/Grit.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Embedding.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Qwen.flix",
    "//src:Attune/Study/ReviewBench.flix",
    "//src:Attune/Study/ReviewPilot.flix",
    "//src:Attune/Theory.flix",
]

# The explicit source closure of the appended source-binding declaration: the
# binding stage plus the separately versioned binding owner
