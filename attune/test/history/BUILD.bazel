load("@rules_java//java:defs.bzl", "java_library")
load("//platform/build:native.bzl", "native_flix_java_test")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population. The
# imported historical evidence bytes under `inputs/` are not authored source:
# they are recorded corrected-v2 artifacts, admitted only as declared test
# inputs, so the population here is the two authored files and not a `**` glob
# that would count a Parquet binary as authored code.
filegroup(
    name = "policy_files",
    srcs = [
        "BUILD.bazel",
        "CorrectedRegression.flix",
        "HistoryFixtures.java",
    ],
)

# The recorded corrected-v2 inputs, each listed by the SHA-256 of its exact
# bytes. The population is named rather than globbed, so the declared inventory
# names every retained artifact the regression imports. These files are
# read-only evidence: they are only read through the Arrow seam and are never
# rewritten, regenerated or hand-edited.
filegroup(
    name = "inputs",
    srcs = [
        "inputs/139a9fc6497d9075ac62af2121bb741f69a96c16b8fc5c6c71ce62bd7ff1e0b2.parquet",
        "inputs/9859a98873f38bae935bd4e58a8e7971379b8535d63c2805a31bd89db06861ac.parquet",
        "inputs/a2144a7b6017e7c075cceed0fe1a7c7b9631ea2936ea79510f439b7895a5c22b.parquet",
        "inputs/bfda424b501491d339ae943895ab9e127a5b5e5e2921c2c135b2f63df1bead95.parquet",
        "inputs/f1304c501e38441641ffb3ec2ec8b23bffa761f66c6254cee28dd2760f8ed9da.parquet",
    ],
)

# The mechanical historical-input reader. It maps a declared name onto the
# prepared runfiles path the launcher bound, reports the exact bytes' SHA-256,
# and projects one declared Parquet table through the existing Arrow seam into a
# canonical records text. It classifies nothing and decides no case.
java_library(
    name = "history_fixtures",
    srcs = ["HistoryFixtures.java"],
    javacopts = ["--release=21"],
    deps = [
        "//src/native/parquet:attune_parquet",
        "@attune_maven//:com_fasterxml_jackson_core_jackson_core",
        "@attune_maven//:com_fasterxml_jackson_core_jackson_databind",
    ],
)

# The corrected-intent historical regression: the shared Study policies are
# driven by the retained corrected-v2 inputs read through the real Arrow seam,
# and their verdicts are compared with the retained verdicts and judged
# outcomes. Nothing here reacquires evidence or executes a repository.
native_flix_java_test(
    name = "corrected_regression_test",
    srcs = [
        "CorrectedRegression.flix",
        "//src:Attune.flix",
        "//src:Attune/Envelope.flix",
        "//src:Attune/Study.flix",
    ],
    declared_files = [":inputs"],
    java_deps = [":history_fixtures"],
)
