{
  "name": "attune-architecture",
  "root": "packages/trellis/architecture",
  "sourceRoot": "packages/trellis/architecture/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "cd packages/trellis/architecture && pnpm exec tsc -p tsconfig.build.json"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "build",
          "action": "build",
          "recipeId": "attune-architecture.build",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/trellis/architecture && pnpm exec tsc --noEmit"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "typecheck",
          "action": "typecheck",
          "recipeId": "attune-architecture.typecheck",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "cd packages/trellis/architecture && pnpm exec vitest run"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "test",
          "action": "test",
          "recipeId": "attune-architecture.test",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "attune:repair-symbol-registry": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for symbol registry. Public agents should prefer attune-architecture:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "symbol-registry",
          "safeOnly": true,
          "action": "repair-symbol-registry",
          "recipeId": "attune-architecture.attune.repair-symbol-registry",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project attune-architecture --kind symbol-registry --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/attune-architecture/attune-symbol-registry.ts"
      ]
    },
    "attune:repair-property-observations": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for property observations. Public agents should prefer attune-architecture:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "property-observations",
          "safeOnly": true,
          "action": "repair-property-observations",
          "recipeId": "attune-architecture.attune.repair-property-observations",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project attune-architecture --kind property-observations --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/attune-architecture/attune-property-observations.ts"
      ]
    },
    "attune:repair-schema-observations": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for schema observations. Public agents should prefer attune-architecture:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "schema-observations",
          "safeOnly": true,
          "action": "repair-schema-observations",
          "recipeId": "attune-architecture.attune.repair-schema-observations",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project attune-architecture --kind schema-observations --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/attune-architecture/attune-schema-observations.ts"
      ]
    },
    "attune:repair-observations": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for observation scaffold. Public agents should prefer attune-architecture:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "observations",
          "safeOnly": true,
          "action": "repair-observations",
          "recipeId": "attune-architecture.attune.repair-observations",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project attune-architecture --kind observations --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/attune-architecture/attune-observation-scaffold.ts",
        "{workspaceRoot}/.attune/cache/observations/attune-architecture/observation-scaffold.json"
      ]
    },
    "attune:repair-artifact-freshness": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Internal Attune Framework repair for artifact freshness. Public agents should prefer attune-architecture:repair unless a diagnostic names this target.",
        "attune": {
          "tier": "internal",
          "surface": "repair",
          "repairKind": "artifact-freshness",
          "safeOnly": true,
          "action": "repair-artifact-freshness",
          "recipeId": "attune-architecture.attune.repair-artifact-freshness",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec tsx packages/trellis/architecture/src/recipe-repair-cli.ts --project attune-architecture --kind artifact-freshness --all-safe"
      },
      "outputs": [
        "{workspaceRoot}/.attune/cache/generated/attune-architecture/artifact-freshness.json"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Public Attune Framework project check surface. Runs workspace diagnostics through the stable check verb.",
        "attune": {
          "tier": "public",
          "surface": "check",
          "action": "check",
          "recipeId": "attune-architecture.check",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec nx run workspace:recipe-substrate-check"
      }
    },
    "repair": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Public Attune Framework project repair surface. Applies safe deterministic repairs through the stable repair verb when available.",
        "attune": {
          "tier": "public",
          "surface": "repair",
          "safeOnly": true,
          "action": "repair",
          "recipeId": "attune-architecture.repair",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "commands": [
          "pnpm exec nx run attune-architecture:attune:repair-symbol-registry",
          "pnpm exec nx run attune-architecture:attune:repair-property-observations",
          "pnpm exec nx run attune-architecture:attune:repair-schema-observations",
          "pnpm exec nx run attune-architecture:attune:repair-observations",
          "pnpm exec nx run attune-architecture:attune:repair-artifact-freshness"
        ],
        "parallel": false
      }
    }
  }
}
