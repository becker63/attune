load("//platform/build:native.bzl", "native_flix_test", "native_study_stage")
load("//test/localization_runtime:localization_runtime.bzl", "RUNTIME_CAPPED_EXCLUSIONS")
load("//test/study:manifest/localization/mapped.bzl", "LOCALIZATION_ANALYSIS")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The strict file-accuracy extension and its oracle ceilings (`VAL-STRICT-001`,
# `VAL-STRICT-002`) are a strictly downstream scoring consumer. They bind the
# already-frozen ten-arm ranking trees — the warm `//test/localization_runtime`
# deterministic `P`/`P+A`/`P+A+F`/`P+A+D` trees, the frozen
# `//test/localization_embedding` E trees and the frozen `//test/localization_qwen`
# Q trees — plus the admitted evaluator label artifacts and the four frozen
# sanitized JEV decision manifests. No world extraction, Theory lowering, variant
# ranking, CodeRankEmbed inference, hosted-Qwen acquisition or JEV call is
# declared here, so building the strict table re-executes no upstream action and
# makes no provider call.
#
# This is a repeat and a scoring extension: the ONE canonical
# `Attune.Study.Metrics` is extended with the FileAcc@1/3/5/10/32 family
# (`Metrics.strictMetrics()`), not replaced. The seven-metric tables already
# published stay byte-identical because the extended list is declared separately.
STAGE_SRCS = [
    "StrictStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Embedding.flix",
    "//src:Attune/Study/Jev.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Qwen.flix",
]

_EXCLUDED_GROUPS = [entry["group"] for entry in RUNTIME_CAPPED_EXCLUSIONS]

# The surviving tasks of the frozen runtime-capped cohort, derived from the same
# admitted manifest the cohort macro consumes so the strict population cannot
# drift from the deterministic result it extends.
_DERIVED_TASKS = [
    row
    for row in LOCALIZATION_ANALYSIS
    if len(row) > 3 and row[0] == "task" and row[2] not in _EXCLUDED_GROUPS
]

_DETERMINISTIC_INPUTS = [
    "//test/localization_runtime:rank_%s" % row[1]
    for row in _DERIVED_TASKS
]

_EMBEDDING_INPUTS = [
    "//test/localization_embedding:rank_e_%s" % row[1]
    for row in _DERIVED_TASKS
]

_QWEN_INPUTS = [
    "//test/localization_qwen:rank_q_%s" % row[1]
    for row in _DERIVED_TASKS
]

_LABEL_INPUTS = [
    "//test/study:manifest/localization/label_%s.tsv" % row[1]
    for row in _DERIVED_TASKS
]

# The one strict stage: it reduces the ten available arms `P`, `PA`, `PAF`,
# `PAD`, `E`, `PAJ`, `PAJstructure`, `Q`, `QJ` and `QJstructure` through the
# canonical `Attune.Study.Metrics` (extended with FileAcc), emits the strict
# metric rows, the three oracle ceilings (A32/E32/Q32) and the evaluator-only
# eligible gold cardinality. `manual` like every corpus-bound stage, so the
# ordinary `bazel test //...` gate never touches the corpus.
native_study_stage(
    name = "strict_metrics",
    srcs = STAGE_SRCS,
    input_names = [
                      "mapped",
                      "decisions_a",
                      "decisions_s",
                      "decisions_q",
                      "decisions_qs",
                  ] + ["deterministic_%s" % row[1] for row in _DERIVED_TASKS] +
                  ["embedding_%s" % row[1] for row in _DERIVED_TASKS] +
                  ["qwen_%s" % row[1] for row in _DERIVED_TASKS] +
                  ["label_%s" % row[1] for row in _DERIVED_TASKS],
    inputs = [
        "//test/study:manifest/localization/mapped.tsv",
        "//test/localization_jev:decisions_A.tsv",
        "//test/localization_jev:decisions_S.tsv",
        "//test/localization_qwen_jev:decisions_Q.tsv",
        "//test/localization_qwen_jev:decisions_QS.tsv",
    ] + _DETERMINISTIC_INPUTS + _EMBEDDING_INPUTS + _QWEN_INPUTS + _LABEL_INPUTS,
    stage = "strict_metrics",
    tags = ["manual"],
)

# The corpus-free strict file-accuracy laws (`VAL-STRICT-001`): they drive the
# exact production FileAcc statements in `Attune.Study.Metrics` with hand-built
# immutable rankings, so the FileAcc-versus-Hit separation, the beyond-k false,
# the ineligible undefined, the abstention denominator and the restricted-pool
# oracle boundary are pinned without touching the corpus. Pure, so unlike the
# stage it is not `manual` and the ordinary offline gate runs it.
native_flix_test(
    name = "strict_law",
    srcs = [
        "StrictLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/Jev.flix",
        "//src:Attune/Study/Metrics.flix",
    ],
)

test_suite(
    name = "all",
    tags = ["manual"],
    tests = [":strict_law"],
)
