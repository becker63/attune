load("//platform/build:native.bzl", "native_flix_java_test", "native_study_stage")
load("//test/reviewbench:reviewbench_worlds.bzl", "REVIEWBENCH_WORLDS")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The declared archive identity record the acquisition repository rule consumes,
# and the world target list a measurement stage declares. Both are emitted by the
# real acquisition and read by the acquisition rule; a source file in a package is
# directly addressable, so no export is needed for the manifest itself.
exports_files(["archives.tsv"])

# The explicit source closure every declared stage compiles: the admission and
# measurement dispatchers plus the shared owners they consume. The dispatcher is a
# thin adapter; the origin comparison, the metadata-only exclusion, the frozen
# quota selection, the repository-disjoint split, the source classification, the
# measured byte accounting, the structural admission and the bounded-context
# policy all live in `Attune.Study.ReviewBench`; the existing frontend language
# table lives in `Attune.Repository.Grit`; the existing 3/1/1 split mechanism
# lives in `Attune.Study`; and the hosted-Qwen provider/model/recipe identity the
# frozen shared context names is the existing `Attune.Study.Qwen` owner's, so no
# second recipe is stated. `Attune.Repository` is the required parent module of the
# Grit projection and the mechanical Grit jar is declared beside it, exactly as
# the localization closure declares it.
REVIEWBENCH_SRCS = [
    "ReviewBenchStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Repository.flix",
    "//src:Attune/Repository/Grit.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Embedding.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Qwen.flix",
    "//src:Attune/Study/ReviewBench.flix",
]

# The declared ReviewBench admission stage (`VAL-REVIEW-001`): it verifies the
# declared origin pin against the identity the mechanical boundary observes on the
# real materialized manifest bytes, streams the pinned manifest through the one
# declared metadata projection, reduces the verified population and the frozen
# 24-task selection, and writes the declared records plus the loadable selection
# list the integration owner admits before the study invocation.
#
# The target is `manual` on purpose: the ordinary `bazel test //...` gate must
# never fetch or scan the pinned corpus.
native_study_stage(
    name = "reviewbench_admission",
    srcs = REVIEWBENCH_SRCS,
    input_names = [
        "manifest",
        "pin",
    ],
    inputs = [
        "@reviewbench_manifest//file:file",
        "reviewbench_pin.tsv",
    ],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_admission",
    tags = ["manual"],
)

# The declared ReviewBench world measurement stage (`VAL-REVIEW-002`): it binds
# every selected task's exact base and head worlds, calls the one mechanical
# export-diff boundary and reduces the measured record, the declared structural
# admission or named attrition and the frozen shared-context policy. Full source
# bytes are identical for both review arms because both name the same head world
# and the same base-to-head diff. The target is `manual`, so the ordinary gate
# never fetches the archives; each archive is digest-verified before extraction.
native_study_stage(
    name = "reviewbench_measure",
    srcs = REVIEWBENCH_SRCS,
    input_names = [
        "selection",
        "archives",
    ],
    inputs = [
        ":reviewbench_admission",
        "archives.tsv",
    ],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_measure",
    tags = ["manual"],
    world_sources = REVIEWBENCH_WORLDS,
)

# The corpus-free ReviewBench laws (`VAL-REVIEW-001`, `VAL-REVIEW-002`): they drive
# the exact production origin comparison, metadata exclusion, quota selection,
# repository-disjoint split, source classification, admission threshold, world
# identity, bounded deadline and bounded shared-context policy over declared
# fixtures. No corpus, no network, no golden finding and no provider is touched, so
# the ordinary gate runs them; the mechanical Grit jar is on the class path only
# because the frontend language table's parent module is compiled, and no Grit
# program is evaluated here.
native_flix_java_test(
    name = "reviewbench_law",
    srcs = [
        "ReviewBenchLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Repository.flix",
        "//src:Attune/Repository/Grit.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/Embedding.flix",
        "//src:Attune/Study/Metrics.flix",
        "//src:Attune/Study/Qwen.flix",
        "//src:Attune/Study/ReviewBench.flix",
    ],
    java_deps = ["//platform/tools/grit:attune_grit"],
)

test_suite(
    name = "all",
    tests = [":reviewbench_law"],
)
