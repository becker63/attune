@@ -0,0 +1,167 @@
+load("//platform/build:native.bzl", "native_flix_java_test", "native_flix_reject_test", "native_flix_test")
+
+package(default_visibility = ["//visibility:public"])
+
+# This package's contribution to the declared authored-source population.
+filegroup(
+    name = "policy_files",
+    srcs = glob(["**"]),
+)
+
+# The test-only proposal namespace. P01-P10 live here, one small typed contract
+# per file: a question and ASCII explanation, the smallest relevant signature,
+# a visible positive fixture, a counterexample and the enforcement note. The
+# approved policy admits and counts this exact prefix (`test/proposals/`), so
+# proposal source is reported separately from ordinary test code.
+
+# P01: exact world/domain/frontier identity. Reordering one set preserves
+# identity; equal-sized unequal sets, equal basenames, another world and another
+# domain stay distinct. Executed fixture.
+native_flix_test(
+    name = "p01_identity_test",
+    srcs = [
+        "P01Identity.flix",
+        "//src:Attune.flix",
+        "//src:Attune/AsciiTree.flix",
+        "//src:Attune/Envelope.flix",
+        "//src:Attune/View.flix",
+    ],
+)
+
+# P02: typed composition. A legal Files -> defines -> Symbols -> defined_in ->
+# Files walk succeeds, a typed empty continuation keeps its domain, and
+# Symbols -> imports rejects at runtime. Executed fixture.
+native_flix_test(
+    name = "p02_composition_test",
+    srcs = [
+        "P02Composition.flix",
+        "//src:Attune.flix",
+        "//src:Attune/AsciiTree.flix",
+        "//src:Attune/Envelope.flix",
+        "//src:Attune/View.flix",
+    ],
+)
+
+# P03: transition identity and execution evidence. Two authored routes share an
+# exact final key, EMPTY+REUSE is representable, and equal-output/unequal-input,
+# missing-producer and cross-world reuse all reject at runtime. Executed fixture.
+native_flix_test(
+    name = "p03_evidence_test",
+    srcs = [
+        "P03Evidence.flix",
+        "//src:Attune.flix",
+        "//src:Attune/AsciiTree.flix",
+        "//src:Attune/Envelope.flix",
+        "//src:Attune/View.flix",
+    ],
+)
+
+# P04: scoped observations and completeness. Match, complete no-match, unknown
+# and failure stay four distinct outcomes; a foreign similarly named file cannot
+# donate a witness and missing evidence stays unknown. Executed fixture.
+native_flix_test(
+    name = "p04_completeness_test",
+    srcs = [
+        "P04Completeness.flix",
+        "//src:Attune.flix",
+        "//src:Attune/AsciiTree.flix",
+        "//src:Attune/Envelope.flix",
+        "//src:Attune/View.flix",
+    ],
+)
+
+# P05: native first-class Datalog composition. A parameterized fragment joins a
+# second fragment on a shared scope/center role, rule-set union is not
+# conjunction of answers, and an explicit candidate id isolates two candidates.
+# Executed fixture.
+native_flix_test(
+    name = "p05_datalog_test",
+    srcs = [
+        "P05Datalog.flix",
+        "//src:Attune.flix",
+    ],
+)
+
+# P06: finite canonical descriptors. The alpha-normal identity preserves a
+# consistent renaming and breaks on inequality, direction and output-role
+# changes; safe outputs and bounded role slots are validated. Executed fixture.
+native_flix_test(
+    name = "p06_descriptors_test",
+    srcs = [
+        "P06Descriptors.flix",
+        "//src:Attune.flix",
+        "//src:Attune/Envelope.flix",
+    ],
+)
+
+# P07: evidence guards, support and witnesses. Two distinct observed entities
+# support two branches, two proof paths to one entity are one supporter, a
+# foreign scope cannot meet a sealed threshold, and proposed evidence stays
+# distinct from observed. Executed fixture.
+native_flix_test(
+    name = "p07_guards_test",
+    srcs = [
+        "P07Guards.flix",
+        "//src:Attune.flix",
+        "//src:Attune/AsciiTree.flix",
+        "//src:Attune/Envelope.flix",
+        "//src:Attune/View.flix",
+    ],
+)
+
+# P08: prior and decision contracts. The approved LangChain4j seam is driven by
+# a recorded fake transport; a decoded in-budget decision is chosen, a classified
+# failure stays a failure, and over-budget/unknown requests take the declared
+# fallback. No provider is contacted. Executed fixture.
+native_flix_java_test(
+    name = "p08_decisions_test",
+    srcs = [
+        "P08Decisions.flix",
+        "//test/seam:Seam.flix",
+    ],
+    java_deps = ["//test/seam:attune_inference"],
