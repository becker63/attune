load("//build:flix.bzl", "flix_fatjar", "isolated_jvm_test")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population. The
# authored negative-fixture payloads are excluded: they deliberately contain
# forbidden content, so they are never part of the declared population.
filegroup(
    name = "policy_files",
    srcs = glob(
        ["**"],
        exclude = ["fixtures/**"],
    ),
)

# Authored negative-fixture payloads. They deliberately contain forbidden
# content, so they are excluded from the declared source population and from the
# live audit; only the case runner reads them.
filegroup(
    name = "fixture_payloads",
    srcs = glob(["fixtures/payloads/**"]),
)

# The compiled counting-law fixture: it imports the policy's pure counting
# functions and executes its assertions under the isolated runtime boundary.
flix_fatjar(
    name = "count_law_jar",
    srcs = [
        "CountLaw.flix",
        "//src:policy",
    ],
)

isolated_jvm_test(
    name = "count_law_test",
    jar = ":count_law_jar",
)

# The named policy cases. Each one materialises an authored workspace, runs the
# real policy evaluation through the minimal Java boundary, and requires the
# exact verdict and rule identifier.
java_test(
    name = "policy_cases_test",
    size = "small",
    srcs = ["PolicyCases.java"],
    data = [
        ":fixture_payloads",
        "fixtures/payloads/deploy.sh.txt",
        "//tools/policy:policy_jar",
    ],
    jvm_flags = [
        "-Dattune.policy.jar=$(rlocationpath //tools/policy:policy_jar)",
        "-Dattune.fixtures=$(rlocationpath fixtures/payloads/deploy.sh.txt)",
    ],
    main_class = "attune.tools.policy.PolicyCases",
    use_testrunner = False,
    deps = ["//tools/policy:policy_java"],
)
