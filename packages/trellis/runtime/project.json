{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "framework-runtime",
  "projectType": "library",
  "root": "packages/trellis/runtime",
  "sourceRoot": "packages/trellis/runtime/src",
  "targets": {
    "typecheck": {
      "executor": "@attune/nx:toolchain",
