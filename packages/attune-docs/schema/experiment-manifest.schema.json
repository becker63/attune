  "required": [
    "experiment_id",
    "campaign_id",
    "title",
    "research_questions",
    "source_revision",
    "benchmark_pack_digest",
    "evaluator_digest",
    "arms",
    "cases",
    "runs",
    "aggregates",
    "comparisons"
  ],
  "title": "Manifest",
  "type": "object"
}
