load("@rules_java//java:defs.bzl", "java_binary")
load("//platform/build:native.bzl", "native_flix_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

java_binary(
    name = "grit_probe",
    srcs = ["GritProbe.java"],
    data = ["//platform/support/grit:attune_grit_abi"],
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    main_class = "attune.test.GritProbe",
    deps = ["//platform/tools/grit:attune_grit"],
)

native_flix_test(
    name = "studio_law_test",
    srcs = [
        "StudioLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Effects.flix",
        "//src:Attune/Repository.flix",
        "//src:Attune/Repository/Grit.flix",
        "//src:Attune/Studio.flix",
        "//src:Attune/Theory.flix",
    ],
    java_deps = ["//platform/tools/grit:attune_grit"],
)
