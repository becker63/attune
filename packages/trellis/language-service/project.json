{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "framework-language-service",
  "projectType": "library",
  "root": "packages/trellis/language-service",
  "sourceRoot": "packages/trellis/language-service/src",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/trellis/language-service && pnpm exec tsc --noEmit -p tsconfig.json"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "typecheck",
          "action": "typecheck",
          "recipeId": "framework-language-service.typecheck",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "cd packages/trellis/language-service && pnpm exec tsc -p tsconfig.json"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "build",
          "action": "build",
          "recipeId": "framework-language-service.build",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/trellis/language-service && pnpm exec vitest run"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "test",
          "action": "test",
          "recipeId": "framework-language-service.test",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Project check surface for Trellis language-service CLI diagnostics.",
        "attune": {
          "tier": "public",
          "surface": "check",
          "recipeId": "trellis-language-service.check-summary-projection",
          "action": "check",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec nx run workspace:recipe-substrate-check"
      }
    },
    "repair": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Project repair surface for safe Trellis language-service repair materialization.",
        "attune": {
          "tier": "public",
          "surface": "repair",
          "safeOnly": true,
          "recipeId": "trellis-language-service.repair-plan",
          "action": "repair",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec nx run workspace:repair"
      }
    }
  },
  "tags": [
    "scope:framework",
    "attune:framework",
    "attune:internal"
  ]
}
