{
  "name": "attune-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Local stdio MCP suite for reproducible Attune investigations.",
  "bin": {
    "attune-mcp": "./dist/main.mjs"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "loc:check": "node ./scripts/check-loc.mjs",
    "schema:check": "pnpm run build && node ./scripts/generate-contract-schemas.mjs --check",
    "schema:snapshot": "pnpm run build && node ./scripts/generate-contract-schemas.mjs",
    "smoke": "node dist/main.mjs --smoke",
    "stdio:check": "node ./scripts/check-stdio.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm run loc:check && tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "effect": "4.0.0-beta.101",
    "fast-check": "4.9.0",
    "joern-effect": "workspace:*",
    "yaml": "2.9.0"
  },
  "nx": {
    "tags": [
      "type:application",
      "scope:attune",
      "platform:node"
    ],
    "targets": {
      "smoke": {
        "dependsOn": [
          "build",
          "^build"
        ]
      },
      "stdio:check": {
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "dependsOn": [
          "build",
          "^build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
