{
  "name": "attune-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic source-backed API reference for Attune.",
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@effect/tsgo": "0.24.3",
    "@microsoft/tsdoc": "0.16.0",
    "@microsoft/tsdoc-config": "0.18.1",
    "@playwright/test": "1.62.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "mdast-util-to-hast": "13.2.1",
    "ogl": "1.0.11",
    "rehype-document": "7.0.3",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "rolldown": "1.2.0",
    "shiki": "4.3.1",
    "ts-morph": "28.0.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unified-lint-rule": "3.0.1",
    "unist-util-visit": "5.0.0",
    "vfile": "6.0.3",
    "vitest": "4.1.10",
    "vscode-jsonrpc": "8.2.1"
  },
  "nx": {
    "implicitDependencies": [
      "attune-guide",
      "attune-mcp",
      "joern-effect"
    ],
    "tags": [
      "type:documentation",
      "scope:attune",
      "platform:node"
    ],
    "targets": {
      "build": {
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "attune-guide"
            ],
            "target": "typecheck"
          },
          {
            "projects": [
              "attune-guide"
            ],
            "target": "test"
          },
          {
            "projects": [
              "attune"
            ],
            "target": "lint"
          },
          {
            "projects": [
              "attune-mcp"
            ],
            "target": "build"
          },
          {
            "projects": [
              "joern-effect"
            ],
            "target": "build"
          },
          {
            "projects": [
              "joern-effect"
            ],
            "target": "generated-check"
          }
        ],
        "command": "node --experimental-strip-types ./packages/attune-docs/src/main.ts && pnpm exec vitest run tooling/oxlint/attune.test.ts && pnpm --filter attune-docs test && pnpm --filter attune-docs test:e2e",
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tooling/oxlint/attune.test.ts",
          "{workspaceRoot}/tooling/oxlint/fixtures/**/*",
          "{projectRoot}/src/tree.ts",
          "{projectRoot}/tsconfig.browser.json",
          "{projectRoot}/vitest.config.ts",
          "{projectRoot}/test/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
