load("//platform/build:embedding.bzl", "attune_embedding_code_fixtures", "attune_embedding_fixture", "attune_embedding_task_list")
load("//platform/build:native.bzl", "native_flix_test", "native_study_stage")
load("//test/embedding:world_sources.bzl", "WORLD_SOURCES")
load("//test/localization_runtime:localization_runtime.bzl", "RUNTIME_CAPPED_EXCLUSIONS")
load("//test/study:manifest/localization/mapped.bzl", "LOCALIZATION_ANALYSIS")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The one frozen model/recipe identity the whole E branch shares. A change here
# is a declared input change and therefore a full-family regeneration.
MODEL_REVISION = "3c4b60807d71f79b43f3c4363786d9493691f8b1"

RECIPE = "coderankembed-queryprefix-cls-ctx8192-right-longestfirst-unnormalized-cosine-v1"

QUERY_PREFIX = "Represent this query for searching relevant code: "

MAX_LENGTH = 8192

_EXCLUDED_GROUPS = [entry["group"] for entry in RUNTIME_CAPPED_EXCLUSIONS]

# The surviving tasks of the frozen runtime-capped cohort, derived from the same
# admitted manifest the cohort macro consumes so the query population cannot
# drift from the deterministic result it extends.
_SURVIVING_TASKS = [
    row[1]
    for row in LOCALIZATION_ANALYSIS
    if len(row) > 3 and row[0] == "task" and row[2] not in _EXCLUDED_GROUPS
]

# The tiny REAL remote compatibility probe (`VAL-EMBED-001`): two fixed declared
# inputs — one query carrying the exact documented prefix and one short code
# snippet — through the pinned stack on BuildBuddy RBE. It verifies only that the
# pinned stack loads and emits finite 768-dim vectors under the declared recipe;
# there is no parity engine and no reference-run threshold. It is `manual`, so
# the ordinary `bazel test //...` gate never runs inference.
attune_embedding_fixture(
    name = "probe",
    adapter = "//platform/tools/embedding:adapter.py",
    keys = [
        "probe-query",
        "probe-code",
    ],
    max_length = MAX_LENGTH,
    model = "@attune_embedding_model//:model",
    model_revision = MODEL_REVISION,
    paths = [
        "probe/query.txt",
        "probe/code.txt",
    ],
    query_prefix = QUERY_PREFIX,
    recipe = RECIPE,
    runtime = "@attune_embedding_runtime//:site_packages",
    runtime_marker = "@attune_embedding_runtime//:site-packages/attune-runtime.marker",
    sides = [
        "query",
        "code",
    ],
    tags = ["manual"],
    texts = [
        "probe/query.txt",
        "probe/code.txt",
    ],
)

# The declared surviving-task list the query stage reads. It is derived from the
# admitted manifest, never hand-authored, so the two cannot drift.
attune_embedding_task_list(
    name = "surviving_tasks",
    tags = ["manual"],
    tasks = _SURVIVING_TASKS,
)

# The Study-owned query stage: it reduces the admitted public issue text of each
# surviving task into one raw file plus the declared rows manifest. No model, no
# provider and no evaluator artifact is touched here.
native_study_stage(
    name = "query_prepare",
    srcs = ["EmbeddingStages.flix"],
    input_names = [
        "issues",
        "tasks",
    ],
    inputs = [
        "//test/localization:issue_text",
        ":surviving_tasks",
    ],
    stage = "query_prepare",
    tags = ["manual"],
)

# The 88 public query rows (`VAL-EMBED-002`): one declared query per surviving
# task, carrying the documented prefix (applied by the adapter on queries only).
attune_embedding_fixture(
    name = "queries",
    adapter = "//platform/tools/embedding:adapter.py",
    max_length = MAX_LENGTH,
    model = "@attune_embedding_model//:model",
    model_revision = MODEL_REVISION,
    query_prefix = QUERY_PREFIX,
    recipe = RECIPE,
    rows_name = "rows.tsv",
    rows_tree = ":query_prepare",
    runtime = "@attune_embedding_runtime//:site_packages",
    runtime_marker = "@attune_embedding_runtime//:site-packages/attune-runtime.marker",
    tags = ["manual"],
)

# The changed-batch replay stage (`VAL-EMBED-005`): the same 88 declared query
# rows plus exactly one new declared row, so the memo law can be exercised
# without touching the corpus or the model.
native_study_stage(
    name = "query_prepare_extended",
    srcs = ["EmbeddingStages.flix"],
    input_names = [
        "issues",
        "tasks",
        "extra",
    ],
    inputs = [
        "//test/localization:issue_text",
        ":surviving_tasks",
        "probe/query.txt",
    ],
    stage = "query_prepare_extended",
    tags = ["manual"],
)

# The exact-target warm rerun (`VAL-EMBED-002`): an identical second request for
# the same declared fixture. Bazel serves it from the action cache, so it
# executes no embedding inference at all.
alias(
    name = "queries_warm",
    actual = ":queries",
    tags = ["manual"],
)

# The logical-row memo (`VAL-EMBED-005`): the changed batch above is produced
# with the previous fixture declared as an explicit immutable prior input. The
# 88 unchanged logical rows are copied verbatim; only the one new row is
# inferred. The physical action still runs, so the logical-row memo and the
# physical action stay distinguished, and there is no hidden mutable cache.
attune_embedding_fixture(
    name = "queries_memoized",
    adapter = "//platform/tools/embedding:adapter.py",
    max_length = MAX_LENGTH,
    model = "@attune_embedding_model//:model",
    model_revision = MODEL_REVISION,
    prior = [":queries"],
    query_prefix = QUERY_PREFIX,
    recipe = RECIPE,
    rows_name = "rows.tsv",
    rows_tree = ":query_prepare_extended",
    runtime = "@attune_embedding_runtime//:site_packages",
    runtime_marker = "@attune_embedding_runtime//:site-packages/attune-runtime.marker",
    tags = ["manual"],
)

# The task-independent code rows (`VAL-EMBED-002`): per exact world-file path and
# source bytes, one shard target per declared 32-file slice of each surviving
# world's frozen candidate inventory. Every shard is analysis-visible; no nested
# Bazel or runtime target discovery exists. Only the shard's own 32 declared
# files are action inputs, so a source change regenerates only the shard that
# carries it, plus the world/task ranking consumers of that world.
attune_embedding_code_fixtures(
    name = "code",
    adapter = "//platform/tools/embedding:adapter.py",
    max_length = MAX_LENGTH,
    model = "@attune_embedding_model//:model",
    model_revision = MODEL_REVISION,
    query_prefix = QUERY_PREFIX,
    recipe = RECIPE,
    runtime = "@attune_embedding_runtime//:site_packages",
    runtime_marker = "@attune_embedding_runtime//:site-packages/attune-runtime.marker",
    shard_size = 32,
    tags = ["manual"],
    world_repo = "@attune_worlds",
    world_sources = WORLD_SOURCES,
)

# The code-shard memo (`VAL-EMBED-005`): one representative shard re-declared
# with its own previous fixture as an explicit prior input. Every logical row of
# the shard is reused verbatim, so a code-changed shard never re-infers the rows
# whose exact bytes are unchanged.
attune_embedding_fixture(
    name = "code_w51_0_replay",
    adapter = "//platform/tools/embedding:adapter.py",
    keys = WORLD_SOURCES["w51"][:32],
    max_length = MAX_LENGTH,
    model = "@attune_embedding_model//:model",
    model_revision = MODEL_REVISION,
    paths = WORLD_SOURCES["w51"][:32],
    prior = [":code_w51_0"],
    query_prefix = QUERY_PREFIX,
    recipe = RECIPE,
    runtime = "@attune_embedding_runtime//:site_packages",
    runtime_marker = "@attune_embedding_runtime//:site-packages/attune-runtime.marker",
    sides = ["code" for _ in WORLD_SOURCES["w51"][:32]],
    tags = ["manual"],
    texts = ["@attune_worlds//:w51"],
    world = "w51",
)

# The corpus-free memo/invalidation law (`VAL-EMBED-005`): it pins the logical
# key semantics over declared identities only, so it is pure and the ordinary
# offline gate runs it. It touches no corpus, model byte or provider.
native_flix_test(
    name = "embedding_law",
    srcs = ["EmbeddingLaw.flix"],
)
