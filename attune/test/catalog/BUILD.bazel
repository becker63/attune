load("//platform/build:native.bzl", "native_flix_consumer_test", "native_flix_test", "native_study_stage")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The shared semantic owners every catalog law compiles. The dispatcher is a thin
# adapter: the pinned-identity and physical-schema contract it reduces lives in
# `Attune.Study`, and the unavoidable Arrow codec work lives in the mechanical
# `//platform/tools/parquet` seam.
STAGE_SRCS = [
    "CatalogAcquire.flix",
    "//src:Attune.flix",
    "//src:Attune/Study.flix",
]

# The declared catalog acquisition stage (`VAL-DATA-001`): it streams the pinned
# public Parquet through the projected/batched Arrow boundary, records the exact
# bytes and the physical schema the codec observed, and reduces them against the
# declared identity and schema. The pinned artifact is the immutable revision the
# module's acquisition URL names.
#
# The target is `manual` on purpose, like every other study surface: the ordinary
# `bazel test //...` gate must never acquire or scan the 428,839,266-byte corpus.
native_study_stage(
    name = "catalog_acquire",
    srcs = STAGE_SRCS,
    input_names = [
        "catalog",
        "pin",
        "schema",
    ],
    inputs = [
        "@swe_rebench_v2_catalog//file:file",
        "catalog_pin.tsv",
        "catalog_schema.tsv",
    ],
    java_deps = ["//platform/tools/parquet:attune_parquet"],
    stage = "catalog",
    tags = ["manual"],
)

# The declared acquisition-artifact laws: they consume the tree the stage
# materialized and assert the declared identity, the recorded physical schema and
# the streamed projection, then exercise the same production comparison in the
# negative direction. Manual for the same reason: `//...` never touches them.
native_flix_consumer_test(
    name = "catalog_pin_test",
    srcs = [
        "CatalogPinLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Study.flix",
    ],
    declared_files = [
        "catalog_pin.tsv",
        "catalog_schema.tsv",
    ],
    produced = [":catalog_acquire"],
    tags = ["manual"],
)

# The declared shared-panel selection stage (`VAL-DATA-003`): it reads the
# normalized accepted js/ts population the streaming-normalization stage
# materialized and reduces the one bounded, deterministic, metadata-only shared
# panel in `Attune.Study` — canonical fork/duplicate grouping, the frozen group
# order, the declared group/task/pair caps, the largest-remainder approximately
# 60/20/20 group split, the exact worlds, the ordered pair candidates, the
# exposure flags and the classified image pins. It writes the public panel
# manifest, the physically separate evaluator scope and the loadable Starlark
# list the integration owner admits before the study invocation. Manual like
# every study surface: the ordinary `bazel test //...` gate never scans the
# corpus.
native_study_stage(
    name = "panel_select",
    srcs = [
        "PanelSelect.flix",
        "//src:Attune.flix",
        "//src:Attune/Study.flix",
    ],
    input_names = ["normalized"],
    inputs = [":catalog_normalize"],
    stage = "select_panel",
    tags = ["manual"],
)

# The declared shared-panel artifact laws: they audit the tree the selection
# stage materialized over the real normalized corpus, so the real run's bounds,
# split, pair membership and image classification are checked against the actual
# selected panel rather than against a fixture.
native_flix_consumer_test(
    name = "panel_artifact_test",
    srcs = [
        "PanelArtifactLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Study.flix",
    ],
    declared_files = [
        "//test/study:manifest/catalog/panel_public.tsv",
        "//test/study:manifest/catalog/manifest.bzl",
    ],
    produced = [":panel_select"],
    tags = ["manual"],
)

test_suite(
    name = "all",
    tags = ["manual"],
    tests = [
        ":catalog_normalize_law",
        ":catalog_normalize_test",
        ":catalog_pin_test",
        ":panel_artifact_test",
        ":panel_law",
    ],
)

# The declared streaming-normalization stage (`VAL-DATA-002`): it re-verifies the
# exact bytes and the recorded physical schema of the same immutable pinned
# catalog, then streams the whole catalog through the mechanical projected/batched
# Arrow boundary one bounded batch at a time and reduces every row's fate in
# `Attune.Study`. It writes the audited denominators, the accepted js/ts
# population, the classified exclusions and failures, the retained dataset and
# repository provenance and the declared public/oracle separation. Manual like
# every study surface: the ordinary `bazel test //...` gate never scans the
# 428,839,266-byte corpus.
native_study_stage(
    name = "catalog_normalize",
    srcs = [
        "CatalogNormalize.flix",
        "//src:Attune.flix",
        "//src:Attune/Study.flix",
    ],
    input_names = [
        "catalog",
        "pin",
        "schema",
    ],
    inputs = [
        "@swe_rebench_v2_catalog//file:file",
        "catalog_pin.tsv",
        "catalog_schema.tsv",
    ],
    java_deps = ["//platform/tools/parquet:attune_parquet"],
    stage = "catalog_normalize",
    tags = ["manual"],
)

# The corpus-free normalization laws: they drive the production separation,
# framing/fate, license-evidence and denominator functions over crafted records,
# so they need no corpus and no Arrow seam.
native_flix_test(
    name = "catalog_normalize_law",
    srcs = [
        "NormalizeLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Study.flix",
    ],
    tags = ["manual"],
)

# The corpus-free bounded shared-panel laws (`VAL-DATA-003`): they drive the
# production canonical grouping, frozen group order, declared caps, the
# largest-remainder approximately 60/20/20 split, the ordered pair candidates,
# the exposure flag, the classified image pin, the explicit attrition and the
# public/evaluator separation over a crafted population, so no corpus is read
# here and the real run's clean finding set is meaningful rather than vacuous.
native_flix_test(
    name = "panel_law",
    srcs = [
        "PanelLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Study.flix",
    ],
    tags = ["manual"],
)

# The declared normalization-artifact laws: they audit the tree the stage
# materialized over the real pinned corpus.
native_flix_consumer_test(
    name = "catalog_normalize_test",
    srcs = [
        "NormalizeArtifactLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Study.flix",
    ],
    declared_files = [
        "catalog_pin.tsv",
        "catalog_schema.tsv",
    ],
    produced = [":catalog_normalize"],
    tags = ["manual"],
)
