+    /// Persisted origin inode numbers are local to one HostFS session. A
+    /// different lookup order after remount must not alias an unrelated base
+    /// directory with a copied-up directory such as `.git`.
+    #[tokio::test]
+    async fn test_overlay_remount_rejects_stale_origin_inode_collision() -> Result<()> {
+        let base_dir = tempdir()?;
+        std::fs::create_dir(base_dir.path().join(".git"))?;
+        std::fs::write(base_dir.path().join(".git/HEAD"), b"ref: refs/heads/main\n")?;
+        std::fs::create_dir(base_dir.path().join("modules"))?;
+        std::fs::create_dir(base_dir.path().join("modules/refund-policy"))?;
+
+        let delta_dir = tempdir()?;
+        let db_path = delta_dir.path().join("delta.db");
+
+        // Session 1: `.git` receives the first HostFS inode and is copied up.
+        let base = Arc::new(HostFS::new(base_dir.path())?);
+        let delta = AgentFS::new(db_path.to_str().unwrap()).await?;
+        let overlay = OverlayFS::new(base, delta);
+        overlay.init(base_dir.path().to_str().unwrap()).await?;
+
+        let git = overlay.lookup(ROOT_INO, ".git").await?.unwrap();
+        let (_lock_stats, lock) = overlay
+            .create_file(git.ino, "index.lock", DEFAULT_FILE_MODE, 0, 0)
+            .await?;
+        lock.pwrite(0, b"lock").await?;
+        drop(lock);
+        drop(overlay);
+
+        // Session 2: force `modules` to receive the same session-local HostFS
+        // inode that `.git` had in session 1, then merge base and delta entries.
+        let base = Arc::new(HostFS::new(base_dir.path())?);
+        let delta = AgentFS::new(db_path.to_str().unwrap()).await?;
+        let overlay = OverlayFS::new(base, delta);
+        overlay.init(base_dir.path().to_str().unwrap()).await?;
+
+        let modules_lookup = overlay.lookup(ROOT_INO, "modules").await?.unwrap();
+        let entries = overlay.readdir_plus(ROOT_INO).await?.unwrap();
+        let git = entries.iter().find(|entry| entry.name == ".git").unwrap();
+        let modules = entries
+            .iter()
+            .find(|entry| entry.name == "modules")
+            .unwrap();
+
+        assert_eq!(modules.stats.ino, modules_lookup.ino);
+        assert_ne!(
+            git.stats.ino, modules.stats.ino,
+            "copied-up .git and base modules must remain distinct after remount"
+        );
+        assert!(
+            overlay.lookup(git.stats.ino, "HEAD").await?.is_some(),
+            ".git must still resolve its own base entries"
+        );
+        assert!(
+            overlay
+                .lookup(modules.stats.ino, "refund-policy")
+                .await?
+                .is_some(),
+            "modules must not resolve through the copied-up .git inode"
+        );
+
+        Ok(())
+    }
+
