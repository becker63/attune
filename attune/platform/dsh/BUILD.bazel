load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@dsh_npm//:defs.bzl", "npm_link_all_packages")
load("//platform/build:native.bzl", "native_study_stage")
load("//platform/dsh:typert_package.bzl", "typert_package")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "policy_files",
    srcs = glob(
        ["**"],
        exclude = [
            "package-lock.json",
            "pnpm-lock.yaml",
        ],
    ),
)

npm_link_all_packages(name = "node_modules")

npm_link_package(
    name = "node_modules/@attune/dsh-evidence-tool",
    src = "//platform/dsh/tool:evidence_tool_package",
    package = "@attune/dsh-evidence-tool",
    root_package = "platform/dsh",
    version = "0.0.0",
)

native_study_stage(
    name = "evidence_operation_projection",
    srcs = ["//test/study:evidence_operation_stage_srcs"],
    input_names = [
        "facts",
        "manifest",
        "source",
        "world",
    ],
    inputs = [
        "//platform/dsh/tool:fixtures/facts.tsv",
        "//platform/dsh/tool:fixtures/boundary-world.tsv",
        "//platform/dsh/tool:fixtures/source/shop.ts",
        "//platform/dsh/tool:fixtures/world.tsv",
    ],
    stage = "evidence_operation",
)

filegroup(
    name = "typert_fixture",
    srcs = [
        "typert/bridge.mjs",
        "typert/contract.wire.v2.json",
        "typert/contract-surface.v2.txt",
        "typert/packages/attune-evidence/package.json",
        "typert/packages/attune-evidence/src/index.ts",
        "typert/packages/attune-evidence/tsconfig.json",
        "typert/tsconfig.host.json",
    ],
)

js_library(
    name = "typert_bridge",
    srcs = [
        "typert/bridge.mjs",
        "typert/contract.wire.v2.json",
    ],
)

js_test(
    name = "typert_generation_test",
    data = [
        ":node_modules",
        ":typert_fixture",
    ],
    entry_point = "typert/typert_generation_test.mjs",
)

_TYPERT_PACKAGE_SRCS = [
    "typert/packages/attune-evidence/package.json",
    "typert/packages/attune-evidence/src/index.ts",
    "typert/packages/attune-evidence/tsconfig.json",
    "typert/tsconfig.host.json",
]

filegroup(
    name = "typert_install",
    srcs = [
        "typert/install/cordis.patch.yml",
        "typert/install/entry.d.ts",
        "typert/install/entry.mjs",
        "typert/install/manifest.json",
    ],
)

js_binary(
    name = "typert_build",
    data = [
        "typert/bridge.mjs",
        ":node_modules",
    ],
    entry_point = "typert/package_build.mjs",
    tags = ["manual"],
)

typert_package(
    name = "typert_package_a",
    srcs = _TYPERT_PACKAGE_SRCS,
    install = [":typert_install"],
    manifest = "typert/install/manifest.json",
    tsconfig = "typert/tsconfig.host.json",
)

typert_package(
    name = "typert_package_b",
    srcs = _TYPERT_PACKAGE_SRCS,
    install = [":typert_install"],
    manifest = "typert/install/manifest.json",
    tsconfig = "typert/tsconfig.host.json",
)

js_test(
    name = "typert_package_test",
    data = [
        ":node_modules",
        ":typert_fixture",
        ":typert_install",
        ":typert_package_a",
        ":typert_package_b",
    ],
    entry_point = "typert/package_test.mjs",
)
