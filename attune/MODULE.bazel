# file is admitted
# through a `file://` URL that must match its declared SHA-256. Declared last for
# the same anonymous-repo renumbering reason as the catalog, world archives and
# embedding runtime above.
qwen_fixtures = use_repo_rule("//platform/build:qwen_fixtures.bzl", "attune_qwen_fixtures")

qwen_fixtures(
    name = "attune_qwen_fixtures",
    manifest = "//test/localization_qwen:fixture-manifest.tsv",
    root = "/home/becker/.cache/attune-qwen-fixtures",
    token = "1",
)

# The ReviewBench paired study's hosted-Qwen (Q) assisted-context fixtures
# (`VAL-REVIEW-002`, owner-authorized 2026-10-08). Same one route, same frozen
# recipe and the same host-acquisition boundary as the localization Q branch: the
