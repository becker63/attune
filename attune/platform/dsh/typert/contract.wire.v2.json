{
  "contract": "attune.evidence-substrate/2",
  "dialect": "attune.wire/1",
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "world": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "startLine": {
          "type": "number"
        },
        "endLine": {
          "type": "number"
        },
        "bytes": {
          "type": "number"
        },
        "delivery": {
          "enum": [
            "complete",
            "partial",
            "overflow",
            "unsupported"
          ]
        }
      },
      "required": [
        "world",
        "revision",
        "path",
        "sha256",
        "startLine",
        "endLine",
        "bytes",
        "delivery"
      ],
      "additionalProperties": false
    },
    "EvidenceObservation": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "WITNESS",
            "NO-MATCH",
            "UNKNOWN",
            "FAILED"
          ]
        },
        "ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "provenance": {
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "ref",
        "provenance"
      ],
      "additionalProperties": false
    }
  }
}
