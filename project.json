{
  "name": "workspace",
  "root": ".",
  "targets": {
    "check": {
      "executor": "@attune/nx:toolchain",
      "options": {
        "tool": "workspace",
        "action": "check",
        "toolId": "nx-targets",
        "parameters": {
          "targets": [
            "workspace:policy-fast"
          ]
        },
        "dryRun": false
      }
    },
    "tool-versions": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Print pinned Nix/Nx tool versions used by active workspace targets."
      },
      "options": {
        "tool": "architecture",
        "action": "check",
        "toolId": "tool-versions",
        "parameters": {
          "recipeId": "attune-architecture.tool-version-audit"
        },
        "dryRun": false
      }
    },
    "recipe-substrate-check": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Focused diagnostic target for Recipe/ManagedRecipe declarations, package DB emission readiness, generator derivation recipes, and framework policy.",
        "attune": {
          "runtimeChecks": [
            "recipe-registry",
            "managed-recipe-lifecycle",
            "nx-target-projection-conformance",
            "package-db-emission",
            "recipe-diagnostics",
            "recipe-repairs",
            "import-boundary",
            "local-cache",
            "no-checked-in-report",
            "no-compat-scripts"
          ],
          "readModel": "RecipeDbEmissionView",
          "projectionRegistry": "ProjectionRegistry"
        }
      },
      "options": {
        "tool": "workspace",
        "action": "check",
        "toolId": "nx-targets",
        "parameters": {
          "targets": [
            "framework-protocol:test",
            "framework-runtime:test",
            "framework-nx:test",
            "framework-language-service:test",
            "attune-architecture:test",
            "workspace:framework-policy-check",
            "workspace:no-compat-script-check"
          ]
        },
        "timeoutSeconds": 240,
        "dryRun": false
      }
    },
    "atom-graph-conformance": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Cheap deterministic package atom/Reactivity graph conformance diagnostics."
      },
      "options": {
        "tool": "architecture",
        "action": "check",
        "toolId": "framework-policy",
        "parameters": {
          "only": "atom-graph"
        },
        "dryRun": false
      }
    },
    "property-evidence": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Cheap deterministic property evidence and worker target metadata diagnostics."
      },
      "options": {
        "tool": "architecture",
        "action": "check",
        "toolId": "framework-policy",
        "parameters": {
          "only": "property-evidence"
        },
        "dryRun": false
      }
    },
    "coverage-conformance": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Cheap deterministic package coverage guidance conformance diagnostics."
      },
      "options": {
        "tool": "architecture",
        "action": "check",
        "toolId": "framework-policy",
        "parameters": {
          "only": "coverage-conformance"
        },
        "dryRun": false
      }
    },
    "framework-policy-check": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Focused framework import-boundary and no checked-in protocol report policy check."
      },
      "options": {
        "tool": "architecture",
        "action": "check",
        "toolId": "framework-policy",
        "parameters": {},
        "dryRun": false
      }
    },
    "no-compat-script-check": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Focused no-compat package-local script file check for migrated Recipe/ManagedRecipe workflow surfaces.",
        "attune": {
          "tier": "public",
          "surface": "check",
          "recipeId": "attune-architecture.no-compat-script-check"
        }
      },
      "options": {
        "tool": "architecture",
        "action": "check",
        "toolId": "framework-policy",
        "parameters": {
          "only": "no-compat-scripts"
        },
        "dryRun": false
      }
    },
    "arch:scan": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Low-level architecture scanner used by workspace policy targets. Public workflows should use workspace:policy-fast, workspace:policy-proof-pressure, or workspace:recipe-substrate-check."
      },
      "options": {
        "tool": "architecture",
        "action": "check",
        "toolId": "scan",
        "parameters": {
          "recipeId": "attune-architecture.workspace-scan"
        },
        "dryRun": false
      }
    },
    "arch:types": {
      "executor": "@attune/nx:toolchain",
      "options": {
        "tool": "architecture",
        "action": "check",
        "toolId": "types",
        "parameters": {
          "recipeId": "attune-architecture.typescript-diagnostics"
        },
        "dryRun": false
      }
    },
    "arch:churn": {
      "executor": "@attune/nx:toolchain",
      "options": {
        "tool": "architecture",
        "action": "check",
        "toolId": "churn",
        "parameters": {
          "recipeId": "attune-architecture.churn-complexity"
        },
        "dryRun": false
      }
    },
    "policy-proof-pressure": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Heavy/manual proof-pressure surface for property, Joern, fuzz, coverage, and architecture campaigns."
      },
      "options": {
        "tool": "workspace",
        "action": "check",
        "toolId": "nx-targets",
        "parameters": {
          "targets": [
            "workspace:recipe-substrate-check",
            "workspace:atom-graph-conformance",
            "workspace:property-evidence",
            "workspace:coverage-conformance",
            "attune-architecture:test",
            "workspace:arch:scan",
            "workspace:arch:types",
            "workspace:arch:churn",
            "effect-oxlint-policy:test",
            "effect-oxlint-policy:build",
            "effect-oxlint-policy:policy",
            "joern-effect-properties:proof",
            "joern-effect-properties:fuzz",
            "attune-pi-agent:proof"
          ]
        },
        "dryRun": false
      }
    },
    "codex-audit-prs": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Internal Codex PR recovery audit. Public completion checks run through workspace:policy-fast.",
        "attune": {
          "tier": "internal",
          "surface": "audit",
          "recipeId": "attune-architecture.pr-recovery-audit"
        }
      },
      "options": {
        "tool": "architecture",
        "action": "check",
        "toolId": "codex-audit-prs",
        "parameters": {
          "recipeId": "attune-architecture.pr-recovery-audit"
        },
        "dryRun": false
      }
    },
    "policy-fast": {
      "executor": "@attune/nx:toolchain",
      "options": {
        "tool": "workspace",
        "action": "check",
        "toolId": "nx-targets",
        "parameters": {
          "targets": [
            "attune-nx:test",
            "workspace:recipe-substrate-check",
            "workspace:atom-graph-conformance",
            "workspace:property-evidence",
            "workspace:coverage-conformance",
            "attune-architecture:test",
            "workspace:arch:scan",
            "workspace:arch:types",
            "workspace:arch:churn",
            "effect-oxlint-policy:test",
            "effect-oxlint-policy:build",
            "effect-oxlint-policy:policy"
          ],
          "graphFile": "/tmp/attune-nx-graph.json",
          "verifyPrCompletion": true,
          "verifyPrCompletionRecipeId": "attune-architecture.pr-completion-audit"
        },
        "timeoutSeconds": 360,
        "dryRun": false
      }
    },
    "test": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Public workspace test surface for the recipe substrate and focused package checks."
      },
      "options": {
        "tool": "workspace",
        "action": "check",
        "toolId": "nx-targets",
        "parameters": {
          "targets": [
            "attune-nx:test",
            "attune-architecture:test",
            "framework-runtime:test",
            "workspace:recipe-substrate-check"
          ]
        },
        "timeoutSeconds": 360,
        "dryRun": false
      }
    },
    "repair": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Public workspace repair surface for deterministic Recipe/ManagedRecipe repair materialization."
      },
      "options": {
        "tool": "architecture",
        "action": "generate",
        "toolId": "recipe-repair",
        "parameters": {
          "allSafe": true
        },
        "dryRun": false
      }
    },
    "db": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Public workspace database surface for the LocalTimescaleManagedRecipe health check."
      },
      "options": {
        "tool": "workspace",
        "action": "check",
        "toolId": "nx-targets",
        "parameters": {
          "targets": [
            "framework-runtime:db:check"
          ]
        },
        "timeoutSeconds": 240,
        "dryRun": false
      }
    },
    "dev": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Public workspace dev surface; currently starts the FoldKit Vite workbench package target."
      },
      "options": {
        "tool": "workspace",
        "action": "check",
        "toolId": "nx-targets",
        "parameters": {
          "targets": [
            "attune-foldkit:dev"
          ]
        },
        "resourceTier": "external",
        "dryRun": false
      }
    }
  }
}
