  "slug": "investigation-lifecycle",
  "title": "Investigation lifecycle",
  "summary": "Read the runtime as three capabilities, eight Toolkit operations, and one terminal transition.",
  "audience": "A contributor changing workspace, execution, receipt, artifact, or finalization behavior.",
  "sections": [
    {
      "id": "capabilities",
      "heading": "Capabilities make legal states visible",
      "claims": [
        {
          "id": "lifecycle.capabilities",
          "text": "The public lifecycle has materialized, active, and finalized capabilities. The service activates materialized work, executes against an active capability, and returns finalized evidence at the terminal transition.",
          "certainty": "direct",
          "evidence": [
            {
              "symbol": "MaterializedInvestigationCapability",
              "facts": ["signature"]
            },
            {
              "symbol": "ActiveInvestigation",
              "facts": ["signature"]
            },
            {
              "symbol": "FinalizedInvestigation",
              "facts": ["signature"]
            },
            {
              "symbol": "InvestigationServiceApi",
              "facts": ["signature"]
            }
          ]
        },
        {
          "id": "lifecycle.snapshot",
          "text": "Operation input remains keyed by the selected Toolkit name, while the service requires an active capability for execution and finalization.",
          "certainty": "inference",
          "evidence": [
            {
              "symbol": "AttuneOperationInput",
              "facts": ["signature"]
            },
            {
              "symbol": "InvestigationServiceApi",
              "facts": ["signature"]
            }
          ]
        }
      ]
    },
    {
      "id": "receipts",
      "heading": "Every accepted invocation becomes terminal evidence",
      "claims": [
        {
          "id": "lifecycle.receipts.union",
          "text": "Each Toolkit name selects its own result, receipt, and recoverable error types. Callers retain that relationship through the service boundary.",
          "certainty": "direct",
          "evidence": [
            {
              "symbol": "AttuneOperationResult",
              "facts": ["signature"]
            },
            {
              "symbol": "AttuneOperationReceipt",
              "facts": ["signature"]
            },
            {
              "symbol": "AttuneOperationError",
              "facts": ["signature"]
            },
            {
              "symbol": "InvestigationServiceApi",
              "facts": ["signature"]
            }
          ]
        },
        {
          "id": "lifecycle.receipts.artifacts",
          "text": "The public failure boundary remains explicit: Toolkit failures are selected by operation name, while lifecycle failures describe invalid service transitions.",
          "certainty": "inference",
          "evidence": [
            {
              "symbol": "AttuneToolFailure",
              "facts": ["signature"]
            },
            {
              "symbol": "InvestigationLifecycleError",
              "facts": ["signature"]
