module(
    name = "attune",
    version = "0.1.0",
)

# The checksummed compiler used by the demo, artifact stages, and native tests.
http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_jar(
    name = "flix_compiler",
    sha256 = "b2ed2b7f49902e2dfe1b4f10e23d9a5cb085461e7e8c64909ca2b3abfa566e74",
    urls = ["https://github.com/flix/flix/releases/download/v0.76.1/flix.jar"],
)

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "platforms", version = "1.1.0")

# Grit uses a pinned Rust toolchain and LLVM linker, including libunwind.
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "llvm", version = "0.8.21")

register_toolchains("@llvm//toolchain:all")

llvm_runtime = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm_runtime, "llvm-project")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.0"],
    extra_target_triples = ["wasm32-unknown-unknown"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# One pinned Grit source tree, extended with the Flix and Starlark grammars.
# The Flix grammar pin also matches the Zed editor assets.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

gritql_repository = use_repo_rule("//platform/build:grit_repository.bzl", "gritql_repository")

gritql_repository(
    name = "gritql_source",
    attune_lib = "//platform/support/grit:lib.rs",
    cargo_lock = "//platform/support/grit:Cargo.lock",
    language_patches = [
        "//platform/support/grit/patches:flix.rs",
        "//platform/support/grit/patches:flix_binding.rs",
        "//platform/support/grit/patches:starlark.rs",
        "//platform/support/grit/patches:starlark_binding.rs",
        "//platform/support/grit/patches:textual_metavariable.rs",
    ],
)

gritql_repository(
    name = "grit_browser_source",
    browser = True,
    attune_lib = "//platform/support/grit:lib.rs",
    cargo_lock = "//platform/browser:grit-Cargo.lock",
    language_patches = [
        "//platform/support/grit/patches:flix.rs",
        "//platform/support/grit/patches:flix_binding.rs",
        "//platform/support/grit/patches:starlark.rs",
        "//platform/support/grit/patches:starlark_binding.rs",
        "//platform/support/grit/patches:textual_metavariable.rs",
    ],
)
crate.from_cargo(
    name = "grit_browser_crates",
    cargo_lockfile = "@grit_browser_source//:Cargo.lock",
    lockfile = "//platform/browser:grit-cargo-bazel-lock.json",
    manifests = ["@grit_browser_source//:Cargo.toml"],
    supported_platform_triples = ["aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu", "wasm32-unknown-unknown"],
)
use_repo(crate, "grit_browser_crates")

crate.from_cargo(
    name = "grit_crates",
    cargo_lockfile = "@gritql_source//:Cargo.lock",
    lockfile = "//platform/support/grit:cargo-bazel-lock.json",
    manifests = ["@gritql_source//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "grit_crates")

# SDK transport. Tests use recorded transport;
# dependency downloads are separate from isolated action execution.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "attune_maven",
    artifacts = [
        "com.fasterxml.jackson.core:jackson-databind:2.22.1",
        "dev.langchain4j:langchain4j-core:1.18.1",
        "dev.langchain4j:langchain4j-http-client:1.18.1",
        "dev.langchain4j:langchain4j-http-client-jdk:1.18.1",
        "dev.langchain4j:langchain4j-open-ai:1.18.1",
        "org.slf4j:slf4j-nop:2.0.18",
    ],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "attune_maven")

# Browser compilation is a separate tool closure; provider SDKs never ship.
maven.install(
    name = "browser_maven",
    artifacts = [
        "org.teavm:teavm-classlib:0.16.0",
        "org.teavm:teavm-tooling:0.16.0",
        "org.teavm:teavm-jso:0.16.0",
    ],
    repositories = ["https://repo.maven.apache.org/maven2"],
    lock_file = "//:browser_maven_install.json",
)
use_repo(maven, "browser_maven")

# Resolve pinned user/network isolation tools from Nix.
local_unshare = use_repo_rule("//platform/build:unshare_repository.bzl", "local_unshare")

local_unshare(name = "unshare")

# The live root workspace path, recorded once so the local read-only audit test
# can re-read the current tree instead of a declared or cached inventory.
local_workspace = use_repo_rule("//platform/build:workspace_root.bzl", "local_workspace")

local_workspace(name = "local_workspace")

# Opt-in remote execution uses an immutable container digest with networking off.
# Default tests run locally.
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.platform(
    container_image = "gcr.io/flame-public/rbe-ubuntu22-04@sha256:0d84a80bb0fc36ba5381942adcf6493249594dcc9044845c617b78c9b621cae3",
)
use_repo(buildbuddy, "buildbuddy_toolchain")

bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.74.0")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "bindgen_arm64",
    urls = ["https://github.com/wasm-bindgen/wasm-bindgen/releases/download/0.2.128/wasm-bindgen-0.2.128-aarch64-unknown-linux-musl.tar.gz"],
    sha256 = "079731dd1bc7798c1efa4f08fcc45130827cbcc9ff60a0b4c6047d64fc6fd25c",
    strip_prefix = "wasm-bindgen-0.2.128-aarch64-unknown-linux-musl",
    build_file_content = 'load("@bazel_skylib//rules:native_binary.bzl", "native_binary")\nnative_binary(name="cli", src="wasm-bindgen", out="bindgen", visibility=["//visibility:public"])',
)
http_archive(
    name = "bindgen_amd64",
    urls = ["https://github.com/wasm-bindgen/wasm-bindgen/releases/download/0.2.128/wasm-bindgen-0.2.128-x86_64-unknown-linux-musl.tar.gz"],
    sha256 = "b51f0208fdff83515a787bd8ab9ac5865ed84dabb66d0c709957bb59793c645f",
    strip_prefix = "wasm-bindgen-0.2.128-x86_64-unknown-linux-musl",
    build_file_content = 'load("@bazel_skylib//rules:native_binary.bzl", "native_binary")\nnative_binary(name="cli", src="wasm-bindgen", out="bindgen", visibility=["//visibility:public"])',
)
register_toolchains("//platform/browser:bindgen_arm64", "//platform/browser:bindgen_amd64")

# Optional, retained science inputs. Ordinary library tests need no corpus.
# Campaign commands override this empty repository with the frozen input bundle.
campaign_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")
campaign_repository(name = "native_campaign_inputs", path = "experiments/native_patterns/data")
