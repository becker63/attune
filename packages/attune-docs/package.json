{
  "name": "attune-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic source-backed API reference for Attune.",
  "type": "module",
  "scripts": {
    "audit": "node --experimental-strip-types ./src/cli.ts audit",
    "build": "pnpm run audit && node --experimental-strip-types ./src/cli.ts build",
    "experiments:verify": "node --experimental-strip-types ./src/cli.ts experiments:verify",
    "manifest": "node --experimental-strip-types ./src/cli.ts manifest",
    "probe:typedoc": "node ./scripts/probe-typedoc.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@attune/twoslash": "workspace:*",
    "@playwright/test": "1.62.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.13.3",
    "happy-dom": "20.11.1",
    "markdown-it": "14.3.0",
    "shiki": "4.3.1",
    "ts-morph": "28.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "nx": {
    "implicitDependencies": [
      "attune-mcp"
    ],
    "tags": [
      "type:documentation",
      "scope:attune",
      "platform:node"
    ],
    "targets": {
      "experiments:verify": {
        "cache": true,
        "dependsOn": [
          {
            "projects": [
              "attune-activegraph"
            ],
            "target": "research:schema"
          }
        ],
        "inputs": [
          "{projectRoot}/content/experiments/**/*",
          "{projectRoot}/schema/experiment-*.schema.json",
          "{projectRoot}/src/static-pages.ts"
        ]
      },
      "build": {
        "cache": false,
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
