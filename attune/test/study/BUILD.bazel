# The declared localization admission laws: the admitted public mapping, coverage
# table and evaluator label artifacts under `manifest/localization/` are
# byte-identical to what the declared label stage emitted, and the admitted label
# population is exactly the mapped task population. The admitted population is
# declared here one file at a time, so the live workspace audit sees the exact
# artifacts rather than a macro default.
native_flix_consumer_test(
    name = "localization_admission_test",
    srcs = [
        "LocalizationAdmissionLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Study.flix",
    ],
    declared_files = LOCALIZATION_ADMITTED,
    produced = [":localization_labels"],
    tags = ["manual"],
)

# The corpus-free localization reference-label laws (`VAL-LOC-001`): they drive
# the exact production reduction the localization stage runs over the real
# admitted panel and the real pinned reference patches — the declared supported
# source extensions, the declared test-path vocabulary, the declared non-regular
# git modes, the git and plain-unified patch-header reduction, the
# rename-to-old-path attribution, the preexisting-inventory requirement, the
# separate full/supported coverage numbers and every declared classified case.
# No corpus, no target code and no dependency is touched here.
native_flix_test(
    name = "localization_law",
    srcs = [
        "LocalizationLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Study.flix",
    ],
    tags = ["manual"],
)

# The declared localization surface (`VAL-LOC-001`): the corpus-free reference
# label laws, the real-panel label stage and its artifact and admission laws. The
# fixture graph's own `all` suite above stays the declared fixture study; this
# suite is the declared way to run the real localization pilot. Manual like every
# study surface, so the ordinary `bazel test //...` gate never fetches or scans
# the pinned corpus.
test_suite(
    name = "localization",
    tags = ["manual"],
    tests = [
        ":localization_admission_test",
        ":localization_artifact_test",
        ":localization_law",
    ],
)

attune_admission_probe(
    name = "admission_probe",
    rows = _PROBE_OVERBOUND,
)

# The production admission predicate over the admitted real mapped localization
# manifest. The mapped rows come from the emitted `mapped.bzl`, so this is the
# real panel's own vocabulary being checked against the same contract the study
# macro enforces: the declared record vocabulary, no admitted `truncated` or
# `exceeded` row, and the panel's own group/per-group task/pair/pair-group
# bounds. It records the violations it finds and fails only under
# `--define=attune_admission_strict=1`, so it can never break the offline gate.
attune_admission_probe(
    name = "localization_admission_probe",
    rows = ["\t".join(row) for row in LOCALIZATION_ANALYSIS],
)

attune_admission_probe(
    name = "admission_probe_truncated",
    rows = _PROBE_TRUNCATED,
)
