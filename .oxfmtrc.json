{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/.nx/**",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "contracts/attune-tools.schema.json",
    "flake.lock",
    "packages/attune-docs/schema/experiment-*.schema.json",
    "packages/effect-joern/schema/**",
    "pnpm-lock.yaml"
  ],
  "jsdoc": {
    "commentLineStrategy": "keep",
    "keepUnparsableExampleIndent": true,
    "lineWrappingStyle": "greedy"
  },
  "overrides": [
    {
      "files": [
        "packages/attune-mcp/src/**/*.ts",
        "packages/attune-mcp/test/**/*.ts"
      ],
      "options": {
        "printWidth": 110
      }
    },
    {
      "files": [
        "oxlint.config.ts",
        "packages/attune-docs/src/docs.ts",
        "packages/attune-docs/src/main.ts",
        "packages/attune-docs/src/read.ts",
        "packages/attune-docs/src/tree.ts",
        "packages/attune-docs/test/tree.test.ts",
        "tooling/oxlint/attune.ts"
      ],
      "options": {
        "printWidth": 120
      }
    },
    {
      "files": [
        "packages/attune-mcp/src/index.ts",
        "tooling/oxlint/fixtures/invalid.ts",
        "tooling/oxlint/fixtures/valid.ts"
      ],
      "options": {
        "jsdoc": false
      }
    }
  ],
  "printWidth": 80,
  "sortImports": true
}
