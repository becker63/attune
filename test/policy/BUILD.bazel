load("//build:native.bzl", "native_flix_audit_test", "native_flix_declared_test", "native_flix_test")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The honest counting laws, executed as native Flix tests against the policy's
# own pure counting functions.
native_flix_test(
    name = "count_law_test",
    srcs = [
        "//src:Attune.flix",
        "//src:Attune/Policy.flix",
        "CountLaw.flix",
    ],
)

# The named policy cases, defined and evaluated in Flix.
native_flix_test(
    name = "policy_cases_test",
    srcs = [
        "//src:Attune.flix",
        "//src:Attune/Policy.flix",
        "PolicyCases.flix",
    ],
)

# The hermetic declared-source policy over exactly the declared inputs.
native_flix_declared_test(
    name = "declared_source_policy_test",
    srcs = [
        "//src:Attune.flix",
        "//src:Attune/Policy.flix",
        "DeclaredPolicyLaw.flix",
    ],
    declared = "//:policy_sources",
)

# The live read-only uncached workspace audit, as a normal test in the public
# gate. The target is local and uncached, so every `bazel test //...` re-reads
# the current tree and a file added after a green run is seen next invocation.
# It also depends on the declared population, so any change to the declared
# inventory re-runs the audit that exists to find source no BUILD file admits.
native_flix_audit_test(
    name = "workspace_audit_test",
    srcs = [
        "//src:Attune.flix",
        "//src:Attune/Policy.flix",
        "AuditLaw.flix",
    ],
    workspace_root = "@local_workspace//:workspace_root.txt",
    skip = ["attuneflix"],
    data = ["//:policy_sources"],
)
