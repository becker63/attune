        "tool": "generation-stage",
        "action": "generate",
        "toolId": "framework-runtime-db",
        "parameters": {
          "stage": "plan",
          "recipeId": "framework-runtime.sql-route-generation"
        }
      }
    },
    "db:apply": {
      "executor": "@attune/nx:toolchain",
