# The twenty once-only observations of the gated pilot (`VAL-STUDY-002`,
# `VAL-STUDY-010`, the RUN half). ONE declared DSH action per (task, arm) of the
# frozen balanced deterministic dispatch: the ten original admitted tasks x
# `R0_PLAIN`/`R1_PACKETS`. Every target declares its own run identity, its own
# per-task world binding and its own overlay set; BOTH arms mount the shared
# bounded plain-read facade, the shared candidate-commit operation and the two
# model-hidden detector families plus the mechanical lifecycle guard, and ONLY the
# packet arm additionally mounts the R1-only progressive packet operation. The
# composed review task of each observation is built at run time from the declared
# frozen prompt, the task's own public issue and its own changed-file manifest,
# base/head identities and declared source operations. They are `manual`: the
# ordinary `bazel test //...` gate never runs a provider, and each one is a
# once-only scientific observation (no rerun, no replacement, no quality retry).
attune_pilot_runners(
    name = "reviewbench_pilot_runners",
    cohort = "//platform/dsh:evidence_reviewbench_cohort",
    common_overlays = [
        "//platform/dsh/tool:attune-guard.plugin.yml",
        "//platform/dsh/tool:attune-commit.plugin.yml",
        "//platform/dsh/tool:attune-detector.plugin.yml",
        "//platform/dsh/tool:attune-plain.plugin.yml",
        "//platform/dsh/tool:attune-reviewer.plugin.yml",
    ],
    issues = "//test/reviewbench_review:reviewbench_review_issues",
    packet_overlay = "//platform/dsh/tool:attune-packet.plugin.yml",
    prompt = "prompt.txt",
    routes = ["//platform/dsh:route-siwc-responses.yml"],
    world_repo = "@reviewbench_worlds",
)

# The forty-eight once-only observations of the heldout confirmation
# (`VAL-STUDY-004`, the RUN half). ONE declared DSH action per (task, arm) of the
# frozen balanced deterministic holdout dispatch: the metadata-only 24-task
# holdout x the fresh plain arm `R0_PLAIN` and the freshly selected policy's arm
# `R1_PACKETS` (the predeclared Pareto selection froze `R1_PACKETS` before any
# heldout outcome). It reuses the SAME `dsh_agent_run` rule, the SAME shared
# plain-read facade / candidate-commit operation / hidden detector families /
# mechanical lifecycle guard, the SAME declared provider route and the SAME
# frozen prompt bytes as the pilot, so the confirmation uses the identical shared
# DSH subscription substrate, exact source worlds and judging policy. The
# per-task holdout world is the holdout task's OWN declared head world, never a
# pilot world and never a neighbour's. They are `manual`: the ordinary
# `bazel test //...` gate never runs a provider, and each one is a once-only
# scientific observation (no heldout tuning, no replacement, no quality retry).
attune_holdout_runners(
    name = "reviewbench_holdout_runners",
    cohort = "//platform/dsh:evidence_reviewbench_holdout_cohort",
    common_overlays = [
        "//platform/dsh/tool:attune-guard.plugin.yml",
        "//platform/dsh/tool:attune-commit.plugin.yml",
        "//platform/dsh/tool:attune-detector.plugin.yml",
        "//platform/dsh/tool:attune-plain.plugin.yml",
        "//platform/dsh/tool:attune-reviewer.plugin.yml",
    ],
    issues = "//test/reviewbench_review:reviewbench_holdout_issues",
    packet_overlay = "//platform/dsh/tool:attune-packet.plugin.yml",
    prompt = "prompt.txt",
    routes = ["//platform/dsh:route-siwc-responses.yml"],
    world_repo = "@reviewbench_holdout_worlds",
)
