load("//platform/build:native.bzl", "native_flix_test")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# Sources and local links the live README check may read.
filegroup(
    name = "documents",
    srcs = [
        "ReadmeCorrespondence.flix",
        "//:AGENTS.md",
        "//notes:design.md",
        "//src:Attune.flix",
        "//src:Attune/Docs.flix",
        "//src:Attune/Effects.flix",
        "//src:Attune/Repository.flix",
        "//src:Attune/Theory.flix",
        "//src:Main.flix",
        "//test/grit:GritSeamTest.flix",
        "//test/grit:fixtures",
        "//test/policy:PolicyCases.flix",
        "//test/spine:CoreMemoLaw.flix",
    ],
)

# Read the live outer README: local + external means never use a cached verdict.
# Compile the displayed question and run it on real Grit extraction separately.
native_flix_test(
    name = "readme_correspondence_test",
    srcs = [
        "ReadmeCorrespondence.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Docs.flix",
        "//src:Attune/Repository.flix",
        "//src:Attune/Repository/Grit.flix",
        "//src:Attune/Study.flix",
    ],
    checkout_files = [
        "README.md",
        "LICENSE",
    ],
    declared_files = [":documents"],
    java_deps = [
        "//test/grit:grit_fixtures",
        "//platform/tools/grit:attune_grit",
    ],
    native_libs = ["//platform/support/grit:attune_grit_abi"],
    tags = [
        "external",
        "local",
    ],
    workspace_root = "@local_workspace//:workspace_root.txt",
)
