  "additionalProperties": false,
  "properties": {
    "aggregates": {
      "items": {
        "$ref": "#/$defs/Aggregate"
      },
      "title": "Aggregates",
      "type": "array"
    },
    "amortization": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amortization"
    },
    "arms": {
      "items": {
        "$ref": "#/$defs/ResearchBenchSettings"
      },
      "title": "Arms",
      "type": "array"
    },
    "benchmark_pack_digest": {
      "title": "Benchmark Pack Digest",
      "type": "string"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/Case"
      },
      "title": "Cases",
      "type": "array"
    },
    "comparisons": {
      "additionalProperties": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "object"
      },
      "title": "Comparisons",
      "type": "object"
    },
    "evaluator_digest": {
      "title": "Evaluator Digest",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "research_questions": {
      "items": {
        "type": "string"
      },
      "title": "Research Questions",
      "type": "array"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/TrialRecord"
      },
      "title": "Runs",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_revision": {
      "title": "Source Revision",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
