module(
    name = "attune",
    version = "0.1.0",
)

# The pinned Flix compiler is a declared, checksummed engineering dependency.
# It is a private build tool, never a public project verb.
http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_jar(
    name = "flix_compiler",
    sha256 = "b2ed2b7f49902e2dfe1b4f10e23d9a5cb085461e7e8c64909ca2b3abfa566e74",
    urls = ["https://github.com/flix/flix/releases/download/v0.76.1/flix.jar"],
)

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "platforms", version = "1.1.0")

# The pinned native Grit closure: the Rust toolchain, the hermetic LLVM toolchain
# (Rust cdylibs link against its real libunwind archive), rules_cc for that link
# edge, and the crate universe generated from the frozen Grit lock. Every input
# below is a pinned, non-secret engineering dependency of the inherited Grit
# support; the one newly approved Rust extension lives in platform/support/grit/lib.rs.
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "llvm", version = "0.8.21")

register_toolchains("@llvm//toolchain:all")

llvm_runtime = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm_runtime, "llvm-project")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# One content-addressed materialization of the frozen Grit source. The Grit pin
# `c80b3026471b229f41b279c3eb0c162dcdacfdb1` is unchanged; Attune's admitted
# languages are extensions of that one closure (Java and Ruby simply stop being
# stripped; Flix and Starlark are two additional pinned Tree-sitter grammars).
# The Flix grammar revision is the SAME revision `platform/zed/extension.toml` pins for
# the editor, so Grit and Zed cannot drift onto two Flix grammars.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

gritql_repository = use_repo_rule("//platform/build:grit_repository.bzl", "gritql_repository")

gritql_repository(
    name = "gritql_source",
    attune_lib = "//platform/support/grit:lib.rs",
    cargo_lock = "//platform/support/grit:Cargo.lock",
    language_patches = [
        "//platform/support/grit/patches:flix.rs",
        "//platform/support/grit/patches:flix_binding.rs",
        "//platform/support/grit/patches:starlark.rs",
        "//platform/support/grit/patches:starlark_binding.rs",
        "//platform/support/grit/patches:textual_metavariable.rs",
    ],
)

crate.from_cargo(
    name = "grit_crates",
    cargo_lockfile = "@gritql_source//:Cargo.lock",
    lockfile = "//platform/support/grit:cargo-bazel-lock.json",
    manifests = ["@gritql_source//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "grit_crates")

# The approved typed JVM seams: the LangChain4j 1.18.1 SDK path (with its
# pinned Jackson 2.22.1) and the Arrow 19.0.0 Dataset/Parquet codec. These are
# declared engineering dependencies, never a live provider, dataset or
# credential. They are resolved by the ordinary package-provisioning step; the
# test actions themselves make no network call.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "attune_maven",
    artifacts = [
        "com.fasterxml.jackson.core:jackson-databind:2.22.1",
        "dev.langchain4j:langchain4j-core:1.18.1",
        "dev.langchain4j:langchain4j-http-client:1.18.1",
        "dev.langchain4j:langchain4j-http-client-jdk:1.18.1",
        "dev.langchain4j:langchain4j-open-ai:1.18.1",
        "org.apache.arrow:arrow-dataset:19.0.0",
        "org.apache.arrow:arrow-memory-unsafe:19.0.0",
        "org.slf4j:slf4j-nop:2.0.18",
    ],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "attune_maven")

# The declared isolation tool: pinned util-linux `unshare` and its runtime
# closure, resolved from the Nix developer shell PATH (never a hardcoded
# readiness cache path).
local_unshare = use_repo_rule("//platform/build:unshare_repository.bzl", "local_unshare")

local_unshare(name = "unshare")

# The live root workspace path, recorded once so the local read-only audit test
# can re-read the current tree instead of a declared or cached inventory.
local_workspace = use_repo_rule("//platform/build:workspace_root.bzl", "local_workspace")

local_workspace(name = "local_workspace")

# Existing BuildBuddy integration. The toolchain supplies the remote platform
# labels; the ordinary `bazel test //...` gate does not use them.
#
# The extension's built-in `UBUNTU22_04_IMAGE` constant resolves to the mutable
# tag `gcr.io/flame-public/rbe-ubuntu22-04:latest`, so the declared execution
# platform would carry a moving runtime identity and no execution record could
# name the bytes that actually ran. The extension's supported `container_image`
# attribute instead declares the registry-resolved immutable digest of that same
# image (resolved from the tag with a read-only registry lookup on 2026-10-05),
# on the same compatible `Arch=arm64`, `OSFamily=Linux`, `dockerNetwork=off`
# platform. No tool, version, account or pool changes with it.
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.platform(
    container_image = "gcr.io/flame-public/rbe-ubuntu22-04@sha256:0d84a80bb0fc36ba5381942adcf6493249594dcc9044845c617b78c9b621cae3",
)
use_repo(buildbuddy, "buildbuddy_toolchain")

# The one approved public corpus artifact (VAL-DATA-001): the main issue-based
# `nebius/SWE-rebench-V2` release at one immutable revision and one immutable
# path. The URL carries the revision and the path, and the provider's own
# SHA-256 pins the exact bytes, so a mutated, substituted or different-revision
# file fails the fetch rather than entering the study. The declared identity is
# duplicated nowhere as truth: `Attune.Study`'s `CatalogPin` contract and its one
# `catalogFindings` comparison own the pin, and the acquisition stage recomputes
# the SHA-256 of the materialized bytes, so a drift between this URL and that
# declaration fails the catalog law instead of passing quietly.
#
# The declaration is placed last on purpose: adding a `use_repo_rule` repo before
# the `grit_crates` extension renumbers the anonymous repos and fails the pinned
# `platform/support/grit/cargo-bazel-lock.json` resolution digest. Declaring it
# last leaves that inherited lock untouched.
#
# This is a public-input acquisition, distinct from the credential-free,
# network-denied scientific guests: the fetch happens on the client, and no
# action that executes a reference obligation ever reaches the network. It is
# requested only by the explicitly selected `manual` `//test/catalog` targets,
# so the ordinary `bazel test //...` gate never acquires the corpus.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "swe_rebench_v2_catalog",
    sha256 = "0e0bf9355f892ad74ae98d4e1c404f39fd6654a8e351ee3e6ab162e4a64cd3ad",
    urls = ["https://huggingface.co/datasets/nebius/SWE-rebench-V2/resolve/10483de0f50fe5da545942705a76c6150171af7f/data/train-00000-of-00001.parquet"],
)

# The approved clean-source acquisition of the selected panel's exact worlds: the
# same declared world/archive/revision/digest identity record the localization
# label stage verified, turned into real materialized source bytes. The manifest
# is the admitted `Attune.Study` archive identity record
# (`//test/study/manifest/catalog:archives.tsv`), so no repository, revision or
# digest is restated here as truth. Each archive is fetched on the client and
# verified against its declared SHA-256 before extraction, exactly like the
# pinned catalog above, and no scientific action ever reaches the network.
#
# Declared last for the same reason as the catalog: a `use_repo_rule` repo
# declared before the `grit_crates` extension renumbers the anonymous repos and
# fails the pinned `cargo-bazel-lock.json` resolution digest.
world_sources = use_repo_rule("//platform/build:world_archives.bzl", "attune_world_sources")

world_sources(
    name = "attune_worlds",
    manifest = "//test/study:manifest/catalog/archives.tsv",
)

# The approved POST-HOC EXPLORATORY EMBEDDING runtime and model (owner 2026-10-07).
# Both read the ONE declared identity record
# `//platform/embedding:runtime-lock.tsv`: the pinned CodeRankEmbed revision's
# model files and the digest-pinned Python/PyTorch inference wheels. Each artifact
# is verified against its declared SHA-256 on the client before it is materialized
# as a portable declared input, so a remote action can carry the exact runtime
# bytes in the CAS and no inference ever runs on the host. Declared last for the
# same anonymous-repo renumbering reason as the catalog and world archives above.
embedding_runtime = use_repo_rule("//platform/build:embedding_runtime.bzl", "attune_embedding_runtime")

embedding_runtime(
    name = "attune_embedding_runtime",
    lock = "//platform/embedding:runtime-lock.tsv",
)

embedding_model = use_repo_rule("//platform/build:embedding_runtime.bzl", "attune_embedding_model")

embedding_model(
    name = "attune_embedding_model",
    lock = "//platform/embedding:runtime-lock.tsv",
)

# The approved hosted-Qwen (Q) continuation (owner 2026-10-07). Q's only route is
# the hosted OpenRouter embeddings API reached through the pinned LangChain4j
# 1.18.1 SDK, so its vectors are acquired on the host by the mission-local
# acquisition helper — whose one authorized credential read never becomes a build
# input — and are admitted here as declared inputs. The committed sanitized
# manifest `//test/localization_qwen:fixture-manifest.tsv` carries identity only
# (group, side, logical rows, unique inputs, truncated rows, unmeasured rows,
# frozen cap, provider, resolved model, frozen recipe, digest), and every fixture
# file is admitted
# through a `file://` URL that must match its declared SHA-256. Declared last for
# the same anonymous-repo renumbering reason as the catalog, world archives and
# embedding runtime above.
qwen_fixtures = use_repo_rule("//platform/build:qwen_fixtures.bzl", "attune_qwen_fixtures")

qwen_fixtures(
    name = "attune_qwen_fixtures",
    manifest = "//test/localization_qwen:fixture-manifest.tsv",
    root = "/home/becker/.cache/attune-qwen-fixtures",
    token = "1",
)

# The ReviewBench paired study's hosted-Qwen (Q) assisted-context fixtures
# (`VAL-REVIEW-002`, owner-authorized 2026-10-08). Same one route, same frozen
# recipe and the same host-acquisition boundary as the localization Q branch: the
# mission-local helper reads its one authorized credential entry internally and
# materializes one immutable vector fixture file per declared group, and this
# instance admits those files through the committed sanitized identity manifest
# `//test/reviewbench_context:qwen-fixture-manifest.tsv` (identity only — group,
# side, logical rows, unique inputs, truncated rows, unmeasured rows, frozen cap,
# provider, resolved model, frozen recipe, digest) with a `file://` URL that must
# match its declared SHA-256. A separate instance keeps the ReviewBench fixtures
# distinct from the localization Q fixtures; a mutated or substituted fixture
# fails the fetch instead of entering the study.
reviewbench_qwen_fixtures = use_repo_rule("//platform/build:qwen_fixtures.bzl", "attune_qwen_fixtures")

reviewbench_qwen_fixtures(
    name = "reviewbench_qwen_fixtures",
    manifest = "//test/reviewbench_context:qwen-fixture-manifest.tsv",
    root = "/home/becker/.cache/attune-reviewbench-qwen",
    token = "1",
)

# The ReviewBench JEV public-context observations (`VAL-REVIEW-002`, owner
# decision 2026-10-08). The NATIVE Java OpenRouter Decisions boundary wrote its
# sanitized observations beside its receipts OUTSIDE the mutable Bazel outputs;
# this instance admits exactly that one sanitized file through the committed
# identity record `//test/reviewbench_context:jev-observed-manifest.tsv` with a
# `file://` URL that must match its declared SHA-256. No credential, no exact
# payload and no raw provider body is admitted, and a mutated or substituted
# manifest fails the fetch instead of entering the study.
reviewbench_jev_observed = use_repo_rule("//platform/build:jev_observed.bzl", "attune_jev_observed")

reviewbench_jev_observed(
    name = "reviewbench_jev_observed",
    manifest = "//test/reviewbench_context:jev-observed-manifest.tsv",
    root = "/home/becker/.cache/attune-reviewbench-jev",
    token = "1",
)

# The pinned Codex CLI of the standalone Sol scientific arm (owner-authorized
# 2026-10-07, `library/sol-medium.md`). The arm's ChatGPT-plan SIWC route runs
# the pinned Codex `0.160.1` app-server as a remote action, so its exact bytes
# must be a declared, checksummed Bazel input rather than a host install. This
# is the same public `openai/codex` release artifact the established smoke
# (`invocation 097f5629-4658-426f-863e-8151069681f5`, remote PASS) ran: the
# release tarball is pinned by SHA-256, and the single binary it carries
# (`codex-aarch64-unknown-linux-musl`, SHA-256
# `fbbaec80443919f86dd63648a0b62759cf6f1d0e09310602fde96885e0bceb3e`) is
# byte-identical to the smoke's own copy. Declaring a new pinned tool repository
# is additive: it edits no existing acquisition closure. Declared last for the
# same anonymous-repo renumbering reason as the catalog, world archives,
# embedding runtime and Qwen fixtures above.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "codex_cli",
    build_file_content = """package(default_visibility = ["//visibility:public"])

exports_files(["codex-aarch64-unknown-linux-musl"])
""",
    sha256 = "f54dc5852042445bf41da3aa31156f3cb02f52c5a1a04074de73dc5598f7e1f7",
    urls = ["https://github.com/openai/codex/releases/download/rust-v0.160.1/codex-aarch64-unknown-linux-musl.tar.gz"],
)

# The companion code-mode host of the same pinned release. The `codex`
# app-server resolves its shell/read tool executor as a sibling file named
# `codex-code-mode-host`, so without this binary every turn's tool path fails
# closed and the model can never inspect a repository (the diagnosed defect of
# the DISTINCT Sol inspected arm, `library/sol-inspected.md`). The asset is the
# same public `openai/codex` release as `codex_cli` above, pinned by SHA-256; the
# driver renames it to the exact sibling name the app-server looks for. Additive:
# it edits no existing acquisition closure and no `.bazelrc`.
http_archive(
    name = "codex_code_mode_host",
    build_file_content = """package(default_visibility = ["//visibility:public"])

exports_files(["codex-code-mode-host-aarch64-unknown-linux-musl"])
""",
    sha256 = "e5e027e6689efda2e3570aa600179f0ebb18632803350e152ed6c9b97dcf9741",
    urls = ["https://github.com/openai/codex/releases/download/rust-v0.160.1/codex-code-mode-host-aarch64-unknown-linux-musl.tar.gz"],
)

# The bundled sandbox helper of the same pinned release. The code-mode host's
# Linux sandbox launcher refuses to run a command without `bwrap`, and it looks
# for the bundled copy at `codex-resources/bwrap` next to the Codex executable.
# Without it the tool path is reachable but every command aborts, so a turn can
# never read source (the second half of the diagnosed inspected-arm defect). The
# asset is the same public `openai/codex` release, pinned by SHA-256; the driver
# stages it under the exact relative path the launcher expects. Additive: no
# existing acquisition closure and no `.bazelrc` edit.
http_archive(
    name = "codex_bwrap",
    build_file_content = """package(default_visibility = ["//visibility:public"])

exports_files(["bwrap-aarch64-unknown-linux-musl"])
""",
    sha256 = "5b2600ab05250bdf8b8b34f5dd8a8b543c941d2ad36a5213dfa93ad04d1a2bbd",
    urls = ["https://github.com/openai/codex/releases/download/rust-v0.160.1/bwrap-aarch64-unknown-linux-musl.tar.gz"],
)

# The one approved additional corpus (`VAL-REVIEW-001`): the pinned ReviewBench
# `corpus/manifest.json` at the exact commit
# 66df3f322d0d85ea133ea9fa777f5d1a8c933c4e. The URL carries the commit and the
# path, and the provider's own SHA-256 pins the exact bytes; the admission stage
# recomputes both the SHA-256 and the git blob SHA-1 of the materialized bytes, so
# a mutated, substituted or different-revision manifest fails its declared origin
# comparison instead of entering the study. `Attune.Study.ReviewBench` owns the
# declared contract; this URL is only the acquisition. This is a public-input
# acquisition, distinct from the credential-free scientific guests: the fetch
# happens on the client, and no action that reduces the study reaches the network.
# It is requested only by the explicitly selected `manual` `//test/reviewbench`
# targets, so the ordinary `bazel test //...` gate never acquires the corpus.
# Declared last for the same anonymous-repo renumbering reason as the catalog,
# world archives, embedding runtime, Qwen fixtures and Codex assets above.
http_file(
    name = "reviewbench_manifest",
    sha256 = "e74656b8c1c4bbab5ce85f1fcb742a7aaad550a4d7bd46e1f83a0746807bfa02",
    urls = ["https://raw.githubusercontent.com/review-bench/ReviewBench/66df3f322d0d85ea133ea9fa777f5d1a8c933c4e/corpus/manifest.json"],
)

# The approved clean-source acquisition of the pinned ReviewBench cohort's exact
# base and head worlds (`VAL-REVIEW-002`). The declared archive identity record
# `//test/reviewbench:archives.tsv` names each world's mirror repository, exact
# revision and exact archive digest; it is emitted by the real acquisition and
# owned by `Attune.Study.ReviewBench`, so no repository, revision or digest is
# restated here as truth. Each archive is fetched on the client and verified
# against its declared SHA-256 before extraction, exactly like the pinned
# localization worlds above, so a mutated or substituted archive fails the fetch
# instead of entering the study, and both review arms read identical bytes. The
# ordinary `bazel test //...` gate never fetches it: only the explicitly selected
# `manual` `//test/reviewbench:reviewbench_measure` target declares it.
# Declared last for the same anonymous-repo renumbering reason as the catalog,
# world archives, embedding runtime, Qwen fixtures, Codex assets and manifest.
world_sources(
    name = "reviewbench_worlds",
    manifest = "//test/reviewbench:archives.tsv",
)
