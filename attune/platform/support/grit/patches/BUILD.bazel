package(default_visibility = ["//visibility:public"])

# The two repository-local Grit language implementations (`flix.rs`,
# `starlark.rs`), their ABI-14 grammar bindings and the shared metavariable
# helper that `//build:grit_repository.bzl` copies into the frozen Grit closure.
# They are inherited pinned support sources, not newly authored native code.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

exports_files(glob(["*.rs"]))
