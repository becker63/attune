load("//platform/build:native.bzl", "native_flix_test")
load("//test/localization:localization.bzl", "attune_localization_study")
load("//test/study:manifest/localization/mapped.bzl", "LOCALIZATION_ANALYSIS")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The explicit source closure every declared stage compiles: the dispatcher plus
# the shared owners it consumes. One declaration, so every stage action compiles
# exactly the same set and no stage can reach a source its closure omits. The
# dispatcher is a thin adapter; the arm vocabulary, the deterministic lexical
# prior, the honest issue-anchor reduction, the evidence operations and the
# ranking tie rule live in `Attune.Study`; the descriptor grammar and world-shard
# witness lowering live in `Attune.Theory`; the earned facts, index and scoped
# coverage live in `Attune.Repository`.
LOCALIZATION_SRCS = [
    "LocalizationStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Repository.flix",
    "//src:Attune/Repository/Grit.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Theory.flix",
]

# The real selected-panel localization graph (`VAL-LOC-002`): the admitted mapped
# manifest's worlds, groups and tasks expanded into the declared world
# extraction, theory witnesses, policy variants, the one development selection and
# the four frozen arm rankings. Every target is `manual`, so the ordinary
# `bazel test //...` gate never fetches, extracts or ranks the corpus.
attune_localization_study(
    name = "localization",
    analysis = LOCALIZATION_ANALYSIS,
    grit_libs = ["//platform/support/grit:attune_grit_abi"],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/parquet:attune_parquet",
    ],
    label_package = "//test/study",
    law_srcs = [
        "LocalizationRankingLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Theory.flix",
    ],
    stage_srcs = LOCALIZATION_SRCS,
)

# The corpus-free localization laws (`VAL-LOC-002`): they drive the exact
# production arm vocabulary, lexical prior, anchor reduction, evidence
# operations, ranking tie rule, development selection, freeze records and the
# descriptor template family. No corpus, no world, no Grit and no label is
# touched here.
native_flix_test(
    name = "localization_law",
    srcs = [
        "LocalizationLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Theory.flix",
    ],
    tags = ["manual"],
)

# The locale and encoding boundary laws (`VAL-LOC-004`, `VAL-RUN-004`): they
# observe the JVM filesystem encoding the pinned engine actually ran under and
# exercise a real non-ASCII path through the real filesystem. They are
# separating: run with the boundary set to the C locale they fail, and run with
# the declared `C.UTF-8` locale they pass. No corpus, world, Grit or label is
# touched here.
native_flix_test(
    name = "localization_encoding_law",
    srcs = ["LocalizationEncodingLaw.flix"],
    tags = ["manual"],
)

test_suite(
    name = "all",
    tags = ["manual"],
    tests = [
        ":localization_encoding_law",
        ":localization_law",
        ":ranking_artifact_test",
    ],
)
