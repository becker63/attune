{
  "name": "attune-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic API reference and grounded onboarding site for Attune.",
  "type": "module",
  "scripts": {
    "audit": "node --experimental-strip-types ./src/cli.ts audit",
    "build": "pnpm run audit && node --experimental-strip-types ./src/cli.ts build",
    "guides:validate": "node --experimental-strip-types ./src/cli.ts guides:validate",
    "guides:approve": "node --experimental-strip-types ./src/cli.ts guides:approve",
    "manifest": "node --experimental-strip-types ./src/cli.ts manifest",
    "probe:typedoc": "node ./scripts/probe-typedoc.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ts-morph": "28.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "nx": {
    "implicitDependencies": [
      "attune-activegraph",
      "attune-mcp",
      "joern-effect"
    ],
    "tags": [
      "type:documentation",
      "scope:attune",
      "platform:node"
    ],
    "targets": {
      "build": {
        "cache": false,
        "dependsOn": [],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
