{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "tend-core",
  "projectType": "library",
  "root": "packages/tend/core",
  "sourceRoot": "packages/tend/core/src",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/tend/core && pnpm exec tsc --noEmit -p tsconfig.json"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "typecheck",
          "action": "typecheck",
          "recipeId": "tend-core.typecheck",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd packages/tend/core && pnpm exec vitest run"
      },
      "metadata": {
        "attune": {
          "tier": "public",
          "surface": "test",
          "action": "test",
          "recipeId": "tend-core.test",
          "projectionId": "framework.projection.nx-target"
        }
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Project check surface for Recipe/ManagedRecipe substrate diagnostics.",
        "attune": {
          "tier": "public",
          "surface": "check",
          "action": "check",
          "recipeId": "tend-core.check",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec nx run workspace:recipe-substrate-check"
      }
    },
    "repair": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Project repair surface for safe Recipe/ManagedRecipe repair materialization.",
        "attune": {
          "tier": "public",
          "surface": "repair",
          "action": "repair",
          "recipeId": "tend-core.repair",
          "projectionId": "framework.projection.nx-target"
        }
      },
      "options": {
        "command": "pnpm exec nx run workspace:repair"
      }
    }
  },
  "tags": [
    "scope:tend",
    "attune:recipe-consumer"
  ]
}
