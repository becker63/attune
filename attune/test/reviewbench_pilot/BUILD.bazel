# The frozen run-half receipts the reduction stages declare: the ACTUAL delivered
# finals, the durable committed checkpoints, the normalized candidate findings,
# the frozen predictions/diagnostics/usage ledger and the ten-task reference
# population. They are ordinary repo fixtures, so the stages read them without
# fetching the corpus.
filegroup(
    name = "pilot_run_fixture_files",
    srcs = glob(["fixtures/**"]),
)

attune_path_manifest(
    name = "pilot_run_fixtures",
    srcs = glob(["fixtures/**"]),
)

# The declared ReviewBench pilot candidate-blinding stage (`VAL-STUDY-002`,
# `VAL-STUDY-005`). It blinds the ACTUAL delivered findings of the twenty
# once-only observations — the non-empty FINAL deliveries plus the durable
# committed CHECKPOINT candidates — into one per-task blinded projection with
# fresh positional ids and NO producing-arm cell, plus a SEPARATE evaluator-side
# blinding record. Provider-free and corpus-free: it reads only the frozen
# receipts and calls no provider.
native_study_stage(
    name = "reviewbench_pilot_candidates",
    srcs = PILOT_RUN_SRCS,
    extra_inputs = glob(["fixtures/**"]),
    input_names = ["fixtures"],
    inputs = [":pilot_run_fixtures"],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_pilot_candidates",
    tags = ["manual"],
)

# The declared ReviewBench pilot RUN-HALF REDUCTION stage (`VAL-STUDY-002`,
# `VAL-STUDY-005`, `VAL-STUDY-010`, `VAL-STUDY-011`). It reduces the frozen
# twenty-slot records together with the independently judged receipts into the
# canonical run-half record: the per-slot budget/acquisition/delivery table, the
# separately versioned commit/source/packet refusal projection, the per-arm
# judged evidence, the all-task reference denominator and the ONE activation
# decision applied by the unchanged frozen `Attune.Study.ReviewPilot` rule.
# Provider-free and corpus-free: it reads only the frozen receipts.
native_study_stage(
    name = "reviewbench_pilot_run",
    srcs = PILOT_RUN_SRCS,
    extra_inputs = glob(["fixtures/**"]),
    input_names = ["fixtures"],
    inputs = [":pilot_run_fixtures"],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_pilot_run",
    tags = ["manual"],
)

# The declared ReviewBench holdout confirmation FREEZE stage (`VAL-STUDY-004`).
# It reduces the ACTUAL judged pilot outcomes and the immutable metadata-only
# 24-task holdout into the predeclared Pareto selection and freezes it BEFORE any
# heldout observation exists, plus the balanced deterministic holdout dispatch of
# one plain and one selected-policy observation per holdout task. No heldout
# outcome is an input, because none exists yet; the target is `manual` because it
# consumes the run-half reduction tree, not the ordinary gate.
native_study_stage(
    name = "reviewbench_pilot_holdout_freeze",
    srcs = PILOT_HOLDOUT_SRCS,
    extra_inputs = glob(["fixtures/**"]),
    input_names = [
        "holdout",
        "pilot_run",
        "fixtures",
    ],
    inputs = [
        ":reviewbench_pilot_freeze",
        ":reviewbench_pilot_run",
        ":pilot_run_fixtures",
    ],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_pilot_holdout_freeze",
    tags = ["manual"],
)

# The declared ReviewBench heldout-confirmation RUN-half reduction
# (`VAL-STUDY-004`). It reduces the FORTY-EIGHT frozen once-only heldout
# observations — one fresh plain and one fresh selected-policy observation per
# task of the frozen metadata-only 24-task holdout — into the canonical heldout
# record: the per-observation table (every budget-stopped and every empty
# delivery stays a miss), the per-arm usage with the guard-prefix and measured
# overshoots SEPARATE, the explicit planned/original24/remaining denominator, the
# per-task RAW paired difference, the honest limited-support statement and the
# blinded candidate projection. Provider-free and corpus-free: it reads only the
# frozen receipts and calls no provider.
native_study_stage(
    name = "reviewbench_holdout_run",
    srcs = PILOT_HOLDOUT_RUN_SRCS,
    extra_inputs = glob(["fixtures/**"]),
    input_names = ["fixtures"],
    inputs = [":pilot_run_fixtures"],
    java_deps = [
        "//platform/tools/grit:attune_grit",
        "//platform/tools/reviewbench:attune_reviewbench",
    ],
    stage = "reviewbench_holdout_run",
    tags = ["manual"],
)

