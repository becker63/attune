# Attune: local checks by default; BuildBuddy is opt-in.
#
# The public gate is `nix develop --command bazel test //...` from this
# workspace. BuildBuddy is a separate opt-in config so the ordinary gate never
# requires a credential.

# The Bazel server is the largest single process this workspace starts, so its
# heap is bounded explicitly rather than left at a fraction of host RAM.
startup --host_jvm_args=-Xmx3g
startup --host_jvm_args=-XX:MaxMetaspaceSize=256m

build --enable_bzlmod

# Pinned language and runtime versions (mission pins: Java 25).
build --java_language_version=25
build --tool_java_language_version=25
build --java_runtime_version=remotejdk_25
build --tool_java_runtime_version=remotejdk_25

# Bound local resource use. The remote profile can schedule eight actions.
build --local_resources=cpu=1
build --local_resources=memory=1024
build --jobs=1

test --test_output=errors
# `bazel test //...` is the ordinary gate; only test targets are built.
test --build_tests_only
# Ordinary native tests stay cacheable. The two live-checkout checks (the
# workspace audit and the checked-document correspondence) are tagged `local`
# and `external` instead, so they re-read the live tree on every invocation
# without disabling test caching globally.
#
# Note: `external` is the tag that forces unconditional execution. The `no-cache`
# tag only excludes the disk and remote action caches; it was measured to leave
# the in-memory test result cache intact, so a live check tagged `no-cache` alone
# still replayed `(cached)`. `external` is what the audit and the correspondence
# fixture actually carry.

# aspect_tools_telemetry (pulled in transitively) reports usage unless
# disabled; an empty value does NOT disable it, "-all" does.
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all

# BuildBuddy remote cache and BES. Authentication is supplied by the local
# credential helper from the ignored checkout-root .env; the key never enters a
# declared action input, CAS object, argument or log.
build:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_cache_compression

# Opt-in remote execution on the same authenticated BuildBuddy service (the
# published endpoint `grpcs://remote.buildbuddy.io`, reached with the flake's
# credential helper). It is a separate profile: the ordinary public gate above
# never requires a credential and never leaves the host.
#
# The execution platform is `@buildbuddy_toolchain//:platform_linux_arm64`, the
# pinned provider platform whose declared execution properties are
# `Arch=arm64`, `OSFamily=Linux`,
# `container-image=docker://gcr.io/flame-public/rbe-ubuntu22-04@sha256:0d84a80bb0fc36ba5381942adcf6493249594dcc9044845c617b78c9b621cae3`
# and `dockerNetwork=off`. The image is pinned to the registry-resolved immutable
# digest of that tag (declared in `MODULE.bazel` through the extension's supported
# `container_image` attribute), so an execution record can name the exact runtime
# bytes; the built-in `UBUNTU22_04_IMAGE` constant would carry the mutable
# `:latest` tag. Those aarch64 properties match the declared JDK 25
# runtime (`remotejdk_25`, the arm64 build) and the host/native architecture, so
# no amd64 worker and no emulation is involved. It must be wired as the
# *execution* platform (`--extra_execution_platforms` plus `--host_platform`),
# not only as the target platform: with `--platforms` alone the execution log
# records empty platform properties, the aarch64 JDK lands on an amd64 worker
# and the action dies with `Exec format error`.
#
# The declared action PATH is the flake wrapper's allowlisted PATH plus the
# container-valid `:/usr/bin:/bin` suffix, so the same declared environment
# resolves `bash` and the coreutils both in the pinned local shell and in the
# provider image; no `--test_env` override is needed and a host-only action
# kept on the client still finds its shell.
# `--define=attune_native_isolation=platform` selects the declared portable
# native route (see `platform/build:native.bzl`): the native producer/consumer
# actions then carry no host Nix `unshare` binary, and the guest network denial
# comes from the platform's declared `dockerNetwork=off` property rather than
# from a host namespace this environment cannot create. Remote invocation may
# fan out up to eight jobs; the local job limit stays at one via
# `--local_resources=cpu=1` above.
#
# `--remote_local_fallback=false` keeps remote evidence honest: an action that
# cannot run remotely fails instead of silently running on the host. Actions
# that declare themselves host-only (`local`/`no-remote` tags, such as the live
# workspace audit and the host-namespace isolation fixture) are still selected
# for local execution by Bazel's ordinary strategy selection; the fallback flag
# governs only a remote attempt that fails.
build:remote --config=buildbuddy
build:remote --remote_executor=grpcs://remote.buildbuddy.io
build:remote --remote_local_fallback=false
build:remote --extra_execution_platforms=@buildbuddy_toolchain//:platform_linux_arm64
build:remote --host_platform=@buildbuddy_toolchain//:platform_linux_arm64
build:remote --platforms=@buildbuddy_toolchain//:platform_linux_arm64
build:remote --define=attune_native_isolation=platform
build:remote --jobs=8
