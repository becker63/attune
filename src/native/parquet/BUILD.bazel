load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The typed Parquet artifact boundary: Arrow Dataset JNI write/read mechanics
# behind a versioned JSON envelope. Flix owns every schema and row meaning; this
# library only performs the unavoidable native codec work and classifies a
# rejection instead of throwing across the interop boundary.
java_library(
    name = "attune_parquet",
    srcs = ["AttuneParquet.java"],
    javacopts = ["--release=21"],
    deps = [
        "@attune_maven//:com_fasterxml_jackson_core_jackson_core",
        "@attune_maven//:com_fasterxml_jackson_core_jackson_databind",
        "@attune_maven//:org_apache_arrow_arrow_dataset",
        "@attune_maven//:org_apache_arrow_arrow_memory_core",
        "@attune_maven//:org_apache_arrow_arrow_memory_unsafe",
        "@attune_maven//:org_apache_arrow_arrow_vector",
        "@attune_maven//:org_slf4j_slf4j_nop",
    ],
)
