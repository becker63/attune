          ]
        },
        "dryRun": false
      }
    },
    "repair": {
      "executor": "@attune/nx:toolchain",
      "metadata": {
        "description": "Project repair surface for safe Recipe/ManagedRecipe repair materialization."
      },
      "options": {
        "targetProject": "framework-runtime",
        "tool": "workspace",
        "action": "check",
        "toolId": "nx-targets",
        "parameters": {
          "targets": [
            "workspace:repair"
          ]
        },
        "dryRun": false
