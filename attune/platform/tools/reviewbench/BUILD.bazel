load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The pinned ReviewBench corpus boundary: the unavoidable byte work behind one
# small mechanical adapter. It measures a declared file's identity (bytes,
# SHA-256, git blob SHA-1), streams a top-level JSON array into the declared
# canonical projection vocabulary through the streaming Jackson reader, and
# exposes the SHA-256 digest primitive the selection law hashes its seed with.
# It decides nothing: the declared spec names the scanned columns, and every
# count, quota, split and admission classification lives in `Attune.Study`.
java_library(
    name = "attune_reviewbench",
    srcs = ["AttuneReviewBench.java"],
    javacopts = ["--release=21"],
    deps = [
        "@attune_maven//:com_fasterxml_jackson_core_jackson_core",
    ],
)
