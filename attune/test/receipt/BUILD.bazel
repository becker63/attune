load("//platform/build:native.bzl", "native_drain_probe", "native_flix_consumer_test", "native_process_receipt")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The declared receipt action: the existing mechanical launcher runs one
# bounded, declared argv plan with concurrent bounded log draining, finite
# timeouts and process-tree cleanup, then emits one declared tree holding the
# raw `receipts.tsv` records and the bounded per-stream log files. A measured
# nonzero child exit is data, so the action succeeds whenever the receipt was
# written. The plan is authored on the Study side; the boundary decides no
# policy.
native_process_receipt(
    name = "process_receipts",
    plan = "plan.tsv",
)

# The declared drain fault fixture: the existing mechanical launcher drives the
# *production* bounded drain over a stream that fails after a bounded prefix and
# over a log store that cannot be opened, beside an ordinary clean drain, and
# emits one declared tree of production receipt records. A real child cannot
# make the drain fail deterministically, so this test-only fixture supplies the
# faulty streams; the Flix consumer owns the interpretation. It is not a
# production fault endpoint and adds no launcher entrypoint.
native_drain_probe(
    name = "receipt_drain_probe",
)

# The consumer: the receipt tree is a declared input. The pinned compiler's
# authentic native Tester runs the Study receipt laws over the actual records
# and bounded logs, and the declared plan is bound so the laws can assert its
# finiteness and admissibility. The drain fault fixture is a second declared
# input for the post-start drain-failure laws.
native_flix_consumer_test(
    name = "process_receipt_test",
    srcs = [
        "ReceiptLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Study.flix",
    ],
    declared_files = ["plan.tsv"],
    produced = [
        ":process_receipts",
        ":receipt_drain_probe",
    ],
)
