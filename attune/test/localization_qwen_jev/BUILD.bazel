load("//platform/build:native.bzl", "native_flix_test", "native_study_stage")
load("//test/localization_runtime:localization_runtime.bzl", "RUNTIME_CAPPED_EXCLUSIONS")
load("//test/study:manifest/localization/mapped.bzl", "LOCALIZATION_ANALYSIS")

package(default_visibility = ["//visibility:public"])

# This package's contribution to the declared authored-source population.
filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

# The post-hoc exploratory hosted-Qwen JEV pair (`VAL-QWEN-004`) is a strictly
# downstream consumer. It binds the warm `//test/localization_runtime` arm ranking
# trees, the frozen `//test/localization_embedding` E trees, the frozen
# `//test/localization_qwen` Q trees and the admitted evaluator label artifacts; it
# declares no world extraction, Theory lowering, variant ranking, CodeRankEmbed
# inference or hosted-Qwen acquisition target, so running it re-executes no
# upstream action, makes no provider call and touches no frozen result.
#
# `decisions_Q.tsv` and `decisions_QS.tsv` are the admitted sanitized typed-decision
# manifests of the paired Q ablation: one row per logical decision carrying the
# frozen decision fields (condition, task, public candidate path, original Q rank,
# typed outcome, structural-evidence flags) followed by the batch-level provider
# evidence read back from the persisted receipt. They were produced by the approved
# mission-local Java mechanical receipt writer (`--base Q`) over the configured MCP
# stdio `jev_decide` route; the writer's receipts stay local, non-cacheable mission
# artifacts and are never a Bazel, Nix or CAS input. The manifests are immutable
# public fixtures (no payload, no response, no credential). The Q pair reuses no A
# judgment: its payload hashes differ by construction.
#
# The frozen prompt identities are recorded here as the exact template bytes:
# `prompt_q.template.txt` (Q-control) and `prompt_q_structure.template.txt`
# (Q-structure), both fixed before any Q-pair outcome.
STAGE_SRCS = [
    "QwenJevStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/Embedding.flix",
    "//src:Attune/Study/Jev.flix",
    "//src:Attune/Study/Metrics.flix",
    "//src:Attune/Study/Qwen.flix",
]

_EXCLUDED_GROUPS = [entry["group"] for entry in RUNTIME_CAPPED_EXCLUSIONS]

# The surviving tasks of the frozen runtime-capped cohort, derived from the same
# admitted manifest the cohort macro consumes so the Q-JEV population cannot drift
# from the deterministic result it extends.
_DERIVED_TASKS = [
    row
    for row in LOCALIZATION_ANALYSIS
    if len(row) > 3 and row[0] == "task" and row[2] not in _EXCLUDED_GROUPS
]

_DETERMINISTIC_INPUTS = [
    "//test/localization_runtime:rank_%s" % row[1]
    for row in _DERIVED_TASKS
]

_EMBEDDING_INPUTS = [
    "//test/localization_embedding:rank_e_%s" % row[1]
    for row in _DERIVED_TASKS
]

_QWEN_INPUTS = [
    "//test/localization_qwen:rank_q_%s" % row[1]
    for row in _DERIVED_TASKS
]

_LABEL_INPUTS = [
    "//test/study:manifest/localization/label_%s.tsv" % row[1]
    for row in _DERIVED_TASKS
]

# The one Q-JEV stage: it reranks each surviving task's frozen Q ranking under the
# frozen stable promotion, reduces the final eight primary arms `P`, `PA`, `E`,
# `PAJ`, `PAJstructure`, `Q`, `QJ` and `QJstructure` through the canonical
# `Attune.Study.Metrics`, and emits the metric rows, the six priority contrasts plus
# the explicit PAJstructure-versus-QJstructure comparison, the evaluator-only
# diagnostics and the complete rerank record. `manual` like every corpus-bound
# stage, so the ordinary `bazel test //...` gate never touches the corpus.
native_study_stage(
    name = "qwen_jev_metrics",
    srcs = STAGE_SRCS,
    input_names = [
        "mapped",
        "decisions_a",
        "decisions_s",
        "decisions_q",
        "decisions_qs",
    ] + ["deterministic_%s" % row[1] for row in _DERIVED_TASKS]
      + ["embedding_%s" % row[1] for row in _DERIVED_TASKS]
      + ["qwen_%s" % row[1] for row in _DERIVED_TASKS]
      + ["label_%s" % row[1] for row in _DERIVED_TASKS],
    inputs = [
        "//test/study:manifest/localization/mapped.tsv",
        "//test/localization_jev:decisions_A.tsv",
        "//test/localization_jev:decisions_S.tsv",
        ":decisions_Q.tsv",
        ":decisions_QS.tsv",
    ] + _DETERMINISTIC_INPUTS + _EMBEDDING_INPUTS + _QWEN_INPUTS + _LABEL_INPUTS,
    stage = "qwen_jev_metrics",
    tags = ["manual"],
)

# The corpus-free Q-JEV rerank laws (`VAL-QWEN-004`): they drive the exact
# production promotion statement in `Attune.Study.Jev` with hand-built immutable
# rankings and typed decisions, so the promotion rule is pinned without touching
# the corpus. Pure, so unlike the stage it is not `manual` and the ordinary offline
# gate runs it.
native_flix_test(
    name = "qwen_jev_law",
    srcs = [
        "QwenJevLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/Jev.flix",
        "//src:Attune/Study/Metrics.flix",
    ],
)

test_suite(
    name = "all",
    tags = ["manual"],
    tests = [":qwen_jev_law"],
)
