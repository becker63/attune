package(default_visibility = ["//visibility:public"])

# The pinned Flix compiler as a private Bazel build tool. It is never a public
# project verb; the native test launcher invokes its authentic test engine, not
# `flix run` or a fat JAR.
java_binary(
    name = "flix",
    main_class = "ca.uwaterloo.flix.Main",
    runtime_deps = ["@flix_compiler//jar"],
)

# The declared authored-source population, minus the exact boundaries: the
# read-only reference checkout, the external mission archive, Bazel output and
# the preserved user-work bundle. A glob cannot cross a Bazel package boundary,
# so every package that carries authored source contributes its own
# `policy_files` filegroup. `DESIGN.md` records which packages make up this
# declared population; a new package must add its filegroup here so its source
# stays declared rather than silently unowned.
filegroup(
    name = "policy_files",
    srcs = glob(
        [
            "*.md",
            "*.bzl",
            "*.nix",
            "*.lock",
            "LICENSE",
            "BUILD.bazel",
            "MODULE.bazel",
        ],
        exclude = ["ATTUNE_V2_BOOTSTRAP_MISSION_ALL_IN_ONE.md"],
        allow_empty = True,
    ),
)

filegroup(
    name = "policy_sources",
    srcs = [
        ":policy_files",
        "//build:policy_files",
        "//src:policy_files",
        "//test:policy_files",
        "//test/policy:policy_files",
        "//test/spine:policy_files",
        "//tools:policy_files",
        "//tools/boundary:policy_files",
    ],
)

# One aggregated name for the ordinary gate. `bazel test //...` is the public
# interface; this suite exists so the spine can be selected by one label.
test_suite(
    name = "spine_tests",
    tests = [
        "//test/spine:envelope_test",
        "//test/spine:isolation_test",
        "//test/spine:nominal_negative_test",
    ],
)

# The policy and counting surface of the same public gate.
test_suite(
    name = "policy_tests",
    tests = [
        "//test/policy:count_law_test",
        "//test/policy:policy_cases_test",
        "//test/policy:declared_source_policy_test",
        "//test/policy:workspace_audit_test",
    ],
)

exports_files([
    "LICENSE",
    "PROVENANCE.md",
    "README.md",
    "AGENTS.md",
    "DESIGN.md",
])
