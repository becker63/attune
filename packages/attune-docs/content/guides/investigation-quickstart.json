      "id": "materialize",
      "heading": "Materialize an exact repository",
      "claims": [
        {
          "id": "quickstart.materialize.input",
          "text": "Begin with `repository_materialize`. Select its wire input from the Toolkit name, then let the service establish the materialized capability.",
          "certainty": "inference",
          "evidence": [
            {
              "symbol": "AttuneOperationWireInput",
              "facts": ["signature"]
            },
            {
              "symbol": "InvestigationServiceApi",
              "facts": ["signature"]
            }
          ]
        },
        {
          "id": "quickstart.materialize.result",
          "text": "Activate the materialized capability before executing another operation. The active capability is the service's public proof that execution may continue.",
          "certainty": "inference",
          "evidence": [
            {
              "symbol": "MaterializedInvestigationCapability",
              "facts": ["signature", "source"]
            },
            {
              "symbol": "ActiveInvestigation",
              "facts": ["signature"]
            },
            {
              "symbol": "InvestigationServiceApi",
              "facts": ["signature"]
            }
          ]
        }
      ]
    },
    {
      "id": "execute",
      "heading": "Execute against the expected snapshot",
      "claims": [
        {
          "id": "quickstart.execute.service",
          "text": "Operations run through the investigation service. The selected name keeps its input and result related without exposing a generic JSON handler.",
          "certainty": "direct",
          "evidence": [
            {
              "symbol": "InvestigationService",
              "facts": ["signature"]
            },
            {
              "symbol": "AttuneOperationInput",
