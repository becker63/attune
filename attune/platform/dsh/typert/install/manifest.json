{
  "name": "@attune/evidence-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The narrow Attune evidence contract of the DSH review study: the installable package of the real Typert-generated transport declaration.",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./contract": {
      "types": "./lib/contract.digest.d.ts",
      "default": "./lib/contract.digest.js"
    },
    "./cordis": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/contract.digest.js",
    "lib/contract.digest.d.ts",
    "lib/types/index.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "zod": "^4.4.3"
  }
}
