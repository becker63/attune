load("//platform/build:native.bzl", "native_flix_test", "native_study_stage")
load("//platform/build:study.bzl", "attune_study")
load("//test/study:manifest/manifest.bzl", "ANALYSIS")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "policy_files",
    srcs = glob(["**"]),
)

STAGE_SRCS = [
    "Stages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Theory.flix",
]

EVIDENCE_STAGE_SRCS = [
    "EvidenceOperationStages.flix",
    "//src:Attune.flix",
    "//src:Attune/Coverage.flix",
    "//src:Attune/Study.flix",
    "//src:Attune/Study/EvidenceOperation.flix",
    "//src:Attune/Study/EvidenceSubstrate.flix",
]

filegroup(
    name = "evidence_operation_stage_srcs",
    srcs = EVIDENCE_STAGE_SRCS,
)

native_flix_test(
    name = "evidence_operation_projection_law",
    srcs = [
        "EvidenceOperationProjectionLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/EvidenceOperation.flix",
        "//src:Attune/Study/EvidenceSubstrate.flix",
    ],
    declared_files = [
        "//platform/dsh/tool:fixtures/expected-reference-projection.tsv",
        "//platform/dsh/tool:fixtures/source/shop.ts",
        "//platform/dsh/tool:fixtures/world.tsv",
    ],
    produced = ["//platform/dsh:evidence_operation_projection"],
)

native_flix_test(
    name = "evidence_contract_parity_law",
    srcs = [
        "EvidenceContractParityLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/EvidenceSubstrate.flix",
    ],
    declared_files = ["//platform/dsh:typert_fixture"],
    java_deps = [],
)

native_flix_test(
    name = "evidence_operation_law",
    srcs = [
        "EvidenceOperationLaw.flix",
        "//src:Attune.flix",
        "//src:Attune/Coverage.flix",
        "//src:Attune/Study.flix",
        "//src:Attune/Study/EvidenceOperation.flix",
        "//src:Attune/Study/EvidenceSubstrate.flix",
    ],
    declared_files = [
        "//platform/dsh/tool:fixtures/expected-observation-projection.tsv",
        "//platform/dsh/tool:fixtures/expected-reference-projection.tsv",
        "//platform/dsh/tool:fixtures/facts.tsv",
        "//platform/dsh/tool:fixtures/source/shop.ts",
        "//platform/dsh/tool:fixtures/world.tsv",
    ],
    java_deps = [],
)

RESULT_SRCS = STAGE_SRCS + [
    "Results.flix",
]

native_study_stage(
    name = "analysis_prepare",
    srcs = STAGE_SRCS,
    input_names = ["panel"],
    inputs = ["manifest/panel.tsv"],
    stage = "prepare_manifest",
    tags = ["manual"],
)

native_study_stage(
    name = "analysis_prepare_overflow",
    srcs = STAGE_SRCS,
    input_names = ["panel"],
    inputs = ["manifest/panel_overflow.tsv"],
    stage = "prepare_manifest",
    tags = ["manual"],
)

native_study_stage(
    name = "analysis_prepare_late",
    srcs = STAGE_SRCS,
    input_names = ["panel"],
    inputs = ["manifest/panel_late.tsv"],
    stage = "prepare_manifest",
    tags = ["manual"],
)

native_study_stage(
    name = "analysis_prepare_capped",
    srcs = STAGE_SRCS,
    input_names = ["panel"],
    inputs = ["manifest/panel_capped.tsv"],
    stage = "prepare_manifest",
    tags = ["manual"],
)

attune_study(
    name = "study",
    analysis = ANALYSIS,
    branch_plans = {
        "a": "fixtures/branches/a.tsv",
        "ab": "fixtures/branches/ab.tsv",
        "b": "fixtures/branches/b.tsv",
        "baseline": "fixtures/branches/baseline.tsv",
    },
    label_fixtures = "fixtures/labels",
    law_srcs = {
        "bounds_test": "BoundsLaw.flix",
        "dag_test": "DagLaw.flix",
        "firewall_test": "FirewallLaw.flix",
        "manifest_test": "ManifestLaw.flix",
        "results_test": "ResultsLaw.flix",
    },
    parquet_deps = ["//platform/tools/parquet:attune_parquet"],
    plan = "fixtures/plan.tsv",
    # The one declared frozen prediction policy: the public gold-free prior a
    # prediction ranks under. It is consumed only by the `prediction_<task>`
    # stages, so a policy change invalidates the predictions and their dependents
    # while the shared world extraction and theory shards stay cached.
    policy = "fixtures/policy.tsv",
    result_srcs = RESULT_SRCS,
    stage_srcs = STAGE_SRCS,
    variant_files = {
        "ab": "fixtures/variants/ab.flix",
        "a": "fixtures/variants/a.flix",
        "b": "fixtures/variants/b.flix",
        "baseline": "fixtures/variants/base.flix",
    },
)
